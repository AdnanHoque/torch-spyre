-json11::Json::object makeConsumerComputeMap(int coreCount) {
+int groupedCoreId(int core, int coreCount, int groupCount) {
+  return core * groupCount / coreCount;
+}
+
+json11::Json::object makeConsumerComputeMap(int coreCount,
+                                            int groupCount = 1) {
+  json11::Json::object result;
+  for (int core = 0; core < coreCount; ++core) {
+    result[std::to_string(core)] = json11::Json::object{
+        {"x", groupedCoreId(core, coreCount, groupCount)},
+        {"mb", 0},
+        {"out", 0},
+        {"in", 0}};
+  }
+  return result;
+}
+
+json11::Json::object makeTargetKernelMap(int coreCount, int groupCount = 1) {
+  json11::Json::object result;
+  for (int core = 0; core < coreCount; ++core) {
+    result[std::to_string(core)] = json11::Json::object{
+        {"out", 0},
+        {"in", 0},
+        {"x", groupedCoreId(core, coreCount, groupCount)}};
+  }
+  return result;
+}
+
+json11::Json::object makeSourceLxMap(int coreCount, int groupCount = 1) {
   json11::Json::object result;
   for (int core = 0; core < coreCount; ++core) {
     result[std::to_string(core)] = json11::Json::object{
-        {"x", 0}, {"mb", 0}, {"out", 0}, {"in", 0}};
+        {"mb", groupedCoreId(core, coreCount, groupCount)},
+        {"x", 0},
+        {"out", 0}};
   }
   return result;
 }
 
-json11::Json::object makeTargetKernelMap(int coreCount) {
+json11::Json::object makeMulticastConsumerComputeMap(int coreCount,
+                                                     int groupCount) {
