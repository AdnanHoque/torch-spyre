   for (int core = 0; core < coreCount; ++core) {
     result[std::to_string(core)] = json11::Json::object{
-        {"out", 0}, {"in", 0}, {"x", 0}};
+        {"x", 0},
+        {"mb", 0},
+        {"out", groupedCoreId(core, coreCount, groupCount)},
+        {"in", 0}};
   }
   return result;
 }
 
-json11::Json::object makeSourceLxMap(int coreCount) {
+json11::Json::object makeMulticastTargetKernelMap(int coreCount,
+                                                  int groupCount) {
   json11::Json::object result;
   for (int core = 0; core < coreCount; ++core) {
     result[std::to_string(core)] = json11::Json::object{
-        {"mb", 0}, {"x", 0}, {"out", 0}};
+        {"out", groupedCoreId(core, coreCount, groupCount)},
+        {"in", 0},
+        {"x", 0}};
+  }
+  return result;
+}
+
+json11::Json::object makeMulticastSourceLxMap(int coreCount, int groupCount) {
+  json11::Json::object result;
+  for (int core = 0; core < coreCount; ++core) {
+    result[std::to_string(core)] = json11::Json::object{
+        {"mb", 0},
+        {"x", groupedCoreId(core, coreCount, groupCount)},
+        {"out", 0}};
   }
   return result;
 }
@@ -324,23 +372,27 @@ json11::Json::object trimStartAddressCoreCorelet(const json11::Json& value,
   return object;
 }
 
-json11::Json shrinkBatchMatmulShape(const json11::Json& value) {
+json11::Json shrinkBatchMatmulShape(const json11::Json& value,
+                                    int xExtent = 1, int outExtent = 64) {
   auto object = value.object_items();
-  object["x_"] = 1;
+  object["x_"] = xExtent;
   object["mb_"] = 1;
-  object["out_"] = 64;
+  object["out_"] = outExtent;
   object["in_"] = 64;
   return object;
 }
 
-json11::Json shrinkBatchMatmulDataStageParam(const json11::Json& value) {
+json11::Json shrinkBatchMatmulDataStageParam(const json11::Json& value,
+                                             int xExtent = 1,
+                                             int outExtent = 64) {
   auto object = value.object_items();
   for (auto& [_key, stage] : object) {
     auto stageObject = stage.object_items();
     for (const auto& field : {"ss_", "el_"}) {
       const auto it = stageObject.find(field);
       if (it != stageObject.end() && it->second.is_object()) {
-        stageObject[field] = shrinkBatchMatmulShape(it->second);
+        stageObject[field] =
+            shrinkBatchMatmulShape(it->second, xExtent, outExtent);
       }
     }
     stage = stageObject;
@@ -448,7 +500,7 @@ void rewriteMatmulOperandBroadcastFixture(const std::string& testDataDir,
 
 void rewriteMatmulOperandBroadcastGatherRestickifyFixture(
     const std::string& testDataDir, const std::string& pattern) {
-  ASSERT_EQ(pattern, "broadcast");
+  ASSERT_TRUE(pattern == "broadcast" || pattern == "multicast");
 
