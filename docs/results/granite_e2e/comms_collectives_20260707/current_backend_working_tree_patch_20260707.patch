+                 "LX-neighbor transfer expects a non-empty layout order.");
+
+    constexpr int64_t kBytesPerStick = 128;
+    int createdCount = 0;
+    for (const auto& transfer : treeNode->lxNeighborRingTransfers_) {
+      const bool isLocalCopy =
+          transfer.sourceCoreId_ == transfer.destinationCoreId_;
+      const bool isSend = !isLocalCopy && genComp == SenComponents::L3SU &&
+                          transfer.sourceCoreId_ == pcfgInfo.c;
+      const bool isReceive = !isLocalCopy && genComp == SenComponents::L3LU &&
+                             transfer.destinationCoreId_ == pcfgInfo.c;
+      const bool isLocal = isLocalCopy && genComp == SenComponents::L3LU &&
+                           transfer.destinationCoreId_ == pcfgInfo.c;
+      if (!isSend && !isReceive && !isLocal) continue;
+      DT_CHECK_MSG(transfer.byteCount_ > 0,
+                   "Invalid LX-neighbor ring transfer byte count.");
+      DT_CHECK_MSG(transfer.byteCount_ % kBytesPerStick == 0,
+                   "LX-neighbor ring transfers must be stick aligned.");
+
+      const int64_t stickCount = transfer.byteCount_ / kBytesPerStick;
+      const std::string loopName = createPcfgNodeName(
+          globals.nameMap, pcfgInfo.c, pcfgInfo.clComp,
+          "-lx-neighbor-ring-loop-" +
+              std::string(isLocal ? "local-copy"
+                                  : (isSend ? "send" : "recv")) +
+              "-src" + std::to_string(transfer.sourceCoreId_) + "-dst" +
+              std::to_string(transfer.destinationCoreId_) + "-chunk" +
+              std::to_string(transfer.producerChunk_));
+      auto [loopNode, loopBranch] = SenPcfg::createLoopAndBranchEnd(
+          pcfg, loopName, static_cast<int>(stickCount), {}, -1);
+
+      auto* ringNode = static_cast<SenPcfgRingDtNode*>(
+          pcfg.createPcfgNode(SenPcfgNode::Type::RINGDATATRANSFER));
+      ringNode->name = createPcfgNodeName(
+          globals.nameMap, pcfgInfo.c, pcfgInfo.clComp,
+          "-lx-neighbor-" +
+              std::string(isLocal ? "local-copy"
+                                  : (isSend ? "ring-send" : "ring-recv")) +
+              "-src" + std::to_string(transfer.sourceCoreId_) + "-dst" +
+              std::to_string(transfer.destinationCoreId_) + "-chunk" +
+              std::to_string(transfer.producerChunk_));
+      ringNode->coreletId = -1;
+      ringNode->dtInfo = nullptr;
+      ringNode->dsInfo = nullptr;
+      ringNode->dtFormat = dstLds.dataFormat_;
+      ringNode->srcDest.src_ =
+          isLocal ? SenComponents::LX
+                  : (isSend ? SenComponents::LX : SenComponents::RING);
+      ringNode->srcDest.dst_ =
+          isLocal ? SenComponents::LX
+                  : (isSend ? SenComponents::RING : SenComponents::LX);
+      ringNode->dimLayoutOrder = dimLayoutOrder;
+      ringNode->coreIdForRing = {
+          static_cast<int64_t>(isLocal ? transfer.destinationCoreId_
+                                      : (isSend ? transfer.destinationCoreId_
+                                                : transfer.sourceCoreId_))};
+      ringNode->coreIDForRingCondAndVal.clear();
+      ringNode->GTRAndBurstCondAndVal.clear();
+      ringNode->useBurst = false;
+      ringNode->gtr_imm_opt_en = false;
+      ringNode->addrSpan = transfer.byteCount_;
+
+      for (const auto& dimStr : ringNode->dimLayoutOrder) {
+        ringNode->myBigDimSize[dimStr] = 1;
+        ringNode->myLitDimSize[dimStr] = 1;
+      }
+      PcfgDtOffsets stickOffset;
+      stickOffset.dimOffset = 1;
+      stickOffset.subDimOffset = 0;
+      stickOffset.uniDimOffset = 0;
+      stickOffset.freq = 1;
+      stickOffset.clSkipOffset = 0;
+      stickOffset.clSkipFreq = 1;
+      ringNode->bigStAddrOffsets[loopName] = stickOffset;
+
+      if (isLocal) {
+        ringNode->setSrcStAddr(transfer.sourceStartAddress_);
+        ringNode->setDestStAddr(transfer.destinationStartAddress_);
+      } else if (isSend) {
+        ringNode->setSrcStAddr(transfer.sourceStartAddress_);
+        ringNode->setDestStAddr(-1);
+      } else {
+        ringNode->setSrcStAddr(-1);
+        ringNode->setDestStAddr(transfer.destinationStartAddress_);
+      }
+
+      SenPcfg::pcfgInsertBelow(loopNode, scopeStack.getPos());
+      SenPcfg::pcfgInsertBelow(ringNode, loopNode);
+      SenPcfg::pcfgInsertBelow(loopBranch, ringNode);
+      scopeStack.updatePos(loopBranch);
+      ++createdCount;
+    }
+
+    if (std::getenv("DEEPTOOLS_LX_NEIGHBOR_RING_TRANSLATOR_DEBUG") !=
+        nullptr) {
+      std::cerr << "[LX-neighbor translator] unit="
+                << (genComp == SenComponents::L3SU ? "L3SU" : "L3LU")
+                << " core=" << pcfgInfo.c
+                << " logicalTransfers="
+                << treeNode->lxNeighborRingTransfers_.size()
+                << " pcfgRingNodes=" << createdCount << std::endl;
+    }
+    return;
+  }
+
   // Special DT conditions for current PCFG
   const bool isSrc = genComp == treeNode->src_.unit_;
   const bool isConstant = treeNode->src_.unit_ == SenComponents::CONSTANT;
