+json11::Json::object sourceCoreMapForFanoutPattern(
+    const std::string& pattern, int groupCount) {
+  json11::Json::object result;
+  if (pattern == "broadcast") {
+    result["0"] =
+        json11::Json::object{{"x", 0}, {"out", 0}, {"mb", 0}};
+    return result;
