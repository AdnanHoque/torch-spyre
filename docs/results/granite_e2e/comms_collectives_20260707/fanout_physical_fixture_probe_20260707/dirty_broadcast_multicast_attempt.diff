+json11::Json::object sourceSplitsForFanoutPattern(
+    const std::string& pattern, int groupCount) {
+  return json11::Json::object{
+      {"x", 1}, {"out", 1}, {"mb", pattern == "broadcast" ? 1 : groupCount}};
+}
+
+void updateSourceTensorForFanoutPattern(json11::Json::object* classification,
+                                        const std::string& pattern,
+                                        int groupCount) {
+  auto sourceTensor = (*classification)["source_lx_tensor"].object_items();
+  ASSERT_FALSE(sourceTensor.empty());
+
+  const auto sourceCoreMap = sourceCoreMapForFanoutPattern(pattern, groupCount);
+  sourceTensor["coreIdToWkSlice_"] = sourceCoreMap;
+  sourceTensor["computeCoreIdToWkSlice_"] = sourceCoreMap;
+  sourceTensor["numWkSlicesPerDim_"] =
+      sourceSplitsForFanoutPattern(pattern, groupCount);
+  (*classification)["source_lx_tensor"] = sourceTensor;
+}
