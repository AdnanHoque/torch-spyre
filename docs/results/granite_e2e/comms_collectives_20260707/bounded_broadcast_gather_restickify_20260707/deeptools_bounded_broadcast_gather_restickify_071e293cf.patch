@@ -252,6 +252,125 @@ json11::Json::object filterCoreMap(const json11::Json& value,
   return result;
 }
 
+json11::Json::object makeConsumerComputeMap(int coreCount) {
+  json11::Json::object result;
+  for (int core = 0; core < coreCount; ++core) {
+    result[std::to_string(core)] = json11::Json::object{
+        {"x", 0}, {"mb", 0}, {"out", 0}, {"in", 0}};
+  }
+  return result;
+}
+
+json11::Json::object makeTargetKernelMap(int coreCount) {
+  json11::Json::object result;
+  for (int core = 0; core < coreCount; ++core) {
+    result[std::to_string(core)] = json11::Json::object{
+        {"out", 0}, {"in", 0}, {"x", 0}};
+  }
+  return result;
+}
+
+json11::Json::object makeSourceLxMap(int coreCount) {
+  json11::Json::object result;
+  for (int core = 0; core < coreCount; ++core) {
+    result[std::to_string(core)] = json11::Json::object{
+        {"mb", 0}, {"x", 0}, {"out", 0}};
+  }
+  return result;
+}
+
+json11::Json::object makeCoreIdToDscMap(int coreCount) {
+  json11::Json::object result;
+  for (int core = 0; core < coreCount; ++core) {
+    result[std::to_string(core)] = 0;
+  }
+  return result;
+}
+
+json11::Json::array makeCoreIds(int coreCount) {
+  json11::Json::array result;
+  for (int core = 0; core < coreCount; ++core) result.push_back(core);
+  return result;
+}
+
+json11::Json::object makeSingleDscSchedule(int coreCount) {
+  json11::Json::object result;
+  for (int core = 0; core < coreCount; ++core) {
+    result[std::to_string(core)] =
+        json11::Json::array{json11::Json::array{-1, 0, 0, 0}};
+  }
+  return result;
+}
+
+json11::Json::object trimStartAddressCoreCorelet(const json11::Json& value,
+                                                 int coreCount) {
+  auto object = value.object_items();
+  auto attrs = object["dim_prop_attr"].array_items();
+  if (!attrs.empty()) {
+    auto coreAttr = attrs.at(0).object_items();
+    coreAttr["factor_"] = coreCount;
+    attrs.at(0) = coreAttr;
+    object["dim_prop_attr"] = attrs;
+  }
+
+  json11::Json::object data;
+  const auto oldData = object["data_"].object_items();
+  for (int core = 0; core < coreCount; ++core) {
+    const std::string key = "[" + std::to_string(core) + ", 0, 0]";
+    const auto it = oldData.find(key);
+    data[key] = it == oldData.end() ? json11::Json("131072") : it->second;
+  }
+  object["data_"] = data;
+  return object;
+}
+
+json11::Json shrinkBatchMatmulShape(const json11::Json& value) {
+  auto object = value.object_items();
+  object["x_"] = 1;
+  object["mb_"] = 1;
+  object["out_"] = 64;
+  object["in_"] = 64;
+  return object;
+}
+
+json11::Json shrinkBatchMatmulDataStageParam(const json11::Json& value) {
+  auto object = value.object_items();
+  for (auto& [_key, stage] : object) {
+    auto stageObject = stage.object_items();
+    for (const auto& field : {"ss_", "el_"}) {
+      const auto it = stageObject.find(field);
+      if (it != stageObject.end() && it->second.is_object()) {
+        stageObject[field] = shrinkBatchMatmulShape(it->second);
+      }
+    }
+    stage = stageObject;
+  }
+  return object;
+}
+
+json11::Json shrinkCoordinateInfoExtents(
+    const json11::Json& value,
+    const std::map<std::string, int>& dimToExtent) {
+  auto coordInfo = value.object_items();
+  for (const auto& [dim, extent] : dimToExtent) {
+    const auto dimIt = coordInfo.find(dim);
+    if (dimIt == coordInfo.end() || !dimIt->second.is_object()) continue;
+    auto dimInfo = dimIt->second.object_items();
+    auto folds = dimInfo["folds"].object_items();
+    auto attrs = folds["dim_prop_attr"].array_items();
+    if (attrs.empty()) continue;
+    for (std::size_t idx = 0; idx < attrs.size(); ++idx) {
+      auto attr = attrs.at(idx).object_items();
+      attr["factor_"] = idx == 0 ? extent : 1;
+      attrs.at(idx) = attr;
+    }
+    folds["dim_prop_attr"] = attrs;
+    dimInfo["folds"] = folds;
+    coordInfo[dim] = dimInfo;
+  }
+  return coordInfo;
+}
