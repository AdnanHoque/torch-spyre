+TEST_F(DxpTestFixture,
+       MatmulOperandBroadcastPatternBroadcastGatherRestickifyCompiles) {
+  SetUpTestData("test_matmul_operand_broadcast_chunk_cap");
+  rewriteMatmulOperandBroadcastGatherRestickifyFixture(testDataDir,
+                                                       "broadcast");
+
+  ScopedEnvVar restoreEnable(
+      "DEEPTOOLS_ENABLE_MATMUL_OPERAND_GATHER_RESTICKIFY");
+  ScopedEnvVar restoreCap("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_CHUNKS");
+  ScopedEnvVar restorePieces(
+      "DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_PIECES_PER_CHUNK");
+  ScopedEnvVar restorePiecesPerCore(
+      "DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_PIECES_PER_CORE_PER_CHUNK");
+  ScopedEnvVar restoreFrac("DXP_LX_FRAC_AVAIL");
+
+  setenv("DEEPTOOLS_ENABLE_MATMUL_OPERAND_GATHER_RESTICKIFY", "1", 1);
+  setenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_CHUNKS", "1", 1);
+  setenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_PIECES_PER_CHUNK", "256",
+         1);
+  setenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_PIECES_PER_CORE_PER_CHUNK",
+         "128", 1);
+  setenv("DXP_LX_FRAC_AVAIL", "1", 1);
+
+  SenTargets target = SenTargets::SENTIENT;
+  DesignSpaceConfigGlobal dscGlobal(target);
+  Dxp dxp(dscGlobal);
+  dxp.standalone = true;
+  dxp.debug = true;
+
+  dxp.runDxp(testDataDir);
+
+  const auto debugRoot = std::filesystem::path(testDataDir) / "debug";
+  ASSERT_TRUE(std::filesystem::exists(debugRoot))
+      << "Debug directory was not created at: " << debugRoot;
+
+  const auto planPath =
+      std::filesystem::current_path() /
+      "20_batchmatmul_Tensor1_0_matmul_operand_broadcast_plan.json";
+  ASSERT_TRUE(std::filesystem::exists(planPath))
+      << "Expected backend plan artifact at " << planPath;
+  {
+    std::ifstream jsonIn(planPath);
+    std::ostringstream jsonBuf;
+    jsonBuf << jsonIn.rdbuf();
+    const std::string text = jsonBuf.str();
+    EXPECT_NE(text.find("matmul_operand_broadcast_backend_plan"),
+              std::string::npos);
+    EXPECT_NE(text.find("broadcast"), std::string::npos);
+    EXPECT_NE(text.find("lowered_gather_then_restickify"),
+              std::string::npos);
+  }
+
+  bool sawGather = false;
+  bool sawRestickify = false;
+  for (const auto& entry :
+       std::filesystem::recursive_directory_iterator(debugRoot)) {
+    if (!entry.is_regular_file() || entry.path().extension() != ".json") {
+      continue;
+    }
+    std::ifstream jsonIn(entry.path());
+    std::ostringstream jsonBuf;
+    jsonBuf << jsonIn.rdbuf();
+    const std::string text = jsonBuf.str();
+    sawGather = sawGather || text.find("STCDPOpLx") != std::string::npos;
+    sawRestickify =
+        sawRestickify || text.find("ReStickifyOpLx") != std::string::npos;
+  }
+
+  EXPECT_TRUE(sawGather) << "Expected staged STCDPOpLx in debug SDSC output";
+  EXPECT_TRUE(sawRestickify)
+      << "Expected staged ReStickifyOpLx in debug SDSC output";
+}
