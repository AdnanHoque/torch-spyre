+def _compile_lx_relayout_contract(classification, producer_residency):
+    mb = Symbol("x0")
+    out = Symbol("x1")
+    op_spec = OpSpec(
+        op="neg",
+        is_reduction=False,
+        iteration_space={mb: (Integer(512), 1), out: (Integer(12800), 1)},
