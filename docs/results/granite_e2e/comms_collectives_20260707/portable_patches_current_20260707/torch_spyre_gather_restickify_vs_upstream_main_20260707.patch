+def test_core_view_residency_payload_is_static_per_core():
+    core_id = Symbol("core_id")
+    view = PerCoreView(
+        work_slice_dims=((0, 2), (1, 2)),
+        core_to_slot=((0, Mod(core_id, 2)), (1, floor(core_id / 2))),
+    )
+
+    assert _core_id_to_device_slice(view, 4) == {
+        "0": {"0": 0, "1": 0},
+        "1": {"0": 1, "1": 0},
+        "2": {"0": 0, "1": 1},
+        "3": {"0": 1, "1": 1},
+    }
+
