+static bool embeddedTensorLayoutStartsWith(
+    const std::map<std::string, std::string>& fields,
+    const std::string& tensorKey, const std::string& expectedFirstDim) {
+  const auto tensorIt = fields.find(tensorKey);
+  if (tensorIt == fields.end()) return false;
+  std::string parseError;
+  const auto tensor = json11::Json::parse(tensorIt->second, parseError);
+  if (!parseError.empty() || !tensor.is_object()) return false;
+  const auto layoutDimOrder = tensor["layoutDimOrder_"];
+  if (!layoutDimOrder.is_array() || layoutDimOrder.array_items().empty()) {
+    return false;
+  }
+  const auto& first = layoutDimOrder.array_items().front();
+  return first.is_string() && first.string_value() == expectedFirstDim;
+}
+
+static bool parseEmbeddedSourceLxTensorMetadata(
+    const std::map<std::string, std::string>& fields,
+    std::map<int, std::map<PrimaryDimTypes, int>>* coreIdToWkSlice,
+    std::map<int, int64_t>* startAddressByCore, std::string* reason) {
+  coreIdToWkSlice->clear();
+  startAddressByCore->clear();
+
+  const auto tensorIt = fields.find("source_lx_tensor");
+  if (tensorIt == fields.end()) {
+    *reason = "missing source_lx_tensor metadata";
+    return false;
+  }
+
+  std::string parseError;
+  const auto tensor = json11::Json::parse(tensorIt->second, parseError);
+  if (!parseError.empty() || !tensor.is_object()) {
+    *reason = "invalid source_lx_tensor JSON";
+    return false;
+  }
+
+  const auto slices = tensor["coreIdToWkSlice_"];
+  if (!slices.is_object()) {
+    *reason = "source_lx_tensor missing coreIdToWkSlice_";
+    return false;
+  }
+  for (const auto& [coreString, coordJson] : slices.object_items()) {
+    char* end = nullptr;
+    const long core = std::strtol(coreString.c_str(), &end, 10);
+    if (end == coreString.c_str() || *end != 0 || core < 0 ||
+        !coordJson.is_object()) {
+      *reason = "invalid source_lx_tensor coreIdToWkSlice_ entry";
+      return false;
+    }
+    auto& coord = (*coreIdToWkSlice)[static_cast<int>(core)];
+    for (const auto& [dimString, value] : coordJson.object_items()) {
+      const auto dimIt = EnumsConversion::stringToPrimaryDim.find(dimString);
+      if (dimIt == EnumsConversion::stringToPrimaryDim.end() ||
+          !value.is_number()) {
+        *reason = "invalid source_lx_tensor coordinate dim";
+        return false;
+      }
+      coord[dimIt->second] = static_cast<int>(value.number_value());
+    }
+  }
+
+  const auto addressData = tensor["startAddressCoreCorelet_"]["data_"];
+  if (!addressData.is_object()) {
+    *reason = "source_lx_tensor missing startAddressCoreCorelet_ data";
+    return false;
+  }
+  for (const auto& [foldKey, addressJson] : addressData.object_items()) {
+    int core = -1;
+    int64_t address = -1;
+    if (!parseCoreIdFromFoldKey(foldKey, &core) ||
+        !jsonNumberOrStringToInt64(addressJson, &address)) {
+      *reason = "invalid source_lx_tensor start address entry";
+      return false;
+    }
+    (*startAddressByCore)[core] = address;
+  }
+
+  if (coreIdToWkSlice->empty() || startAddressByCore->empty()) {
+    *reason = "empty source_lx_tensor metadata";
+    return false;
+  }
+  return true;
+}
+
+static bool valuesMatchForAllCommonCores(
+    const CoreDeviceSliceMap& deviceSlices,
+    const std::map<int, std::map<PrimaryDimTypes, int>>& wkSlices,
+    const std::string& deviceDim, const PrimaryDimTypes wkDim) {
+  bool sawCore = false;
+  for (const auto& [coreId, deviceCoord] : deviceSlices) {
+    const auto deviceDimIt = deviceCoord.find(deviceDim);
+    const auto wkCoreIt = wkSlices.find(coreId);
+    if (deviceDimIt == deviceCoord.end() || wkCoreIt == wkSlices.end()) {
+      continue;
+    }
+    const auto wkDimIt = wkCoreIt->second.find(wkDim);
+    if (wkDimIt == wkCoreIt->second.end() ||
+        static_cast<CoordinateBaseType>(wkDimIt->second) !=
+            deviceDimIt->second) {
+      return false;
+    }
+    sawCore = true;
+  }
+  return sawCore;
+}
+
+static std::map<std::string, PrimaryDimTypes>
+inferDeviceDimToWkDimFromOperandLayout(
+    const std::map<std::string, std::string>& fields,
+    const CoreDeviceSliceMap& producerSlices) {
+  const auto layoutIt = fields.find("operand_kernel_layout");
+  if (layoutIt == fields.end()) return {};
+
+  std::string parseError;
+  const auto layout = json11::Json::parse(layoutIt->second, parseError);
+  if (!parseError.empty() || !layout.is_object()) return {};
+
+  const auto layoutDimOrder = layout["layoutDimOrder_"];
+  if (!layoutDimOrder.is_array()) return {};
+
+  std::vector<std::string> deviceDims;
+  if (!producerSlices.empty()) {
+    for (const auto& [deviceDim, _] : producerSlices.begin()->second) {
+      deviceDims.push_back(deviceDim);
+    }
+  }
+  std::sort(deviceDims.begin(), deviceDims.end(), [](const auto& lhs, const auto& rhs) {
+    char* lhsEnd = nullptr;
+    char* rhsEnd = nullptr;
+    const long lhsValue = std::strtol(lhs.c_str(), &lhsEnd, 10);
+    const long rhsValue = std::strtol(rhs.c_str(), &rhsEnd, 10);
+    if (lhsEnd != nullptr && *lhsEnd == '\0' && rhsEnd != nullptr &&
+        *rhsEnd == '\0') {
+      return lhsValue < rhsValue;
+    }
+    return lhs < rhs;
+  });
+
+  std::map<std::string, PrimaryDimTypes> result;
+  const auto& layoutDims = layoutDimOrder.array_items();
+  const auto limit = std::min(deviceDims.size(), layoutDims.size());
+  for (size_t idx = 0; idx < limit; ++idx) {
+    if (!layoutDims[idx].is_string()) continue;
+    const auto dimIt =
+        EnumsConversion::stringToPrimaryDim.find(layoutDims[idx].string_value());
+    if (dimIt == EnumsConversion::stringToPrimaryDim.end()) continue;
+    result[deviceDims[idx]] = dimIt->second;
+  }
+  return result;
+}
+
+static bool seedMatmulOperandBroadcastDestinationCoordinates(
+    const SuperDsc& mySDsc, DesignSpaceConfig& dsc, const LabeledDsInfo& lds,
+    dsc2::AllocateNode* destinationAlloc, std::string* reason) {
+  const auto* fields = findMatmulOperandBroadcastClassification(mySDsc, lds);
+  if (fields == nullptr) {
+    *reason = "missing matmul_operand_broadcast classification";
+    return false;
+  }
+
+  std::map<int, std::map<PrimaryDimTypes, int>> embeddedSourceWkSlices;
+  std::map<int, int64_t> unusedEmbeddedSourceAddresses;
+  const auto* sourceAlloc =
+      findFoldedLxAllocationForLds(dsc, lds.ldsIdx_, destinationAlloc);
+  const auto* sourceWkSlices =
+      sourceAlloc != nullptr ? &sourceAlloc->allocateCoordinates_.coreIdToWkSlice_
+                             : nullptr;
+  if (sourceWkSlices == nullptr) {
+    if (!parseEmbeddedSourceLxTensorMetadata(
+            *fields, &embeddedSourceWkSlices, &unusedEmbeddedSourceAddresses,
+            reason)) {
+      return false;
+    }
+    sourceWkSlices = &embeddedSourceWkSlices;
+  }
+  const bool useEmbeddedTargetKernelCoordinates =
+      lds.dsType_ == KERNEL &&
+      embeddedTensorLayoutStartsWith(*fields, "source_lx_tensor", "x");
+  if (useEmbeddedTargetKernelCoordinates &&
+      fields->count("target_kernel_tensor")) {
+    std::map<int, std::map<PrimaryDimTypes, int>> targetWkSlices;
+    if (!parseEmbeddedTensorWkSlices(*fields, "target_kernel_tensor",
+                                     &targetWkSlices, reason)) {
+      return false;
+    }
+    destinationAlloc->allocateCoordinates_.coreIdToWkSlice_ =
+        std::move(targetWkSlices);
+    return true;
+  }
+
+  auto producerSlices =
+      parseCoreDeviceSliceMap(*fields, "producer_core_id_to_device_slice",
+                              reason);
+  if (producerSlices.empty()) return false;
+  auto consumerSlices =
+      parseCoreDeviceSliceMap(*fields, "consumer_core_id_to_device_slice",
+                              reason);
+  if (consumerSlices.empty()) return false;
+
+  std::set<PrimaryDimTypes> usedDims;
+  std::map<std::string, PrimaryDimTypes> deviceDimToWkDim =
+      inferDeviceDimToWkDimFromOperandLayout(*fields, producerSlices);
+  for (const auto& [_, deviceCoord] : producerSlices) {
+    for (const auto& [deviceDim, __] : deviceCoord) {
+      if (deviceDimToWkDim.count(deviceDim)) {
+        usedDims.insert(deviceDimToWkDim.at(deviceDim));
+        continue;
+      }
+      for (const auto& [___, wkCoord] : *sourceWkSlices) {
+        for (const auto& [candidateDim, ____] : wkCoord) {
+          if (usedDims.count(candidateDim)) continue;
+          if (valuesMatchForAllCommonCores(producerSlices, *sourceWkSlices,
+                                           deviceDim, candidateDim)) {
+            deviceDimToWkDim[deviceDim] = candidateDim;
+            usedDims.insert(candidateDim);
+            break;
+          }
+        }
+        if (deviceDimToWkDim.count(deviceDim)) break;
+      }
+      if (!deviceDimToWkDim.count(deviceDim)) {
+        *reason = "could not map device dim " + deviceDim +
+                  " to source coordinate dim";
+        return false;
+      }
+    }
+    break;
+  }
+
+  std::map<int, std::map<PrimaryDimTypes, int>> destinationWkSlices;
+  for (const auto& [coreId, consumerCoord] : consumerSlices) {
+    const auto sourceCoreIt = sourceWkSlices->find(coreId);
+    if (sourceCoreIt != sourceWkSlices->end()) {
+      destinationWkSlices[coreId] = sourceCoreIt->second;
+    }
+    for (const auto& [deviceDim, value] : consumerCoord) {
+      const auto dimIt = deviceDimToWkDim.find(deviceDim);
+      if (dimIt == deviceDimToWkDim.end()) {
+        *reason = "consumer device dim " + deviceDim +
+                  " was not present in producer mapping";
+        return false;
+      }
+      destinationWkSlices[coreId][dimIt->second] = static_cast<int>(value);
+    }
+  }
+
+  if (destinationWkSlices.empty()) {
+    *reason = "empty destination coordinate map";
+    return false;
+  }
+
+  destinationAlloc->allocateCoordinates_.coreIdToWkSlice_ =
+      std::move(destinationWkSlices);
+  return true;
+}
+
+static bool populateMatmulOperandBroadcastRingTransfers(
+    const SuperDsc& mySDsc, DesignSpaceConfig& dsc,
+    const LabeledDsInfo& lds,
+    const dsc2::AllocateNode& destinationAlloc,
+    dsc2::TransferNode* transNode, const uint64_t bytesPerStick,
+    std::string* reason) {
+  const auto* fields = findMatmulOperandBroadcastClassification(mySDsc, lds);
+  if (fields == nullptr) {
+    *reason = "missing matmul_operand_broadcast classification";
+    return false;
+  }
+
+  const auto plan =
+      deeptools::synthesizeMatmulOperandBroadcastMovementPlan(*fields);
+  if (!plan.ok) {
+    *reason = plan.reason;
+    return false;
+  }
+  if (plan.producerChunksPerGroup == 0) {
+    *reason = "producerChunksPerGroup must be non-zero";
+    return false;
+  }
+  int64_t operandBytes = lds.lxSize_;
+  if (operandBytes <= 0) {
+    operandBytes = dsc.getBufferCapacityForNode(
+        &destinationAlloc, lds.ldsIdx_, destinationAlloc.component_, -1,
+        bytesPerStick);
+  }
+  if (operandBytes <= 0 ||
+      operandBytes % static_cast<int64_t>(plan.producerChunksPerGroup) != 0) {
+    *reason = "cannot derive per-producer-chunk LX byte size";
+    return false;
+  }
+
+  const int64_t bytesPerProducerChunk =
+      operandBytes / static_cast<int64_t>(plan.producerChunksPerGroup);
+  const auto logicalTransfers =
+      deeptools::matmulOperandBroadcastLogicalTransfers(plan);
+  if (logicalTransfers.empty()) {
+    *reason = "matmul_operand_broadcast expanded to no logical transfers";
+    return false;
+  }
+  const auto* sourceAlloc =
+      findFoldedLxAllocationForLds(dsc, lds.ldsIdx_, &destinationAlloc);
+  std::map<int, std::map<PrimaryDimTypes, int>> unusedEmbeddedSourceWkSlices;
+  std::map<int, int64_t> embeddedSourceAddresses;
+  if (sourceAlloc == nullptr &&
+      !parseEmbeddedSourceLxTensorMetadata(*fields, &unusedEmbeddedSourceWkSlices,
+                                           &embeddedSourceAddresses, reason)) {
+    return false;
+  }
+
+  transNode->stagedLayoutConversion_ = {};
+  if (plan.requiresLayoutConversion) {
+    transNode->stagedLayoutConversion_.enabled_ = true;
+    transNode->stagedLayoutConversion_.kind_ = plan.kind;
+    transNode->stagedLayoutConversion_.layoutTransformJson_ = plan.layoutTransformJson;
+    transNode->stagedLayoutConversion_.sourceLxTensorJson_ = plan.sourceLxTensorJson;
+    transNode->stagedLayoutConversion_.targetKernelTensorJson_ = plan.targetKernelTensorJson;
+    transNode->stagedLayoutConversion_.stagedDestinationJson_ = plan.stagedDestinationJson;
+  }
+
+  transNode->lxNeighborRingTransfers_.clear();
+  transNode->lxNeighborRingTransfers_.reserve(logicalTransfers.size());
+  for (const auto& logicalTransfer : logicalTransfers) {
+    const int sourceCore = static_cast<int>(logicalTransfer.sourceCore);
+    const int destinationCore =
+        static_cast<int>(logicalTransfer.destinationCore);
+    int64_t sourceBase = -1;
+    if (sourceAlloc != nullptr) {
+      sourceBase = sourceAlloc->startAddressCoreCorelet_.getData(sourceCore, 0, 0);
+    } else {
+      const auto sourceAddressIt = embeddedSourceAddresses.find(sourceCore);
+      if (sourceAddressIt != embeddedSourceAddresses.end()) {
+        sourceBase = sourceAddressIt->second;
+      }
+    }
+    if (sourceBase < 0) {
+      *reason = "missing source LX address";
+      return false;
+    }
+
+    const int64_t destinationBase =
+        destinationAlloc.startAddressCoreCorelet_.getData(destinationCore, 0,
+                                                         0);
+    if (destinationBase < 0) {
+      *reason = "invalid source or destination LX address";
+      return false;
+    }
+
+    dsc2::TransferNode::LxNeighborRingTransfer physicalTransfer;
+    physicalTransfer.sourceCoreId_ = sourceCore;
+    physicalTransfer.destinationCoreId_ = destinationCore;
+    physicalTransfer.sourceStartAddress_ = sourceBase;
+    physicalTransfer.destinationStartAddress_ =
+        destinationBase +
+        static_cast<int64_t>(logicalTransfer.producerChunk) *
+            bytesPerProducerChunk;
+    physicalTransfer.byteCount_ = bytesPerProducerChunk;
+    physicalTransfer.group_ = static_cast<int64_t>(logicalTransfer.group);
+    physicalTransfer.producerChunk_ =
+        static_cast<int64_t>(logicalTransfer.producerChunk);
+    physicalTransfer.consumerReplica_ =
+        static_cast<int64_t>(logicalTransfer.consumerReplica);
+    transNode->lxNeighborRingTransfers_.push_back(physicalTransfer);
+  }
+  return true;
+}
+
+static void populateMatmulOperandBroadcastRingTransfersAfterAllocation(
+    SuperDsc& mySDsc, const uint64_t bytesPerStick) {
+  for (auto& dsc : mySDsc.dscs_) {
+    auto transferNodes = dsc.scheduleTree_.traverseTreeDFSMutable(
+        nullptr, {dsc2::ScheduleNode::TRANSFER});
+    for (auto* node : transferNodes) {
+      auto* transNode = dynamic_cast<dsc2::TransferNode*>(node);
+      DT_CHECK_MSG(transNode, "Expect a valid transfer node.");
+      if (transNode->name_.find("_lx_neighbor") == std::string::npos) {
+        continue;
+      }
+      if (transNode->dstLdsAndLoopOffsets_.empty()) continue;
+      if (transNode->dstVias_.empty() ||
+          transNode->dstVias_.front().loc_.storage_ != SenComponents::LX) {
+        continue;
+      }
+      const int ldsIdx = transNode->dstLdsAndLoopOffsets_.front().myLdsIdx_;
+      if (ldsIdx < 0) continue;
+      auto& lds = dsc.labeledDs_.at(ldsIdx);
+      if (findMatmulOperandBroadcastClassification(mySDsc, lds) == nullptr) {
+        continue;
+      }
+      DT_CHECK_MSG(lds.memOrg_.count(SenComponents::LX),
+                   "Expect LX in memOrg_ for matmul operand broadcast.");
+      auto* allocNode = lds.memOrg_.at(SenComponents::LX).allocateNode_;
+      DT_CHECK_MSG(allocNode, "Expect allocated LX destination.");
+      std::string reason;
+      DT_CHECK_MSG(populateMatmulOperandBroadcastRingTransfers(
+                       mySDsc, dsc, lds, *allocNode, transNode,
+                       bytesPerStick, &reason),
+                   reason);
+      transNode->src_.unit_ = SenComponents::NO_COMPONENT;
+      transNode->src_.storage_ = SenComponents::NO_COMPONENT;
+      transNode->dstVias_.front().loc_.unit_ = SenComponents::L3LU;
+      transNode->dstVias_.front().loc_.storage_ = SenComponents::LX;
+      transNode->dstVias_.front().via_.push_back(SenComponents::L3SU);
+      dsc.setRelevantCompCoreCl();
+    }
+  }
+}
