+std::vector<LayoutAllgatherRestickifyLogicalTransfer>
+layoutAllgatherRestickifyLogicalTransfers(
+    const LayoutAllgatherRestickifyMovementPlan &plan) {
+  std::vector<LayoutAllgatherRestickifyLogicalTransfer> transfers;
+  if (!plan.ok || plan.groupCount == 0 || plan.producerChunksPerGroup == 0 ||
+      plan.consumerCoresPerGroup == 0) {
+    return transfers;
+  }
+  transfers.reserve(plan.logicalTransferCount);
+  for (std::uint64_t group = 0; group < plan.groupCount; ++group) {
+    for (std::uint64_t producerChunk = 0;
+         producerChunk < plan.producerChunksPerGroup; ++producerChunk) {
+      const std::uint64_t sourceCore =
+          producerChunk * plan.groupCount + group;
+      for (std::uint64_t consumerReplica = 0;
+           consumerReplica < plan.consumerCoresPerGroup; ++consumerReplica) {
+        const std::uint64_t destinationCore =
+            consumerReplica * plan.groupCount + group;
+        transfers.push_back({group, producerChunk, consumerReplica, sourceCore,
+                             destinationCore});
+      }
+    }
+  }
+  return transfers;
+}
