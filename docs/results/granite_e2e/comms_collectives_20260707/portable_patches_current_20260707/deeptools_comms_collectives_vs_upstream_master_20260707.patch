+using CoreDeviceSliceMap =
+    std::map<int, std::map<std::string, CoordinateBaseType>>;
+
+static CoreDeviceSliceMap parseCoreDeviceSliceMap(
+    const std::map<std::string, std::string>& fields,
+    const std::string& key, std::string* reason) {
+  const auto fieldIt = fields.find(key);
+  if (fieldIt == fields.end()) {
+    *reason = "missing " + key;
+    return {};
+  }
+
+  std::string parseError;
+  const auto parsed = json11::Json::parse(fieldIt->second, parseError);
+  if (!parseError.empty() || !parsed.is_object()) {
+    *reason = "invalid JSON object in " + key;
+    return {};
+  }
+
+  CoreDeviceSliceMap result;
+  for (const auto& [coreIdString, coordJson] : parsed.object_items()) {
+    char* end = nullptr;
+    const long coreId = std::strtol(coreIdString.c_str(), &end, 10);
+    if (end == nullptr || *end != '\0' || coreId < 0 ||
+        !coordJson.is_object()) {
+      *reason = "invalid core entry in " + key;
+      return {};
+    }
+    auto& coord = result[static_cast<int>(coreId)];
+    for (const auto& [dim, value] : coordJson.object_items()) {
+      if (!value.is_number()) {
+        *reason = "invalid dimension value in " + key;
+        return {};
+      }
+      coord[dim] = static_cast<CoordinateBaseType>(value.number_value());
+    }
+  }
+
+  if (result.empty()) *reason = "empty " + key;
+  return result;
+}
+
+static dsc2::AllocateNode* findFoldedLxAllocationForLds(
+    DesignSpaceConfig& dsc, const int ldsIdx,
+    const dsc2::AllocateNode* excludeNode) {
+  auto allocNodes = dsc.scheduleTree_.traverseTreeDFSMutable(
+      nullptr, {dsc2::ScheduleNode::ALLOCATE});
+  for (auto* node : allocNodes) {
+    auto* allocNode = dynamic_cast<dsc2::AllocateNode*>(node);
+    DT_CHECK_MSG(allocNode, "Expect a valid allocate node.");
+    if (allocNode == excludeNode || allocNode->ldsIdx_ != ldsIdx ||
+        allocNode->component_ != SenComponents::LX ||
+        !allocNode->allocateCoordinates_.foldConstructed() ||
+        allocNode->allocateCoordinates_.coreIdToWkSlice_.empty()) {
+      continue;
+    }
+    return allocNode;
+  }
+  return nullptr;
+}
+
+static bool parseCoreIdFromFoldKey(const std::string& key, int* coreId) {
+  const auto begin = key.find('[');
+  if (begin == std::string::npos) return false;
+  const char* start = key.c_str() + begin + 1;
+  char* end = nullptr;
+  const long parsed = std::strtol(start, &end, 10);
+  if (end == start || parsed < 0) return false;
+  *coreId = static_cast<int>(parsed);
+  return true;
+}
+
+static bool jsonNumberOrStringToInt64(const json11::Json& value,
+                                      int64_t* parsed) {
+  if (value.is_number()) {
+    *parsed = static_cast<int64_t>(value.number_value());
+    return true;
+  }
+  if (!value.is_string()) return false;
+  char* end = nullptr;
+  const long long result = std::strtoll(value.string_value().c_str(), &end, 10);
+  if (end == value.string_value().c_str() || *end != 0) return false;
+  *parsed = static_cast<int64_t>(result);
+  return true;
+}
