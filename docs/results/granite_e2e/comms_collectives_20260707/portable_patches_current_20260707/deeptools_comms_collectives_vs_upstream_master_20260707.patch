+TEST(LayoutAllgatherRestickify, mismatchedGroupsUseCoordinateRepartition) {
+  const auto contract = replaceFirst(
+      validFlashContract(),
+      R"json("consumer_work_slice_dims": {"x": 4, "mb": 8, "out": 1, "in": 1})json",
+      R"json("consumer_work_slice_dims": {"x": 2, "mb": 16, "out": 1, "in": 1})json");
+
+  const auto plan =
+      deeptools::synthesizeLayoutAllgatherRestickifyMovementPlan(contract);
+
+  EXPECT_TRUE(plan.ok) << plan.reason;
+  EXPECT_EQ(plan.groupCount, 1);
+  EXPECT_EQ(plan.producerChunksPerGroup, 32);
+  EXPECT_EQ(plan.consumerCoresPerGroup, 32);
+  ASSERT_EQ(plan.stages.size(), 3);
+  EXPECT_EQ(plan.stages[1], "coordinate_overlap_repartition");
+}
