+      cache;
+  return cache;
+}
+
+void rememberLxNeighborCoordinates(const dsc2::AllocateNode *allocNode) {
+  return;
+  if (allocNode == nullptr || allocNode->component_ != SenComponents::LX ||
+      allocNode->name_.find("allocate_lds") == std::string::npos ||
+      !allocNode->allocateCoordinates_.foldConstructed() ||
+      allocNode->allocateCoordinates_.coordinates_.empty()) {
+    return;
+  }
+  lxNeighborCoordinateCache()[{allocNode->name_, allocNode->ldsIdx_}] =
+      allocNode->allocateCoordinates_;
+}
+
+bool seedLxNeighborAllocationFromCache(dsc2::AllocateNode *allocNode) {
+  return false;
+  if (allocNode == nullptr || allocNode->component_ != SenComponents::LX ||
+      allocNode->name_.find("allocate_lds") == std::string::npos ||
+      allocNode->allocateCoordinates_.foldConstructed()) {
+    return false;
+  }
+  const auto it =
+      lxNeighborCoordinateCache().find({allocNode->name_, allocNode->ldsIdx_});
+  if (it == lxNeighborCoordinateCache().end()) return false;
+  allocNode->allocateCoordinates_ = it->second;
+  allocNode->allocateCoordinates_.completeFoldConstruction();
+  return true;
+}
