+json11::Json shrinkBatchMatmulDataStageParam(const json11::Json& value,
+                                             int xExtent = 1,
+                                             int outExtent = 64) {
+  auto object = value.object_items();
+  for (auto& [_key, stage] : object) {
+    auto stageObject = stage.object_items();
+    for (const auto& field : {"ss_", "el_"}) {
+      const auto it = stageObject.find(field);
+      if (it != stageObject.end() && it->second.is_object()) {
+        stageObject[field] =
+            shrinkBatchMatmulShape(it->second, xExtent, outExtent);
+      }
+    }
+    stage = stageObject;
+  }
+  return object;
+}
