+bool checkedMul(std::uint64_t lhs, std::uint64_t rhs, std::uint64_t *result) {
+  if (lhs != 0 && rhs > std::numeric_limits<std::uint64_t>::max() / lhs) {
+    return false;
+  }
+  *result = lhs * rhs;
+  return true;
+}
+
+bool checkedAddProduct(std::uint64_t lhs, std::uint64_t rhs,
+                       std::uint64_t *total) {
+  std::uint64_t product = 0;
+  if (!checkedMul(lhs, rhs, &product)) return false;
+  if (product > std::numeric_limits<std::uint64_t>::max() - *total) {
+    return false;
+  }
+  *total += product;
+  return true;
+}
+
+std::uint64_t positiveUintFieldForAnyKey(
+    const Json &json, const std::vector<std::string> &keys) {
+  for (const auto &key : keys) {
+    const auto value = positiveUintField(json, key);
+    if (value != 0) return value;
+  }
+  return 0;
+}
+
+std::int64_t signedIntFieldForAnyKey(
+    const Json &json, const std::vector<std::string> &keys) {
+  for (const auto &key : keys) {
+    if (json[key].is_number()) {
+      return static_cast<std::int64_t>(json[key].number_value());
+    }
+  }
+  return -1;
+}
