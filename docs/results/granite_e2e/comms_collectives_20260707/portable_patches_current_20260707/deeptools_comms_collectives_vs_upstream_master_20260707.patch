+    const auto patternIt = fields.find("communication_pattern");
+    const bool isLayoutAllgather =
+        (kindIt != fields.end() &&
+         kindIt->second == "layout_allgather_restickify") ||
+        (patternIt != fields.end() &&
+         patternIt->second == "layout_allgather_restickify");
+    if (!isLayoutAllgather) continue;
+    if (!layoutAllgatherRestickifyMatchesLds(fields, lds)) continue;
+
+    return {entry.first,
+            deeptools::synthesizeLayoutAllgatherRestickifyMovementPlan(fields)};
+  }
+
+  return {};
+}
+
+static bool partialViewGatherMatchesLds(
+    const std::map<std::string, std::string>& fields,
+    const LabeledDsInfo& lds) {
+  const auto readIndexIt = fields.find("read_index");
+  if (readIndexIt != fields.end()) return std::stoi(readIndexIt->second) == lds.ldsIdx_;
+
+  const auto ldsIt = fields.find("input_labeled_ds");
+  if (ldsIt != fields.end()) return ldsIt->second == lds.dsName_;
+
+  return true;
+}
+
+static PartialViewGatherHook findPartialViewGatherHook(
+    const SuperDsc* sdsc, const LabeledDsInfo& lds) {
+  for (const auto& entry : sdsc->lxRelayoutClassifications_) {
+    const auto& fields = entry.second;
+    const auto kindIt = fields.find("kind");
+    const auto patternIt = fields.find("communication_pattern");
+    const bool isPartialViewGather =
+        (kindIt != fields.end() && kindIt->second == "partial_view_gather") ||
+        (patternIt != fields.end() &&
+         patternIt->second == "partial_view_gather");
+    if (!isPartialViewGather) continue;
+    if (!partialViewGatherMatchesLds(fields, lds)) continue;
+    return {entry.first, fields};
+  }
+
+  return {};
+}
+
+static bool partialViewGatherSourceOffsetBytes(
+    const PartialViewGatherHook& hook, const LabeledDsInfo& lds,
+    int64_t* offsetBytes, std::string* reason) {
+  *offsetBytes = 0;
+  const auto offsetIt = hook.fields.find("source_offset_elems");
+  if (offsetIt == hook.fields.end()) {
+    *reason = "partial_view_gather is missing source_offset_elems";
+    return false;
+  }
+  char* end = nullptr;
+  errno = 0;
+  const auto offsetElems = std::strtoll(offsetIt->second.c_str(), &end, 10);
+  if (errno != 0 || end == nullptr || *end != '\0' || offsetElems < 0) {
+    *reason = "partial_view_gather has invalid source_offset_elems=" +
+              offsetIt->second;
+    return false;
+  }
+  *offsetBytes =
+      static_cast<int64_t>(std::ceil(offsetElems * lds.wordLength));
+  return true;
+}
+
+static bool matmulOperandBroadcastMatchesLds(
+    const std::map<std::string, std::string>& fields,
+    const LabeledDsInfo& lds) {
+  for (const auto& key : {"read_index", "operand_index",
+                          "operand_read_index"}) {
+    const auto it = fields.find(key);
+    if (it == fields.end()) continue;
+    return std::stoi(it->second) == lds.ldsIdx_;
+  }
+
+  const auto ldsIt = fields.find("input_labeled_ds");
+  if (ldsIt != fields.end()) return ldsIt->second == lds.dsName_;
+
+  return true;
+}
+
+static int matmulOperandBroadcastOperandIndexFromFields(
+    const std::map<std::string, std::string>& fields) {
+  for (const auto& key : {"read_index", "operand_index",
+                          "operand_read_index"}) {
+    const auto it = fields.find(key);
+    if (it == fields.end()) continue;
+    char* end = nullptr;
+    const long parsed = std::strtol(it->second.c_str(), &end, 10);
+    if (end == it->second.c_str() ||
+        (end != nullptr && *end != '\0') || parsed < 0) {
+      return -1;
+    }
+    return static_cast<int>(parsed);
+  }
+  return -1;
+}
+
+static MatmulOperandBroadcastHookPlan findMatmulOperandBroadcastPlan(
+    const SuperDsc* sdsc, const LabeledDsInfo& lds) {
+  for (const auto& entry : sdsc->lxRelayoutClassifications_) {
+    const auto& fields = entry.second;
+    const auto kindIt = fields.find("kind");
+    const auto patternIt = fields.find("communication_pattern");
+    const bool isMatmulOperandBroadcast =
+        (kindIt != fields.end() &&
+         kindIt->second == "matmul_operand_broadcast") ||
+        (patternIt != fields.end() &&
+         (patternIt->second == "all_gather_replicate" ||
+          patternIt->second == "broadcast" ||
+          patternIt->second == "multicast"));
+    if (!isMatmulOperandBroadcast) continue;
+    if (!matmulOperandBroadcastMatchesLds(fields, lds)) continue;
+
+    const auto plan =
+        deeptools::synthesizeMatmulOperandBroadcastMovementPlan(fields);
+    int operandIndex = matmulOperandBroadcastOperandIndexFromFields(fields);
+    if (operandIndex < 0 && plan.operandIndex >= 0) {
+      operandIndex = static_cast<int>(plan.operandIndex);
+    }
+    return {entry.first, plan, operandIndex};
+  }
+
+  return {};
+}
