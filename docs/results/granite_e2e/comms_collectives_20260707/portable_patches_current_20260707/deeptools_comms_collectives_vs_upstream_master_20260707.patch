+static bool attachMatmulOperandBroadcastInputFetch(
+    SuperDsc* sdsc, const LabeledDsInfo& lds,
+    const MatmulOperandBroadcastHookPlan& hook, std::string* reason) {
+  (void)hook;
+  DT_CHECK(sdsc->dscs_.size() == 1);
+  auto& dldsc = sdsc->dscs_.at(0);
+  const auto allocNode = lds.memOrg_.count(SenComponents::LX)
+                             ? lds.memOrg_.at(SenComponents::LX).allocateNode_
+                             : nullptr;
+  if (allocNode == nullptr) {
+    *reason = "matmul_operand_broadcast input has no LX allocate node";
+    return false;
+  }
+  const auto producerCoreIdToWkSlice =
+      allocNode->allocateCoordinates_.coreIdToWkSlice_;
+  if (producerCoreIdToWkSlice.empty()) {
+    *reason = "matmul_operand_broadcast input has empty producer coordinates";
+    return false;
+  }
+
+  const auto& refDsInfo = dldsc.primaryDsInfo_.at(lds.dsType_);
+  const auto producerSliceIds =
+      collectTensorSliceIds(producerCoreIdToWkSlice,
+                            refDsInfo.layoutDimOrder_);
+  const auto consumerSliceIds =
+      collectTensorSliceIds(sdsc->coreIdToWkSlice_, refDsInfo.layoutDimOrder_);
+
+  int64_t replicatedDstAddr = -1;
+  for (const auto& coreAndSlice : sdsc->coreIdToWkSlice_) {
+    const auto dstAddr = lxStartAddressForCore(lds, coreAndSlice.first);
+    if (dstAddr < 0) {
+      *reason = "missing destination LX base for consumer core " +
+                std::to_string(coreAndSlice.first);
+      return false;
+    }
+    if (replicatedDstAddr < 0) {
+      replicatedDstAddr = dstAddr;
+    } else if (replicatedDstAddr != dstAddr) {
+      *reason = "matmul_operand_broadcast requires equal destination LX bases";
+      return false;
+    }
+  }
+
+  std::vector<int> dataOpIndices;
+  const bool useSingleIfnDataOp =
+      std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_SINGLE_IFN") !=
+      nullptr;
+  DataOpDsc singleDdsc;
+  std::set<int> singleCoresSeen;
+  LdsInfo* singleInpLds = nullptr;
+  LdsInfo* singleOutLds = nullptr;
+  if (useSingleIfnDataOp) {
+    singleDdsc.dscName_ = sdsc->name_ + "-" + lds.dsName_ +
+                          "-LxInputNeighborFetch-combined";
+    singleDdsc.opName = OpFuncs::STCDPOpLx;
+    singleDdsc.op = new STCDPOpLx;
+    singleDdsc.op->name = OpFuncs::STCDPOpLx;
+    singleDdsc.primaryDs_["activation"].name_ = "activation";
+    singleDdsc.target_ = sdsc->target_;
+    singleDdsc.foldProps_.push_back(new FoldDimProp(
+        sdsc->sdscFoldProps_.at(0)->getSize(), "time"));
+    singleDdsc.labeledDs_.resize(2);
+    singleInpLds = &singleDdsc.labeledDs_.at(0);
+    singleOutLds = &singleDdsc.labeledDs_.at(1);
+    singleInpLds->ldsName_ = lds.dsName_ + "-LxInputNeighborFetch-inp";
+    singleOutLds->ldsName_ = lds.dsName_;
+    fillDataOpLdsShape(*singleInpLds, singleDdsc, lds, dldsc);
+    fillDataOpLdsShape(*singleOutLds, singleDdsc, lds, dldsc);
+    singleDdsc.dimPool_ = singleDdsc.primaryDs_.at("activation").dimNames;
+    DT_CHECK(singleOutLds->stickDimOrder_ == singleInpLds->stickDimOrder_);
+    DT_CHECK(singleOutLds->dimToStickSize_ ==
+             singleInpLds->dimToStickSize_);
+  }
+
+  for (const auto& coreAndSlice : producerCoreIdToWkSlice) {
+    std::vector<int> destinationCores;
+    for (const auto& dstCoreAndSlice : sdsc->coreIdToWkSlice_) {
+      std::map<std::string, double> ignoredSize;
+      std::map<std::string, double> ignoredStart;
+      if (tensorSliceIntersectionCell(
+              dldsc, coreAndSlice.second, producerSliceIds,
+              dstCoreAndSlice.second, consumerSliceIds,
+              refDsInfo.layoutDimOrder_, &ignoredSize, &ignoredStart)) {
+        destinationCores.push_back(dstCoreAndSlice.first);
+      }
+    }
+    if (destinationCores.empty()) {
+      *reason =
+          "matmul_operand_broadcast found no overlapping consumers for "
+          "producer core " +
+          std::to_string(coreAndSlice.first);
+      return false;
+    }
+
+    DataOpDsc ddsc;
+    LdsInfo* inpLdsPtr = singleInpLds;
+    LdsInfo* outLdsPtr = singleOutLds;
+    std::set<int> coresSeen;
+    if (!useSingleIfnDataOp) {
+      ddsc.dscName_ = sdsc->name_ + "-" + lds.dsName_ +
+                      "-LxInputNeighborFetch-src" +
+                      std::to_string(coreAndSlice.first);
+      ddsc.opName = OpFuncs::STCDPOpLx;
+      ddsc.op = new STCDPOpLx;
+      ddsc.op->name = OpFuncs::STCDPOpLx;
+      ddsc.primaryDs_["activation"].name_ = "activation";
+      ddsc.target_ = sdsc->target_;
+      ddsc.foldProps_.push_back(new FoldDimProp(
+          sdsc->sdscFoldProps_.at(0)->getSize(), "time"));
+      if (coresSeen.insert(coreAndSlice.first).second) {
+        ddsc.coreIdsUsed_.push_back(coreAndSlice.first);
+      }
+      for (const auto dstCore : destinationCores) {
+        if (coresSeen.insert(dstCore).second)
+          ddsc.coreIdsUsed_.push_back(dstCore);
+      }
+
+      ddsc.labeledDs_.resize(2);
+      auto& inpLds = ddsc.labeledDs_.at(0);
+      auto& outLds = ddsc.labeledDs_.at(1);
+      inpLds.ldsName_ = lds.dsName_ + "-LxInputNeighborFetch-inp-src" +
+                        std::to_string(coreAndSlice.first);
+      outLds.ldsName_ = lds.dsName_;
+      fillDataOpLdsShape(inpLds, ddsc, lds, dldsc);
+      fillDataOpLdsShape(outLds, ddsc, lds, dldsc);
+      ddsc.dimPool_ = ddsc.primaryDs_.at("activation").dimNames;
+      DT_CHECK(outLds.stickDimOrder_ == inpLds.stickDimOrder_);
+      DT_CHECK(outLds.dimToStickSize_ == inpLds.dimToStickSize_);
+      inpLdsPtr = &inpLds;
+      outLdsPtr = &outLds;
+    } else {
+      if (singleCoresSeen.insert(coreAndSlice.first).second) {
+        singleDdsc.coreIdsUsed_.push_back(coreAndSlice.first);
+      }
+      for (const auto dstCore : destinationCores) {
+        if (singleCoresSeen.insert(dstCore).second)
+          singleDdsc.coreIdsUsed_.push_back(dstCore);
+      }
+    }
+
+    std::map<std::string, double> dimToSize;
+    std::map<std::string, double> dimToStart;
+    for (const auto& pDim : refDsInfo.layoutDimOrder_) {
+      const std::string dimName = dataOpDimName(dldsc, pDim);
+      const double dimExtent = dldsc.N_.primaryDimToVal_st(pDim);
+      const auto splitIt = producerSliceIds.find(pDim);
+      const int split = splitIt == producerSliceIds.end()
+                            ? 1
+                            : static_cast<int>(splitIt->second.size());
+      DT_CHECK(split > 0);
+      DT_CHECK(static_cast<int>(dimExtent) % split == 0);
+      const int sliceIdx = coreAndSlice.second.count(pDim)
+                               ? coreAndSlice.second.at(pDim)
+                               : 0;
+      dimToSize[dimName] = dimExtent / split;
+      dimToStart[dimName] = sliceIdx * dimToSize.at(dimName);
+    }
+    const auto srcAddr = lxStartAddressForCore(lds, coreAndSlice.first);
+    if (srcAddr < 0) {
+      *reason = "missing source LX base for producer core " +
+                std::to_string(coreAndSlice.first);
+      return false;
+    }
+
+    const std::string pieceSuffix = useSingleIfnDataOp
+                                        ? std::to_string(coreAndSlice.first)
+                                        : "0";
+    addLxPiece(*inpLdsPtr, "src" + pieceSuffix, coreAndSlice.first, srcAddr,
+               dimToSize, dimToStart);
+    addReplicatedLxPiece(*outLdsPtr, "dst" + pieceSuffix, destinationCores,
+                         replicatedDstAddr, dimToSize, dimToStart);
+
+    if (!useSingleIfnDataOp) {
+      const int dataOpIdx = static_cast<int>(sdsc->dataOpdscs_.size());
+      sdsc->dataOpdscs_.push_back(ddsc);
+      dataOpIndices.push_back(dataOpIdx);
+    }
+    if (std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_ONE_IFN_PROBE") !=
+        nullptr) {
+      break;
+    }
+  }
+
+  if (useSingleIfnDataOp) {
+    const int dataOpIdx = static_cast<int>(sdsc->dataOpdscs_.size());
+    sdsc->dataOpdscs_.push_back(singleDdsc);
+    dataOpIndices.push_back(dataOpIdx);
+  }
+
+  const bool useCombinedSchedule =
+      std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_COMBINED_IFN") !=
+      nullptr;
+  const bool replaceDlScheduleStep =
+      std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_REPLACE_DL_STEP") !=
+      nullptr;
+  allocNode->allocateCoordinates_.coreIdToWkSlice_.clear();
+  for (const auto& coreAndSlice : sdsc->coreIdToWkSlice_) {
+    auto& schedule = sdsc->coreIdToDscSchedule[coreAndSlice.first];
+    auto insertPos = schedule.begin();
+    for (auto it = schedule.begin(); it != schedule.end(); ++it) {
+      if (it->dldsc_idx == 0) {
+        insertPos = it;
+        break;
+      }
+    }
+    if (useCombinedSchedule && replaceDlScheduleStep) {
+      DT_CHECK_MSG(dataOpIndices.size() == 1,
+                   "replacement IFN probe expects exactly one data op");
+      bool replaced = false;
+      for (auto it = schedule.begin(); it != schedule.end(); ++it) {
+        if (it->dldsc_idx == 0) {
+          it->datadsc_idx = dataOpIndices.front();
+          it->before_sync = false;
+          it->after_sync = true;
+          replaced = true;
+          break;
+        }
+      }
+      DT_CHECK_MSG(replaced, "failed to find DL schedule step to replace");
+      continue;
+    }
+    for (const auto dataOpIdx : dataOpIndices) {
+      const int dldscIdx = useCombinedSchedule ? 0 : -1;
+      insertPos = schedule.insert(insertPos,
+                                  DscScheduleStep(dataOpIdx, dldscIdx, false,
+                                                  true));
+      ++insertPos;
+    }
+  }
+  return true;
+}
