+json11::Json::object trimStartAddressCoreCorelet(const json11::Json& value,
+                                                 int coreCount) {
+  auto object = value.object_items();
+  auto attrs = object["dim_prop_attr"].array_items();
+  if (!attrs.empty()) {
+    auto coreAttr = attrs.at(0).object_items();
+    coreAttr["factor_"] = coreCount;
+    attrs.at(0) = coreAttr;
+    object["dim_prop_attr"] = attrs;
+  }
+
+  json11::Json::object data;
+  const auto oldData = object["data_"].object_items();
+  for (int core = 0; core < coreCount; ++core) {
+    const std::string key = "[" + std::to_string(core) + ", 0, 0]";
+    const auto it = oldData.find(key);
+    data[key] = it == oldData.end() ? json11::Json("131072") : it->second;
+  }
+  object["data_"] = data;
+  return object;
+}
