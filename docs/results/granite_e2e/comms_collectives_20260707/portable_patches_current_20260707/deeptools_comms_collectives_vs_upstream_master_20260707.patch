+static std::map<std::string, double> expandPieceToStickSize(
+    const LdsInfo& dataLds, std::map<std::string, double> dimToSize) {
+  for (const auto& dimAndStick : dataLds.dimToStickSize_) {
+    const auto sizeIt = dimToSize.find(dimAndStick.first);
+    if (sizeIt != dimToSize.end() && sizeIt->second < dimAndStick.second) {
+      sizeIt->second = dimAndStick.second;
+    }
+  }
+  return dimToSize;
+}
