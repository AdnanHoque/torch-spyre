+
+using CoreCoordinateMap =
+    std::map<std::uint64_t, std::map<std::string, std::int64_t>>;
+
+struct ExactGroupedCoreMaps {
+  std::vector<std::vector<std::uint64_t>> sourceCoresByGroup;
+  std::vector<std::vector<std::uint64_t>> destinationCoresByGroup;
+};
+
+CoreCoordinateMap parseCoreCoordinateMap(const Json &json) {
+  CoreCoordinateMap result;
+  if (!json.is_object()) return result;
+  for (const auto &[coreIdString, coordJson] : json.object_items()) {
+    if (!coordJson.is_object()) return {};
+    char *end = nullptr;
+    errno = 0;
+    const unsigned long parsedCore =
+        std::strtoul(coreIdString.c_str(), &end, 10);
+    if (errno != 0 || end == nullptr || *end != '\0') return {};
+    auto &coord = result[static_cast<std::uint64_t>(parsedCore)];
+    for (const auto &[dim, value] : coordJson.object_items()) {
+      if (!value.is_number()) return {};
+      coord[dim] = static_cast<std::int64_t>(value.number_value());
+    }
+  }
+  return result;
+}
+
+std::set<std::string> dimsInCoreCoordinateMap(const CoreCoordinateMap &coords) {
+  std::set<std::string> dims;
+  for (const auto &[_, coord] : coords) {
+    for (const auto &[dim, __] : coord) dims.insert(dim);
+  }
+  return dims;
+}
+
+
+std::uint64_t coordinateSplitCount(const CoreCoordinateMap &coords,
+                                   const std::string &dim) {
+  std::int64_t maxCoord = -1;
+  for (const auto &[_, coord] : coords) {
+    const auto it = coord.find(dim);
+    if (it == coord.end()) continue;
+    maxCoord = std::max(maxCoord, it->second);
+  }
+  return maxCoord < 0 ? 0 : static_cast<std::uint64_t>(maxCoord + 1);
+}
+
+bool coordinateIntervalsOverlap(std::int64_t sourceCoord,
+                                std::uint64_t sourceSplit,
+                                std::int64_t destCoord,
+                                std::uint64_t destSplit) {
+  if (sourceCoord < 0 || destCoord < 0 || sourceSplit == 0 ||
+      destSplit == 0) {
+    return false;
+  }
+  // Compare [source/sourceSplit, (source+1)/sourceSplit) with
+  // [dest/destSplit, (dest+1)/destSplit) without floating point.
+  return static_cast<std::uint64_t>(sourceCoord) * destSplit <
+             static_cast<std::uint64_t>(destCoord + 1) * sourceSplit &&
+         static_cast<std::uint64_t>(destCoord) * sourceSplit <
+             static_cast<std::uint64_t>(sourceCoord + 1) * destSplit;
+}
+
+bool coreCoordinateIntervalsOverlap(
+    const std::map<std::string, std::int64_t> &sourceCoord,
+    const std::map<std::string, std::int64_t> &destCoord,
+    const std::vector<std::string> &dims, const CoreCoordinateMap &sourceCoords,
+    const CoreCoordinateMap &destCoords) {
+  for (const auto &dim : dims) {
+    const auto sourceIt = sourceCoord.find(dim);
+    const auto destIt = destCoord.find(dim);
+    if (sourceIt == sourceCoord.end() || destIt == destCoord.end()) {
+      return false;
+    }
+    if (!coordinateIntervalsOverlap(sourceIt->second,
+                                    coordinateSplitCount(sourceCoords, dim),
+                                    destIt->second,
+                                    coordinateSplitCount(destCoords, dim))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::vector<std::string> commonCoordinateDims(const CoreCoordinateMap &lhs,
+                                             const CoreCoordinateMap &rhs) {
+  const auto lhsDims = dimsInCoreCoordinateMap(lhs);
+  const auto rhsDims = dimsInCoreCoordinateMap(rhs);
+  std::vector<std::string> common;
+  std::set_intersection(lhsDims.begin(), lhsDims.end(), rhsDims.begin(),
+                        rhsDims.end(), std::back_inserter(common));
+  return common;
+}
+
+std::string coordinateGroupKey(const std::map<std::string, std::int64_t> &coord,
+                               const std::vector<std::string> &dims) {
+  std::string key;
+  for (const auto &dim : dims) {
+    const auto it = coord.find(dim);
+    if (it == coord.end()) return "";
+    key += dim + "=" + std::to_string(it->second) + ";";
+  }
+  return key;
+}
+
+std::vector<std::string> sortedCoordinateDims(const CoreCoordinateMap &coords) {
+  std::vector<std::string> dims;
+  const auto dimSet = dimsInCoreCoordinateMap(coords);
+  dims.assign(dimSet.begin(), dimSet.end());
+  return dims;
+}
+
+std::vector<std::uint64_t> sortCoresByCoordinate(
+    std::vector<std::uint64_t> cores, const CoreCoordinateMap &coords) {
+  const auto dims = sortedCoordinateDims(coords);
+  std::sort(cores.begin(), cores.end(), [&](std::uint64_t lhs,
+                                            std::uint64_t rhs) {
+    const auto &lhsCoord = coords.at(lhs);
+    const auto &rhsCoord = coords.at(rhs);
+    for (const auto &dim : dims) {
+      const auto lhsIt = lhsCoord.find(dim);
+      const auto rhsIt = rhsCoord.find(dim);
+      const std::int64_t lhsValue = lhsIt == lhsCoord.end() ? 0 : lhsIt->second;
+      const std::int64_t rhsValue = rhsIt == rhsCoord.end() ? 0 : rhsIt->second;
+      if (lhsValue != rhsValue) return lhsValue < rhsValue;
+    }
+    return lhs < rhs;
+  });
+  return cores;
+}
+
+ExactGroupedCoreMaps deriveExactGroupedCoreMaps(const Json &json) {
+  const auto producerCoords =
+      parseCoreCoordinateMap(json["producer_core_id_to_device_slice"]);
+  const auto consumerCoords =
+      parseCoreCoordinateMap(json["consumer_core_id_to_device_slice"]);
+  if (producerCoords.empty() || consumerCoords.empty()) return {};
+
+  const auto commonDims = commonCoordinateDims(producerCoords, consumerCoords);
+  if (commonDims.empty()) return {};
+
+  std::map<std::string, std::vector<std::uint64_t>> destinationsByKey;
+  std::map<std::string, std::map<std::string, std::int64_t>> destCoordByKey;
+  for (const auto &[core, coord] : consumerCoords) {
+    const auto key = coordinateGroupKey(coord, commonDims);
+    if (key.empty()) return {};
+    destinationsByKey[key].push_back(core);
+    destCoordByKey.emplace(key, coord);
+  }
+
+  ExactGroupedCoreMaps grouped;
+  for (const auto &[key, destinations] : destinationsByKey) {
+    const auto destCoordIt = destCoordByKey.find(key);
+    if (destinations.empty() || destCoordIt == destCoordByKey.end()) return {};
+
+    std::vector<std::uint64_t> sources;
+    for (const auto &[core, coord] : producerCoords) {
+      if (coreCoordinateIntervalsOverlap(coord, destCoordIt->second, commonDims,
+                                         producerCoords, consumerCoords)) {
+        sources.push_back(core);
+      }
+    }
+    if (sources.empty()) return {};
+
+    grouped.sourceCoresByGroup.push_back(
+        sortCoresByCoordinate(sources, producerCoords));
+    grouped.destinationCoresByGroup.push_back(
+        sortCoresByCoordinate(destinations, consumerCoords));
+  }
+  return grouped;
+}
+
+bool matmulOperandBroadcastLogicalTransferExpansionIsSafe(
+    const deeptools::MatmulOperandBroadcastMovementPlan &plan,
+    std::uint64_t *expectedTransferCount, std::string *reason) {
+  constexpr std::uint64_t kMaxArtifactLogicalTransfers = 1000000;
+  *expectedTransferCount = 0;
+
+  if (!plan.ok) {
+    *reason = "plan is not ok";
+    return false;
+  }
+  if (plan.groupCount == 0 || plan.producerChunksPerGroup == 0 ||
+      plan.consumerReplicasPerGroup == 0) {
+    *reason = "plan has zero transfer dimensions";
+    return false;
+  }
+
+  if (!plan.sourceCoresByGroup.empty() ||
+      !plan.destinationCoresByGroup.empty()) {
+    if (plan.sourceCoresByGroup.empty() ||
+        plan.destinationCoresByGroup.empty() ||
+        plan.sourceCoresByGroup.size() != plan.destinationCoresByGroup.size()) {
+      *reason = "exact grouped core maps are incomplete";
+      return false;
+    }
+    for (std::size_t group = 0; group < plan.sourceCoresByGroup.size();
+         ++group) {
+      const auto &sourceCores = plan.sourceCoresByGroup[group];
+      const auto &destinationCores = plan.destinationCoresByGroup[group];
+      if (sourceCores.empty() || destinationCores.empty()) {
+        *reason = "exact grouped core maps contain an empty group";
+        return false;
+      }
+      if (!checkedAddProduct(sourceCores.size(), destinationCores.size(),
+                             expectedTransferCount)) {
+        *reason = "exact grouped core map transfer count overflows";
+        return false;
+      }
+    }
+  } else {
+    std::uint64_t groupTransferCount = 0;
+    if (!checkedMul(plan.producerChunksPerGroup,
+                    plan.consumerReplicasPerGroup, &groupTransferCount) ||
+        !checkedMul(plan.groupCount, groupTransferCount,
+                    expectedTransferCount)) {
+      *reason = "compact transfer count overflows";
+      return false;
+    }
+  }
+
+  if (*expectedTransferCount != plan.logicalTransferCount) {
+    *reason = "logical_transfer_count disagrees with transfer dimensions";
+    return false;
+  }
+  if (*expectedTransferCount > kMaxArtifactLogicalTransfers) {
+    *reason = "logical transfer expansion exceeds artifact limit";
+    return false;
+  }
+  return true;
+}
