+std::string matmulOperandBroadcastMovementPlanArtifactJson(
+    const MatmulOperandBroadcastMovementPlan &plan,
+    const std::map<std::string, std::string> &context) {
+  std::vector<Json> stages;
+  for (const auto &stage : plan.stages) stages.emplace_back(stage);
+  std::vector<Json> logicalTransfers;
+  std::uint64_t expectedTransferCount = 0;
+  std::string transferExpansionReason;
+  const bool expandLogicalTransfers =
+      matmulOperandBroadcastLogicalTransferExpansionIsSafe(
+          plan, &expectedTransferCount, &transferExpansionReason);
+  if (expandLogicalTransfers) {
+    for (const auto &transfer : matmulOperandBroadcastLogicalTransfers(plan)) {
+      logicalTransfers.emplace_back(logicalTransferToJson(
+          {transfer.group, transfer.producerChunk, transfer.consumerReplica,
+           transfer.sourceCore, transfer.destinationCore}));
+    }
+  }
+
+  Json::object artifact;
+  artifact["artifact_kind"] = "matmul_operand_broadcast_backend_plan";
+  for (const auto &[key, value] : context) {
+    artifact[key] = metadataValueToJson(value);
+  }
+  artifact["kind"] = plan.kind;
+  artifact["communication_pattern"] = plan.communicationPattern;
+  if (!plan.materializationPattern.empty()) {
+    artifact["materialization_pattern"] = plan.materializationPattern;
+  }
+  artifact["realization_strategy"] = plan.realizationStrategy;
+  artifact["consumer_operand_ds_type"] = plan.consumerOperandDsType;
+  artifact["requires_layout_conversion"] = plan.requiresLayoutConversion;
+  if (!plan.layoutTransformJson.empty()) {
+    artifact["layout_transform"] = metadataValueToJson(plan.layoutTransformJson);
+  }
+  if (!plan.sourceLxTensorJson.empty()) {
+    artifact["source_lx_tensor"] =
+        metadataValueToJson(plan.sourceLxTensorJson);
+  }
+  if (!plan.targetKernelTensorJson.empty()) {
+    artifact["target_kernel_tensor"] =
+        metadataValueToJson(plan.targetKernelTensorJson);
+  }
+  if (!plan.stagedDestinationJson.empty()) {
+    artifact["staged_destination"] =
+        metadataValueToJson(plan.stagedDestinationJson);
+  }
+  artifact["realized"] = plan.realized;
+  artifact["operand_index"] = std::to_string(plan.operandIndex);
+  artifact["source_core_count"] = std::to_string(plan.sourceCoreCount);
+  artifact["consumer_core_count"] = std::to_string(plan.consumerCoreCount);
+  artifact["group_count"] = std::to_string(plan.groupCount);
+  artifact["producer_chunks_per_group"] =
+      std::to_string(plan.producerChunksPerGroup);
+  artifact["consumer_replicas_per_group"] =
+      std::to_string(plan.consumerReplicasPerGroup);
+  artifact["replication_factor"] = std::to_string(plan.replicationFactor);
+  artifact["logical_transfer_count"] =
+      std::to_string(plan.logicalTransferCount);
+  artifact["estimated_tensor_bytes"] =
+      std::to_string(plan.estimatedTensorBytes);
+  artifact["stages"] = stages;
+  artifact["logical_transfer_expansion_status"] =
+      expandLogicalTransfers ? "expanded" : "skipped";
+  if (!transferExpansionReason.empty()) {
+    artifact["logical_transfer_expansion_reason"] = transferExpansionReason;
+  }
+  artifact["logical_transfers"] = logicalTransfers;
+  return Json(artifact).dump();
+}
