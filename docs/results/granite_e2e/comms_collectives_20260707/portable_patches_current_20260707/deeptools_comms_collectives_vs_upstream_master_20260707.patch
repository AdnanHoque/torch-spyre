+static bool matmulOperandGatherRestickifyEnabled() {
+  return lxPlannerRelayoutEnabled() ||
+         envFlagEnabled("DEEPTOOLS_ENABLE_MATMUL_OPERAND_GATHER_RESTICKIFY");
+}
+
+static bool shouldUseMatmulOperandGatherRestickify(
+    const MatmulOperandBroadcastHookPlan& hook) {
+  if (!matmulOperandGatherRestickifyEnabled() ||
+      !hook.plan.requiresLayoutConversion) {
+    return false;
+  }
+  if (hook.plan.communicationPattern == "all_gather_replicate") {
+    return true;
+  }
+  return hook.plan.realizationStrategy == "gather_then_restickify" &&
+         (hook.plan.communicationPattern == "broadcast" ||
+          hook.plan.communicationPattern == "multicast");
+}
+
+static bool layoutAllgatherRestickifyEnabled() {
+  return lxPlannerRelayoutEnabled() ||
+         envFlagEnabled("DEEPTOOLS_ENABLE_UNSAFE_LAYOUT_ALLGATHER_RESTICKIFY");
+}
+
+static bool matmulOperandBroadcastKernelNeighborEnabled() {
+  return envFlagEnabled("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_KERNEL_NEIGHBOR");
+}
+
+static bool hasLargeMatmulOperandAllGather(const SuperDsc* sdsc) {
+  if (sdsc == nullptr) return false;
+  constexpr std::uint64_t kMinLoopScopedProducerChunksPerGroup = 64;
+
+  for (const auto& entry : sdsc->lxRelayoutClassifications_) {
+    const auto& fields = entry.second;
+    const auto kindIt = fields.find("kind");
+    const auto patternIt = fields.find("communication_pattern");
+    const bool isMatmulOperandBroadcast =
+        (kindIt != fields.end() &&
+         kindIt->second == "matmul_operand_broadcast") ||
+        (patternIt != fields.end() &&
+         (patternIt->second == "all_gather_replicate" ||
+          patternIt->second == "broadcast" ||
+          patternIt->second == "multicast"));
+    if (!isMatmulOperandBroadcast) continue;
+
+    const auto plan =
+        deeptools::synthesizeMatmulOperandBroadcastMovementPlan(fields);
+    if (plan.ok && plan.communicationPattern == "all_gather_replicate" &&
+        plan.producerChunksPerGroup >= kMinLoopScopedProducerChunksPerGroup) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static bool shouldUseLoopScopedMatmulOperandFetch(
+    const SuperDsc* sdsc, const MatmulOperandBroadcastHookPlan& hook) {
+  if (matmulOperandBroadcastKernelNeighborEnabled()) return true;
+  if (!lxPlannerRelayoutEnabled()) return false;
+  if (hook.plan.communicationPattern != "all_gather_replicate") return false;
+
+  constexpr std::uint64_t kMinLoopScopedProducerChunksPerGroup = 64;
+  return hook.plan.producerChunksPerGroup >=
+             kMinLoopScopedProducerChunksPerGroup ||
+         hasLargeMatmulOperandAllGather(sdsc);
+}
