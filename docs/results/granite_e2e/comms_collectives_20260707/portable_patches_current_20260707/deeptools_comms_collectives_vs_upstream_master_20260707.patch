+  const int producerCoreCount = isMulticast ? 2 : 1;
+  const int consumerCoreCount = isMulticast ? 4 : 2;
+  const int groupCount = isMulticast ? 2 : 1;
+  const int replicasPerGroup = consumerCoreCount / groupCount;
+  const int xExtent = 1;
+  const int outExtent = isMulticast ? 64 * groupCount : 64;
+  const auto consumerComputeMap =
+      isMulticast ? makeMulticastConsumerComputeMap(consumerCoreCount,
+                                                    groupCount)
+                  : makeConsumerComputeMap(consumerCoreCount, groupCount);
+  const auto targetKernelMap =
+      isMulticast ? makeMulticastTargetKernelMap(consumerCoreCount, groupCount)
+                  : makeTargetKernelMap(consumerCoreCount, groupCount);
+  const auto sourceLxMap =
+      isMulticast ? makeMulticastSourceLxMap(producerCoreCount, groupCount)
+                  : makeSourceLxMap(producerCoreCount, groupCount);
+
+  auto top = json.object_items();
+  const auto sdscName = top.begin()->first;
+  auto sdsc = top.begin()->second.object_items();
+  sdsc["numCoresUsed_"] = consumerCoreCount;
+  sdsc["coreFoldProp_"] =
+      json11::Json::object{{"factor_", consumerCoreCount}, {"label_", "core"}};
+  sdsc["N_"] = shrinkBatchMatmulShape(sdsc["N_"], xExtent, outExtent);
+  sdsc["unpadN_"] =
+      shrinkBatchMatmulShape(sdsc["unpadN_"], xExtent, outExtent);
+  sdsc["numWkSlicesPerDim_"] = json11::Json::object{
+      {"x", 1}, {"mb", 1}, {"out", groupCount}, {"in", 1}};
+  sdsc["coreIdToWkSlice_"] = consumerComputeMap;
+  sdsc["coreIdToDsc_"] = makeCoreIdToDscMap(consumerCoreCount);
+  sdsc["coreIdToDscSchedule"] = makeSingleDscSchedule(consumerCoreCount);
+
+  auto dscs = sdsc["dscs_"].array_items();
+  ASSERT_EQ(dscs.size(), 1u);
+  auto dscEntry = dscs.at(0).object_items();
+  ASSERT_EQ(dscEntry.size(), 1u);
+  const auto dscName = dscEntry.begin()->first;
+  auto dsc = dscEntry.begin()->second.object_items();
+  dsc["numCoresUsed_"] = consumerCoreCount;
+  dsc["N_"] = shrinkBatchMatmulShape(dsc["N_"], xExtent, outExtent);
+  dsc["unpadN_"] = shrinkBatchMatmulShape(dsc["unpadN_"], xExtent, outExtent);
+  dsc["dataStageParam_"] =
+      shrinkBatchMatmulDataStageParam(dsc["dataStageParam_"], xExtent,
+                                      outExtent);
+  dsc["coreIdsUsed_"] = makeCoreIds(consumerCoreCount);
+  auto scheduleTree = dsc["scheduleTree_"].array_items();
+  for (auto& node : scheduleTree) {
+    auto nodeObj = node.object_items();
+    if (nodeObj["startAddressCoreCorelet_"].is_object()) {
+      nodeObj["startAddressCoreCorelet_"] =
+          trimStartAddressCoreCorelet(nodeObj["startAddressCoreCorelet_"],
+                                      consumerCoreCount);
+    }
+    if (nodeObj["ldsIdx_"].int_value() == 1 &&
+        nodeObj["component_"].string_value() == "lx") {
+      auto coords = nodeObj["coordinates_"].object_items();
+      coords["coreIdToWkSlice_"] = targetKernelMap;
+      nodeObj["coordinates_"] = coords;
+    }
+    node = nodeObj;
+  }
+  dsc["scheduleTree_"] = scheduleTree;
+  dscs.at(0) = json11::Json::object{{dscName, dsc}};
+  sdsc["dscs_"] = dscs;
+
+  auto classifications = sdsc["lxRelayoutClassifications_"].array_items();
+  ASSERT_FALSE(classifications.empty());
+  auto classification = classifications.at(0).object_items();
+  classification["communication_class"] = pattern;
+  classification["communication_pattern"] = pattern;
+  classification["realization_strategy"] = "gather_then_restickify";
+  classification["producer_core_count"] = producerCoreCount;
+  classification["consumer_core_count"] = consumerCoreCount;
+  classification["producer_work_slice_dims"] =
+      json11::Json::object{{"group", producerCoreCount}};
+  classification["consumer_work_slice_dims"] =
+      json11::Json::object{{"group", consumerCoreCount}};
+  classification["consumer_tensor_work_slice_dims"] =
+      json11::Json::object{{"group", groupCount}};
+  classification["consumer_compute_work_slice_dims"] =
+      json11::Json::object{{"group", consumerCoreCount}};
+  classification["group_count"] = groupCount;
+  classification["broadcast_group_count"] = groupCount;
+  classification["replication_factor"] = replicasPerGroup;
+  classification["max_fanout"] = replicasPerGroup;
+  classification["max_fanin"] = 1;
+  classification["transfer_count"] = consumerCoreCount;
+  classification["producer_core_id_to_device_slice"] =
+      makeGroupedMap(producerCoreCount, groupCount);
+  classification["consumer_core_id_to_device_slice"] =
+      makeGroupedMap(consumerCoreCount, groupCount);
+
+  auto layoutTransform = classification["layout_transform"].object_items();
+  layoutTransform["movement_stage"] = pattern;
+  classification["layout_transform"] = layoutTransform;
+
+  auto sourceTensor = classification["source_lx_tensor"].object_items();
+  ASSERT_FALSE(sourceTensor.empty());
+  sourceTensor["numWkSlicesPerDim_"] =
+      json11::Json::object{{"mb", 1}, {"x", groupCount}, {"out", 1}};
+  sourceTensor["coreIdToWkSlice_"] = sourceLxMap;
+  sourceTensor["computeCoreIdToWkSlice_"] = sourceLxMap;
+  sourceTensor["coordinateInfo_"] = shrinkCoordinateInfoExtents(
+      sourceTensor["coordinateInfo_"],
+      {{"x", outExtent}, {"out", 64}, {"mb", 1}});
+  sourceTensor["startAddressCoreCorelet_"] = trimStartAddressCoreCorelet(
+      sourceTensor["startAddressCoreCorelet_"], producerCoreCount);
+  classification["source_lx_tensor"] = sourceTensor;
+
+  auto targetTensor = classification["target_kernel_tensor"].object_items();
+  ASSERT_FALSE(targetTensor.empty());
+  targetTensor["numWkSlicesPerDim_"] = json11::Json::object{
+      {"x", 1}, {"mb", 1}, {"out", groupCount}, {"in", 1}};
+  targetTensor["coreIdToWkSlice_"] = targetKernelMap;
+  targetTensor["computeCoreIdToWkSlice_"] = consumerComputeMap;
+  targetTensor["coordinateInfo_"] = shrinkCoordinateInfoExtents(
+      targetTensor["coordinateInfo_"],
+      {{"out", outExtent}, {"in", 64}, {"x", 1}});
+  targetTensor["startAddressCoreCorelet_"] = trimStartAddressCoreCorelet(
+      targetTensor["startAddressCoreCorelet_"], consumerCoreCount);
+  classification["target_kernel_tensor"] = targetTensor;
+
+  classifications.at(0) = classification;
+  sdsc["lxRelayoutClassifications_"] = classifications;
+  top[sdscName] = sdsc;
+
+  std::ofstream jsonOut(path);
+  jsonOut << json11::Json(top).dump() << std::endl;
+}
