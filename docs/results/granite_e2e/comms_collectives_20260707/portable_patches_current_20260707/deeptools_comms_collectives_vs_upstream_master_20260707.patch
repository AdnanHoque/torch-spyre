+bool hasScheduledDataAndDlOp(const SuperDsc& sdsc) {
+  if (sdsc.dscs_.empty() || sdsc.dataOpdscs_.empty() ||
+      sdsc.coreIdToDscSchedule.empty()) {
+    return false;
+  }
+
+  bool hasDataStep = false;
+  bool hasDlStep = false;
+  for (const auto& kv : sdsc.coreIdToDscSchedule) {
+    if (kv.second.empty()) {
+      return false;
+    }
+    for (const auto& step : kv.second) {
+      if (step.datadsc_idx >= 0) {
+        DT_CHECK(step.datadsc_idx < sdsc.dataOpdscs_.size());
+        hasDataStep = true;
+      }
+      if (step.dldsc_idx >= 0) {
+        DT_CHECK(step.dldsc_idx < sdsc.dscs_.size());
+        hasDlStep = true;
+      }
+    }
+  }
+
+  return hasDataStep && hasDlStep;
+}
