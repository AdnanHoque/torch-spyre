+static int tensorContractSplitForDim(
+    const json11::Json& tensorJson, const std::string& dim,
+    const std::map<std::string, std::set<int>>& sliceIds) {
+  const auto splitJson = tensorJson["numWkSlicesPerDim_"][dim];
+  if (!splitJson.is_null()) {
+    return static_cast<int>(jsonNumberOrString(splitJson, 1));
+  }
+  const auto splitIt = sliceIds.find(dim);
+  return splitIt == sliceIds.end()
+             ? 1
+             : static_cast<int>(splitIt->second.size());
+}
