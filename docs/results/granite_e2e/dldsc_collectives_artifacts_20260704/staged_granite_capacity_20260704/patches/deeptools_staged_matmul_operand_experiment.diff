+static bool parseMetadataJsonObject(
+    const std::map<std::string, std::string>& fields, const std::string& key,
+    json11::Json* parsed, std::string* reason) {
+  const auto fieldIt = fields.find(key);
+  if (fieldIt == fields.end()) {
+    *reason = "missing " + key;
+    return false;
+  }
+  std::string parseError;
+  *parsed = json11::Json::parse(fieldIt->second, parseError);
+  if (!parseError.empty() || !parsed->is_object()) {
+    *reason = "invalid JSON object in " + key;
+    return false;
+  }
+  return true;
+}
+
+static std::vector<std::string> jsonStringArray(const json11::Json& object,
+                                                const std::string& key) {
+  std::vector<std::string> result;
+  for (const auto& value : object[key].array_items()) {
+    result.push_back(value.string_value());
+  }
+  return result;
+}
+
+static int64_t jsonIntValue(const json11::Json& value) {
+  if (value.is_number()) return static_cast<int64_t>(value.number_value());
+  if (value.is_string()) return std::atoll(value.string_value().c_str());
+  return 0;
+}
+
+static std::map<std::string, int64_t> tensorDimExtentsFromCoordinateInfo(
+    const json11::Json& tensorJson) {
+  std::map<std::string, int64_t> result;
+  for (const auto& dim : jsonStringArray(tensorJson, "layoutDimOrder_")) {
+    int64_t extent = 1;
+    for (const auto& prop :
+         tensorJson["coordinateInfo_"][dim]["folds"]["dim_prop_attr"]
+             .array_items()) {
+      const auto factor = jsonIntValue(prop["factor_"]);
+      if (factor > 0) extent *= factor;
+    }
+    result[dim] = extent;
+  }
+  return result;
+}
+
+static std::map<std::string, int64_t> tensorNumWkSlices(
+    const json11::Json& tensorJson) {
+  std::map<std::string, int64_t> result;
+  for (const auto& [dim, value] :
+       tensorJson["numWkSlicesPerDim_"].object_items()) {
+    result[dim] = jsonIntValue(value);
+  }
+  return result;
+}
+
+static CoreDeviceSliceMap tensorCoreIdToSlice(
+    const json11::Json& tensorJson,
+    const std::string& key = "coreIdToWkSlice_") {
+  CoreDeviceSliceMap result;
+  for (const auto& [coreIdString, sliceJson] :
+       tensorJson[key].object_items()) {
+    char* end = nullptr;
+    const long coreId = std::strtol(coreIdString.c_str(), &end, 10);
+    if (end == nullptr || *end != '\0' || coreId < 0 ||
+        !sliceJson.is_object()) {
+      return {};
+    }
+    auto& slice = result[static_cast<int>(coreId)];
+    for (const auto& [dim, value] : sliceJson.object_items()) {
+      slice[dim] = static_cast<CoordinateBaseType>(jsonIntValue(value));
+    }
+  }
+  return result;
+}
+
+static std::map<int, int64_t> tensorCoreStartAddresses(
+    const json11::Json& tensorJson) {
+  std::map<int, int64_t> result;
+  for (const auto& [coordString, value] :
+       tensorJson["startAddressCoreCorelet_"]["data_"].object_items()) {
+    const auto comma = coordString.find(',');
+    if (coordString.size() < 2 || coordString.front() != '[' ||
+        comma == std::string::npos) {
+      continue;
+    }
+    const int coreId = std::atoi(coordString.substr(1, comma - 1).c_str());
+    result[coreId] = jsonIntValue(value);
+  }
+  return result;
+}
+
+static bool populateMatmulOperandBroadcastStickRingTransfers(
+    const std::map<std::string, std::string>& fields,
+    const dsc2::AllocateNode& destinationAlloc,
+    const std::vector<deeptools::MatmulOperandBroadcastLogicalTransfer>&
+        logicalTransfers,
+    dsc2::TransferNode* transNode, std::string* reason) {
+  json11::Json sourceTensor;
+  json11::Json targetTensor;
+  if (!parseMetadataJsonObject(fields, "source_lx_tensor", &sourceTensor,
+                               reason) ||
+      !parseMetadataJsonObject(fields, "target_kernel_tensor", &targetTensor,
+                               reason)) {
+    return false;
+  }
+
+  const auto sourceDims = jsonStringArray(sourceTensor, "layoutDimOrder_");
+  const auto targetDims = jsonStringArray(targetTensor, "layoutDimOrder_");
+  const auto stickDims = jsonStringArray(targetTensor, "stickDimOrder_");
+  if (sourceDims.size() != 2 || targetDims.size() != 2 ||
+      stickDims.size() != 1) {
+    *reason = "stick ring transfer prototype only supports 2-D out-stick tensors";
+    return false;
+  }
+  const std::string sourceRowDim = sourceDims.at(0);
+  const std::string sourceOutDim = sourceDims.at(1);
+  const std::string targetRowDim = targetDims.at(0);
+  const std::string targetOutDim = targetDims.at(1);
+  if (stickDims.at(0) != targetOutDim) {
+    *reason = "target KERNEL stick dim must be the output dimension";
+    return false;
+  }
+  json11::Json operandKernelLayout;
+  std::string ignoredKernelLayoutReason;
+  const bool hasOperandKernelLayout = parseMetadataJsonObject(
+      fields, "operand_kernel_layout", &operandKernelLayout,
+      &ignoredKernelLayoutReason);
+  const auto operandKernelDims =
+      hasOperandKernelLayout
+          ? jsonStringArray(operandKernelLayout, "layoutDimOrder_")
+          : std::vector<std::string>{};
+  const bool targetUsesOutMajorKernelLayout =
+      operandKernelDims.size() >= 2 && operandKernelDims.at(0) == targetOutDim &&
+      operandKernelDims.at(1) == targetRowDim;
+  const bool targetUsesOutInXKernelLayout =
+      targetUsesOutMajorKernelLayout && operandKernelDims.size() >= 3 &&
+      operandKernelDims.at(2) == "x";
+
+  const auto sourceExtents = tensorDimExtentsFromCoordinateInfo(sourceTensor);
+  const auto targetExtents = tensorDimExtentsFromCoordinateInfo(targetTensor);
+  const auto sourceSplits = tensorNumWkSlices(sourceTensor);
+  const auto targetSplits = tensorNumWkSlices(targetTensor);
+  const auto sourceSlices = tensorCoreIdToSlice(sourceTensor);
+  const auto targetComputeSlices =
+      tensorCoreIdToSlice(targetTensor, "computeCoreIdToWkSlice_");
+  const auto sourceStarts = tensorCoreStartAddresses(sourceTensor);
+  if (sourceExtents.empty() || targetExtents.empty() ||
+      sourceSplits.empty() || sourceSlices.empty() || sourceStarts.empty()) {
+    *reason = "incomplete source/target tensor coordinate metadata";
+    return false;
+  }
+
+  constexpr int64_t kBytesPerStick = 128;
+  const int64_t wordLength = jsonIntValue(targetTensor["wordLength"]);
+  const int64_t stickElems =
+      jsonIntValue(targetTensor["stickSize_"].array_items().at(0));
+  if (wordLength <= 0 || stickElems <= 0 ||
+      stickElems * wordLength != kBytesPerStick) {
+    *reason = "matmul operand stick transfers must be 128-byte aligned";
+    return false;
+  }
+
+  const int64_t rowExtent = targetExtents.at(targetRowDim);
+  const int64_t targetOutExtent = targetExtents.at(targetOutDim);
+  const int64_t sourceOutExtent = sourceExtents.at(sourceOutDim);
+  const int64_t sourceOutSplit = sourceSplits.count(sourceOutDim)
+                                     ? sourceSplits.at(sourceOutDim)
+                                     : 1;
+  if (rowExtent <= 0 || targetOutExtent <= 0 || sourceOutExtent <= 0 ||
+      sourceOutSplit <= 0 || targetOutExtent % stickElems != 0 ||
+      sourceOutExtent % sourceOutSplit != 0) {
+    *reason = "invalid matmul operand broadcast tensor extents";
+    return false;
+  }
+
+  const int64_t sourceOutShardExtent = sourceOutExtent / sourceOutSplit;
+  if (sourceOutShardExtent % stickElems != 0) {
+    *reason = "source out shard must be stick aligned";
+    return false;
+  }
+  const int64_t sourceLocalOutSticks = sourceOutShardExtent / stickElems;
+  const int64_t targetOutSticks = targetOutExtent / stickElems;
+  if (targetUsesOutInXKernelLayout && targetComputeSlices.empty()) {
+    *reason = "missing target x/mb compute slices for KERNEL layout";
+    return false;
+  }
+
+  transNode->lxNeighborRingTransfers_.clear();
+  transNode->lxNeighborRingTransfers_.reserve(
+      logicalTransfers.size() * rowExtent * sourceLocalOutSticks);
+
+  std::cerr << "[matmul_operand_stick_transfer] logicalTransfers="
+            << logicalTransfers.size() << " rowExtent=" << rowExtent
+            << " sourceLocalOutSticks=" << sourceLocalOutSticks
+            << " targetOutSticks=" << targetOutSticks << "\n";
+
+  if (sourceOutSplit != static_cast<int64_t>(sourceStarts.size())) {
+    *reason = "neighbor-carousel prototype requires one source chunk per core";
+    return false;
+  }
+
+  const bool forceRowMajorTargetAddress =
+      std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_FORCE_ROW_MAJOR") !=
+      nullptr;
+  auto targetAddress = [&](int core, int64_t chunk, int64_t row,
+                           int64_t localStick) {
+    const int64_t destinationBase =
+        destinationAlloc.startAddressCoreCorelet_.getData(core, 0, 0);
+    if (destinationBase < 0) {
+      return static_cast<int64_t>(-1);
+    }
+    const int64_t globalStickBase = chunk * sourceLocalOutSticks;
+    int64_t destinationStickIndex = 0;
+    destinationStickIndex =
+        (!forceRowMajorTargetAddress && targetUsesOutMajorKernelLayout)
+            ? ((globalStickBase + localStick) * rowExtent + row)
+            : (row * targetOutSticks + globalStickBase + localStick);
+    return destinationBase + destinationStickIndex * kBytesPerStick;
+  };
+
+  for (int64_t phase = 1; phase <= sourceOutSplit; ++phase) {
+    for (int64_t sourceCore = 0; sourceCore < sourceOutSplit; ++sourceCore) {
+      const int64_t destinationCore = (sourceCore + 1) % sourceOutSplit;
+      const int64_t producerChunk =
+          (sourceCore - (phase - 1) + sourceOutSplit) % sourceOutSplit;
+      const auto sourceStartIt =
+          sourceStarts.find(static_cast<int>(producerChunk));
+      if (sourceStartIt == sourceStarts.end()) {
+        *reason = "missing source core start address for carousel chunk";
+        return false;
+      }
+      for (int64_t row = 0; row < rowExtent; ++row) {
+        for (int64_t localStick = 0; localStick < sourceLocalOutSticks;
+             ++localStick) {
+          dsc2::TransferNode::LxNeighborRingTransfer physicalTransfer;
+          physicalTransfer.sourceCoreId_ = static_cast<int>(sourceCore);
+          physicalTransfer.destinationCoreId_ =
+              static_cast<int>(destinationCore);
+          if (phase == 1) {
+            physicalTransfer.sourceStartAddress_ =
+                sourceStartIt->second +
+                (row * sourceLocalOutSticks + localStick) * kBytesPerStick;
+          } else {
+            physicalTransfer.sourceStartAddress_ =
+                targetAddress(static_cast<int>(sourceCore), producerChunk, row,
+                              localStick);
+          }
+          physicalTransfer.destinationStartAddress_ =
+              targetAddress(static_cast<int>(destinationCore), producerChunk,
+                            row, localStick);
+          if (physicalTransfer.sourceStartAddress_ < 0 ||
+              physicalTransfer.destinationStartAddress_ < 0) {
+            *reason = "invalid carousel LX address";
+            return false;
+          }
+          physicalTransfer.byteCount_ = kBytesPerStick;
+          physicalTransfer.group_ = phase;
+          physicalTransfer.producerChunk_ = producerChunk;
+          physicalTransfer.consumerReplica_ = destinationCore;
+          transNode->lxNeighborRingTransfers_.push_back(physicalTransfer);
+          if (transNode->lxNeighborRingTransfers_.size() <= 8 ||
+              (row >= 7 && row <= 9 && localStick == 0)) {
+            std::cerr << "[matmul_operand_stick_transfer] phase=" << phase
+                      << " chunk=" << producerChunk
+                      << " row=" << row
+                      << " stick=" << localStick
+                      << " srcCore=" << physicalTransfer.sourceCoreId_
+                      << " dstCore=" << physicalTransfer.destinationCoreId_
+                      << " srcAddr=" << physicalTransfer.sourceStartAddress_
+                      << " dstAddr="
+                      << physicalTransfer.destinationStartAddress_
+                      << " bytes=" << physicalTransfer.byteCount_ << "\n";
+          }
+        }
+      }
+    }
+  }
+  return true;
+}
