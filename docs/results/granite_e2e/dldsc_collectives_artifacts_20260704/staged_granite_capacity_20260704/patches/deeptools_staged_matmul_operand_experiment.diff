+      const auto& second = transfers.at(relevantTransfers.at(runEnd));
+      if (second.sourceCoreId_ == first.sourceCoreId_ &&
+          second.destinationCoreId_ == first.destinationCoreId_ &&
+          second.byteCount_ == first.byteCount_ &&
+          second.group_ == first.group_ &&
+          second.producerChunk_ == first.producerChunk_ &&
+          second.consumerReplica_ == first.consumerReplica_) {
+        sourceStride = second.sourceStartAddress_ - first.sourceStartAddress_;
+        destinationStride =
+            second.destinationStartAddress_ - first.destinationStartAddress_;
+        ++runEnd;
+        while (runEnd < relevantTransfers.size() &&
+               isSameRun(first, transfers.at(relevantTransfers.at(runEnd - 1)),
+                         transfers.at(relevantTransfers.at(runEnd)),
+                         sourceStride, destinationStride)) {
+          ++runEnd;
+        }
+      }
+    }
+    if (runEnd - transferIndex > maxRunLength) {
+      runEnd = transferIndex + maxRunLength;
+    }
+
+
+    const size_t runLength = runEnd - transferIndex;
+    const bool isSend = isSendTransfer(first);
+    std::cerr << "[lx_neighbor_pcfg_dsc2] emit "
+              << (isSend ? "send" : "recv") << " core=" << coreId
+              << " src=" << first.sourceCoreId_
+              << " dst=" << first.destinationCoreId_
+              << " bytes=" << first.byteCount_ << " run=" << runLength
+              << " group=" << first.group_
+              << " phase=" << ringPhase(first)
+              << " srcStride=" << sourceStride
+              << " dstStride=" << destinationStride << "\n";
+
+    auto* ringNode = static_cast<SenPcfgRingDtNode*>(
+        pcfg.createPcfgNode(SenPcfgNode::Type::RINGDATATRANSFER));
+    const std::string endName =
