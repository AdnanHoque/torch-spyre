+static bool buildLxNeighborRingTransfers(
+    DscPcfgTranslator::TranslatorGlobals& globals,
+    DscPcfgTranslator::PcfgInfo& pcfgInfo,
+    const dsc2::TransferNode* treeNode) {
+  if (treeNode->lxNeighborRingTransfers_.empty()) {
+    return false;
+  }
+
+  auto& pcfg = pcfgInfo.pcfg;
+  const int coreId = pcfgInfo.c;
+  const SenComponents genComp = pcfgInfo.genComp;
+  auto& scopeStack = globals.scopeStack;
+  auto& nameMap = globals.nameMap;
+  const auto& dsc = globals.dsc;
+
+  if (genComp != SenComponents::L3LU && genComp != SenComponents::L3SU) {
+    return false;
+  }
+
+  DT_CHECK_MSG(treeNode->isDstLabeledDs(),
+               "Expect LX-neighbor transfer to target a labeled DS.");
+  const int dstLdsIdx = treeNode->dstLdsAndLoopOffsets_.front().myLdsIdx_;
+  DT_CHECK_MSG(dstLdsIdx >= 0 && dstLdsIdx < dsc.labeledDs_.size(),
+               "Invalid LX-neighbor destination labeled DS.");
+  const auto& dstLds = dsc.labeledDs_.at(dstLdsIdx);
+  const auto dimLayoutOrder = getLxNeighborRingLayoutOrder(dsc, dstLds);
+
+  std::cerr << "[lx_neighbor_pcfg_dsc2] node=" << treeNode->name_
+            << " transfers=" << treeNode->lxNeighborRingTransfers_.size()
+            << " core=" << coreId
+            << " unit=" << EnumsConversion::senComponentsToString.at(genComp)
+            << "\n";
+
+  constexpr int64_t kBytesPerStick = 128;
+  const auto& transfers = treeNode->lxNeighborRingTransfers_;
+  size_t maxRunLength = transfers.size();
+  if (const char* maxRunEnv =
+          std::getenv("DEEPTOOLS_LX_NEIGHBOR_MAX_RUN")) {
+    const int parsedMaxRun = std::atoi(maxRunEnv);
+    if (parsedMaxRun > 0) maxRunLength = static_cast<size_t>(parsedMaxRun);
+  }
+
+
+  auto isRelevantTransfer = [&](const auto& transfer) {
+    if (transfer.sourceCoreId_ == transfer.destinationCoreId_) {
+      return false;
+    }
+    const bool isSend =
+        genComp == SenComponents::L3SU && transfer.sourceCoreId_ == coreId;
+    const bool isReceive = genComp == SenComponents::L3LU &&
+                           transfer.destinationCoreId_ == coreId;
+    return isSend || isReceive;
+  };
+
+  auto isSendTransfer = [&](const auto& transfer) {
+    return genComp == SenComponents::L3SU && transfer.sourceCoreId_ == coreId;
+  };
+
+  auto isSameRun = [](const auto& first, const auto& previous,
+                      const auto& current, int64_t sourceStride,
+                      int64_t destinationStride) {
+    return current.sourceCoreId_ == first.sourceCoreId_ &&
+           current.destinationCoreId_ == first.destinationCoreId_ &&
+           current.byteCount_ == first.byteCount_ &&
+           current.group_ == first.group_ &&
+           current.producerChunk_ == first.producerChunk_ &&
+           current.consumerReplica_ == first.consumerReplica_ &&
+           current.sourceStartAddress_ - previous.sourceStartAddress_ ==
+               sourceStride &&
+           current.destinationStartAddress_ -
+                   previous.destinationStartAddress_ ==
+               destinationStride;
+  };
+
+  auto validateTransfer = [](const auto& transfer) {
+    DT_CHECK_MSG(transfer.byteCount_ > 0,
+                 "Invalid LX-neighbor ring transfer byte count.");
+    DT_CHECK_MSG(transfer.byteCount_ % kBytesPerStick == 0,
+                 "LX-neighbor ring transfers must be stick aligned.");
+  };
+
+  int64_t ringCoreCount = 0;
+  for (const auto& transfer : transfers) {
+    ringCoreCount =
+        std::max(ringCoreCount, static_cast<int64_t>(transfer.sourceCoreId_ + 1));
+    ringCoreCount = std::max(
+        ringCoreCount, static_cast<int64_t>(transfer.destinationCoreId_ + 1));
+  }
+  DT_CHECK_MSG(ringCoreCount > 0,
+               "LX-neighbor ring transfer list must name at least one core.");
+
+  auto ringPhase = [&](const auto& transfer) {
+    int64_t phase =
+        (static_cast<int64_t>(transfer.destinationCoreId_) -
+         static_cast<int64_t>(transfer.sourceCoreId_) + ringCoreCount) %
+        ringCoreCount;
+    if (phase == 0) {
+      phase = ringCoreCount;
+    }
+    return phase;
+  };
+
+  std::vector<size_t> relevantTransfers;
+  relevantTransfers.reserve(transfers.size());
+  for (size_t idx = 0; idx < transfers.size(); ++idx) {
+    if (isRelevantTransfer(transfers.at(idx))) {
+      validateTransfer(transfers.at(idx));
+      relevantTransfers.push_back(idx);
+    }
+  }
+  std::stable_sort(relevantTransfers.begin(), relevantTransfers.end(),
+                   [&](size_t lhs, size_t rhs) {
+                     const auto& lhsTransfer = transfers.at(lhs);
+                     const auto& rhsTransfer = transfers.at(rhs);
+                     if (lhsTransfer.group_ != rhsTransfer.group_) {
+                       return lhsTransfer.group_ < rhsTransfer.group_;
+                     }
+                     const int64_t lhsPhase = ringPhase(lhsTransfer);
+                     const int64_t rhsPhase = ringPhase(rhsTransfer);
+                     if (lhsPhase != rhsPhase) {
+                       return lhsPhase < rhsPhase;
+                     }
+                     if (lhsTransfer.sourceCoreId_ !=
+                         rhsTransfer.sourceCoreId_) {
+                       return lhsTransfer.sourceCoreId_ <
+                              rhsTransfer.sourceCoreId_;
+                     }
+                     if (lhsTransfer.destinationCoreId_ !=
+                         rhsTransfer.destinationCoreId_) {
