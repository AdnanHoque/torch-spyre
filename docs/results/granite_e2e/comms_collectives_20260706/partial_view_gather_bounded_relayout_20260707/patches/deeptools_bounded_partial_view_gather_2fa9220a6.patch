     if (lx_space_found ||
         dldsc.computeOp_.at(0).opFuncName == OpFuncs::IDENTITY) {
 #ifdef DEBUG_RELAYOUT
@@ -2287,16 +2319,14 @@ void Dxp::insertRelayoutSdsc(SuperDsc* sdsc, int ps,
           FoldDimProp* addr_fold_prop = new FoldDimProp{1, "time"};
