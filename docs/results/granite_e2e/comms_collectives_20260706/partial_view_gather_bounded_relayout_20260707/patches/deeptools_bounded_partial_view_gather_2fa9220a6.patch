--- a/dxp/SdscRelayoutInsertion.cpp
+++ b/dxp/SdscRelayoutInsertion.cpp
@@ -128,6 +128,28 @@ static PartialViewGatherHook findPartialViewGatherHook(
   return {};
 }
 
+static bool partialViewGatherSourceOffsetBytes(
+    const PartialViewGatherHook& hook, const LabeledDsInfo& lds,
+    int64_t* offsetBytes, std::string* reason) {
+  *offsetBytes = 0;
+  const auto offsetIt = hook.fields.find("source_offset_elems");
+  if (offsetIt == hook.fields.end()) {
+    *reason = "partial_view_gather is missing source_offset_elems";
+    return false;
+  }
+  char* end = nullptr;
+  errno = 0;
+  const auto offsetElems = std::strtoll(offsetIt->second.c_str(), &end, 10);
+  if (errno != 0 || end == nullptr || *end != '\0' || offsetElems < 0) {
+    *reason = "partial_view_gather has invalid source_offset_elems=" +
+              offsetIt->second;
+    return false;
+  }
+  *offsetBytes =
+      static_cast<int64_t>(std::ceil(offsetElems * lds.wordLength));
+  return true;
+}
+
 static bool matmulOperandBroadcastMatchesLds(
     const std::map<std::string, std::string>& fields,
     const LabeledDsInfo& lds) {
@@ -1860,22 +1882,22 @@ void Dxp::insertRelayoutSdsc(SuperDsc* sdsc, int ps,
       continue;
 
     const auto partialViewGatherHook = findPartialViewGatherHook(sdsc, lds);
+    const bool hasPartialViewGather =
+        !partialViewGatherHook.classificationKey.empty();
+    int64_t partialViewSourceOffsetBytes = 0;
+    if (hasPartialViewGather) {
+      std::string partialViewReason;
+      if (!partialViewGatherSourceOffsetBytes(
+              partialViewGatherHook, lds, &partialViewSourceOffsetBytes,
+              &partialViewReason)) {
+        DT_CHECK_MSG(false, partialViewReason);
+      }
+    }
     if (!partialViewGatherHook.classificationKey.empty()) {
-      const auto sourceOffsetIt =
-          partialViewGatherHook.fields.find("source_offset_elems");
-      const auto sourceOffset =
-          sourceOffsetIt == partialViewGatherHook.fields.end()
-              ? std::string("<missing>")
-              : sourceOffsetIt->second;
-      DT_CHECK_MSG(false,
-                   "partial_view_gather metadata was classified for " +
-                       lds.dsName_ +
-                       ", but generic LX relayout cannot safely materialize "
-                       "a producer subview with source_offset_elems=" +
-                       sourceOffset +
-                       ". Preserve HBM fallback or use WSR/tile-scoped "
-                       "lowering until offset-aware partial-view gather is "
-                       "implemented.");
+      // Keep using the generic STCDPOpLx relayout mechanics for bounded
+      // same-layout views, but adjust the source LX base below by the view's
+      // constant source offset.  The HBM relayout fallback is not safe for this
+      // named class because it would discard the producer subview offset.
     }
 
     const auto layoutAllgatherHook = findLayoutAllgatherRestickifyPlan(sdsc, lds);
@@ -2076,6 +2098,16 @@ void Dxp::insertRelayoutSdsc(SuperDsc* sdsc, int ps,
       }
     }
 
