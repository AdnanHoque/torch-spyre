+static std::set<int> scheduledConsumerCores(const SuperDsc* sdsc) {
+  std::set<int> cores;
+  for (const auto& item : sdsc->coreIdToDscSchedule) {
+    cores.insert(item.first);
+  }
+  if (!cores.empty()) {
+    return cores;
+  }
+  for (const auto& item : sdsc->coreIdToWkSlice_) {
+    cores.insert(item.first);
+  }
+  return cores;
+}
