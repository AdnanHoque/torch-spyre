+static bool parseJsonObject(const std::string& jsonString,
+                            const std::string& fieldName,
+                            json11::Json* parsed, std::string* reason) {
+  std::string err;
+  *parsed = json11::Json::parse(jsonString, err);
+  if (!err.empty() || !parsed->is_object()) {
+    *reason = fieldName + " must be a JSON object";
+    if (!err.empty()) *reason += ": " + err;
+    return false;
+  }
+  return true;
+}
+
+static std::vector<std::string> jsonStringArray(const json11::Json& object,
+                                                const std::string& key) {
+  std::vector<std::string> result;
+  for (const auto& item : object[key].array_items()) {
+    if (!item.is_string()) return {};
+    result.push_back(item.string_value());
+  }
+  return result;
+}
+
+static double jsonNumberOrString(const json11::Json& value,
+                                 double defaultValue = 0) {
+  if (value.is_number()) return value.number_value();
+  if (value.is_string() && !value.string_value().empty()) {
+    return std::stod(value.string_value());
+  }
+  return defaultValue;
+}
+
+static int parseCoreIdKey(const std::string& key) {
+  std::size_t pos = 0;
+  while (pos < key.size() &&
+         !std::isdigit(static_cast<unsigned char>(key[pos])) &&
+         key[pos] != '-') {
+    ++pos;
+  }
+  if (pos == key.size()) return -1;
+  std::size_t end = pos + 1;
+  while (end < key.size() &&
+         std::isdigit(static_cast<unsigned char>(key[end]))) {
+    ++end;
+  }
+  return std::stoi(key.substr(pos, end - pos));
+}
+
+static std::map<int, std::map<std::string, int>> jsonCoreIdToSlice(
+    const json11::Json& tensorJson) {
+  std::map<int, std::map<std::string, int>> result;
+  for (const auto& coreAndSlice :
+       tensorJson["coreIdToWkSlice_"].object_items()) {
+    const int coreId = std::stoi(coreAndSlice.first);
+    if (!coreAndSlice.second.is_object()) return {};
+    for (const auto& dimAndSlice : coreAndSlice.second.object_items()) {
+      result[coreId][dimAndSlice.first] =
+          static_cast<int>(jsonNumberOrString(dimAndSlice.second));
+    }
+  }
+  return result;
+}
+
+static std::map<int, int64_t> jsonCoreStartAddresses(
+    const json11::Json& tensorJson) {
+  std::map<int, int64_t> result;
+  for (const auto& keyAndAddr :
+       tensorJson["startAddressCoreCorelet_"]["data_"].object_items()) {
+    const int coreId = parseCoreIdKey(keyAndAddr.first);
+    if (coreId < 0) continue;
+    result[coreId] = static_cast<int64_t>(jsonNumberOrString(keyAndAddr.second));
+  }
+  return result;
+}
+
+static double tensorContractDimExtent(const json11::Json& tensorJson,
+                                      const std::string& dim,
+                                      DesignSpaceConfig& dldsc) {
+  const auto coordInfo = tensorJson["coordinateInfo_"][dim];
+  const auto attrs = coordInfo["folds"]["dim_prop_attr"].array_items();
+  if (!attrs.empty()) {
+    double extent = 1;
+    for (const auto& attr : attrs) {
+      extent *= jsonNumberOrString(attr["factor_"], 1);
+    }
+    return extent;
+  }
+  return dldsc.N_.paramNameToVal(dim);
+}
+
+static std::map<std::string, std::string> buildDimRenameByPosition(
+    const json11::Json& sourceTensorJson, const json11::Json& targetTensorJson,
+    DesignSpaceConfig& dldsc, std::string* reason) {
+  const auto sourceDims = jsonStringArray(sourceTensorJson, "layoutDimOrder_");
+  const auto targetDims = jsonStringArray(targetTensorJson, "layoutDimOrder_");
+  if (sourceDims.empty() || targetDims.empty()) {
+    *reason = "source and target layoutDimOrder_ must be present";
+    return {};
+  }
+
+  std::map<std::string, std::string> rename;
+  std::size_t sourceIdx = 0;
+  for (const auto& targetDim : targetDims) {
+    const double targetExtent = tensorContractDimExtent(targetTensorJson, targetDim, dldsc);
+    double groupedExtent = 1;
+    bool consumed = false;
+    while (sourceIdx < sourceDims.size() && groupedExtent < targetExtent) {
+      const auto& sourceDim = sourceDims.at(sourceIdx++);
+      groupedExtent *= tensorContractDimExtent(sourceTensorJson, sourceDim, dldsc);
+      rename[sourceDim] = targetDim;
+      consumed = true;
+    }
+    if (!consumed || groupedExtent != targetExtent) {
+      *reason = "source layout dimensions cannot be grouped to target dim " +
+                targetDim;
+      return {};
+    }
+  }
+  if (sourceIdx != sourceDims.size()) {
+    *reason = "source layout has trailing dimensions not covered by target layout";
+    return {};
+  }
+  return rename;
+}
+
+static std::string renamedDim(const std::map<std::string, std::string>& rename,
+                              const std::string& dim) {
+  const auto it = rename.find(dim);
+  return it == rename.end() ? dim : it->second;
+}
+
+static std::map<std::string, std::set<int>> collectStringTensorSliceIds(
+    const std::map<int, std::map<std::string, int>>& coreIdToSlice,
+    const std::vector<std::string>& tensorDims) {
+  std::set<std::string> dimSet(tensorDims.begin(), tensorDims.end());
+  std::map<std::string, std::set<int>> result;
+  for (const auto& coreAndSlice : coreIdToSlice) {
+    for (const auto& dimAndSlice : coreAndSlice.second) {
+      if (!dimSet.count(dimAndSlice.first)) continue;
+      result[dimAndSlice.first].insert(dimAndSlice.second);
+    }
+  }
+  return result;
+}
+
+static bool fillTensorContractLdsShape(
+    LdsInfo& dataLds, DataOpDsc& ddsc, const json11::Json& tensorJson,
+    DesignSpaceConfig& dldsc,
+    const std::map<std::string, std::string>& dimRename,
+    const std::string& pdsName, std::string* reason) {
+  const auto layoutDims = jsonStringArray(tensorJson, "layoutDimOrder_");
+  const auto stickDims = jsonStringArray(tensorJson, "stickDimOrder_");
+  const auto stickSizes = tensorJson["stickSize_"].array_items();
+  if (layoutDims.empty()) {
+    *reason = "tensor contract is missing layoutDimOrder_";
+    return false;
+  }
+  if (stickDims.size() != stickSizes.size()) {
+    *reason = "tensor contract stickDimOrder_ and stickSize_ ranks differ";
+    return false;
+  }
+
+  dataLds.pdsName_ = pdsName;
+  dataLds.wordLength = jsonNumberOrString(tensorJson["wordLength"], 2);
+  dataLds.df = getDsFormat(dataLds.wordLength);
+  ddsc.primaryDs_[pdsName].name_ = pdsName;
+
+  for (const auto& sourceDim : layoutDims) {
+    const auto dimName = renamedDim(dimRename, sourceDim);
+    const auto sourceExtent = tensorContractDimExtent(tensorJson, sourceDim, dldsc);
+    if (std::find(dataLds.layoutDimOrder_.begin(), dataLds.layoutDimOrder_.end(),
+                  dimName) == dataLds.layoutDimOrder_.end()) {
+      dataLds.layoutDimOrder_.push_back(dimName);
+      ddsc.primaryDs_.at(pdsName).dimNames.insert(dimName);
+      dataLds.dimToLayoutSize_[dimName] = sourceExtent;
+    } else {
+      dataLds.dimToLayoutSize_[dimName] *= sourceExtent;
+    }
+  }
+  for (const auto& dimName : dataLds.layoutDimOrder_) {
+    dataLds.validGap_[dimName].push_back(
+        std::make_pair(dataLds.dimToLayoutSize_.at(dimName), 0));
+  }
+
+  for (std::size_t idx = 0; idx < stickDims.size(); ++idx) {
+    const auto dimName = renamedDim(dimRename, stickDims.at(idx));
+    if (std::find(dataLds.stickDimOrder_.begin(), dataLds.stickDimOrder_.end(),
+                  dimName) == dataLds.stickDimOrder_.end()) {
+      dataLds.stickDimOrder_.push_back(dimName);
+      dataLds.dimToStickSize_[dimName] = jsonNumberOrString(stickSizes.at(idx));
+    } else {
+      dataLds.dimToStickSize_.at(dimName) *= jsonNumberOrString(stickSizes.at(idx));
+    }
+    DT_CHECK(ddsc.primaryDs_.at(pdsName).dimNames.count(dimName));
+  }
+
+  double totalElements = 1;
+  for (const auto& dimAndSize : dataLds.dimToLayoutSize_) {
+    totalElements *= dimAndSize.second;
+  }
+  dataLds.totElements = totalElements;
+  return true;
+}
+
+static int64_t byteSizeForCell(
+    const LdsInfo& dataLds, const std::map<std::string, double>& dimToSize) {
+  double elements = 1;
+  for (const auto& dim : dataLds.layoutDimOrder_) {
+    elements *= dimToSize.at(dim);
+  }
+  return static_cast<int64_t>(std::ceil(elements * dataLds.wordLength));
+}
+
+static int64_t densePieceOffsetBytes(
+    const LdsInfo& dataLds, const std::map<std::string, double>& dimToSize,
+    const std::map<std::string, double>& dimToStart) {
+  int64_t ordinal = 0;
+  for (const auto& dim : dataLds.layoutDimOrder_) {
+    const auto dimExtent = dataLds.dimToLayoutSize_.at(dim);
+    const auto pieceExtent = dimToSize.at(dim);
+    const int64_t split = static_cast<int64_t>(dimExtent / pieceExtent);
+    const int64_t slot = static_cast<int64_t>(dimToStart.at(dim) / pieceExtent);
+    ordinal = ordinal * split + slot;
+  }
+  return ordinal * byteSizeForCell(dataLds, dimToSize);
+}
+
+static std::vector<std::pair<std::map<std::string, double>,
+                             std::map<std::string, double>>>
+splitCellByStickDims(const LdsInfo& dataLds,
+                     const std::map<std::string, double>& dimToSize,
+                     const std::map<std::string, double>& dimToStart) {
+  std::vector<std::pair<std::map<std::string, double>,
+                        std::map<std::string, double>>>
+      cells = {{dimToSize, dimToStart}};
+  for (const auto& dim : dataLds.stickDimOrder_) {
+    const auto stickIt = dataLds.dimToStickSize_.find(dim);
+    if (stickIt == dataLds.dimToStickSize_.end() || stickIt->second <= 0) {
+      continue;
+    }
+    const auto stick = stickIt->second;
+    std::vector<std::pair<std::map<std::string, double>,
+                          std::map<std::string, double>>>
+        nextCells;
+    for (const auto& cell : cells) {
+      const auto extent = cell.first.at(dim);
+      if (extent <= stick) {
+        nextCells.push_back(cell);
+        continue;
+      }
+      double offset = 0;
+      while (offset < extent) {
+        auto size = cell.first;
+        auto start = cell.second;
+        size[dim] = std::min(stick, extent - offset);
+        start[dim] += offset;
+        nextCells.push_back({size, start});
+        offset += stick;
+      }
+    }
+    cells = nextCells;
+  }
+  return cells;
+}
+
+static int64_t localDensePieceOffsetBytes(
+    const LdsInfo& dataLds, const std::map<std::string, double>& parentDimToSize,
+    const std::map<std::string, double>& parentDimToStart,
+    const std::map<std::string, double>& pieceDimToStart) {
+  double elementOffset = 0;
+  double stride = 1;
+  for (auto it = dataLds.layoutDimOrder_.rbegin();
+       it != dataLds.layoutDimOrder_.rend(); ++it) {
+    const auto& dim = *it;
+    const double diff = pieceDimToStart.at(dim) - parentDimToStart.at(dim);
+    DT_CHECK(diff >= 0);
+    elementOffset += diff * stride;
+    stride *= parentDimToSize.at(dim);
+  }
+  return static_cast<int64_t>(std::ceil(elementOffset * dataLds.wordLength));
+}
+
+static bool cellIntersection(
+    const std::vector<std::string>& dims,
+    const std::map<std::string, double>& leftSize,
+    const std::map<std::string, double>& leftStart,
+    const std::map<std::string, double>& rightSize,
+    const std::map<std::string, double>& rightStart,
+    std::map<std::string, double>* intersectionSize,
+    std::map<std::string, double>* intersectionStart) {
+  intersectionSize->clear();
+  intersectionStart->clear();
+  for (const auto& dim : dims) {
+    const double start = std::max(leftStart.at(dim), rightStart.at(dim));
+    const double end = std::min(leftStart.at(dim) + leftSize.at(dim),
+                                rightStart.at(dim) + rightSize.at(dim));
+    if (end <= start) return false;
+    (*intersectionStart)[dim] = start;
+    (*intersectionSize)[dim] = end - start;
+  }
+  return true;
+}
+
+static bool sourceShardCell(
+    DesignSpaceConfig& dldsc, const json11::Json& sourceTensorJson,
+    const std::map<std::string, int>& sourceSlice,
+    const std::map<std::string, std::set<int>>& sourceSliceIds,
+    const std::vector<std::string>& sourceLayoutDims,
+    const std::map<std::string, std::string>& sourceToTargetDim,
+    std::map<std::string, double>* dimToSize,
+    std::map<std::string, double>* dimToStart, std::string* reason) {
+  dimToSize->clear();
+  dimToStart->clear();
+  std::map<std::string, double> dimToGroupedExtent;
+  for (const auto& sourceDim : sourceLayoutDims) {
+    const auto targetDim = renamedDim(sourceToTargetDim, sourceDim);
+    const auto splitIt = sourceSliceIds.find(sourceDim);
+    const int split = splitIt == sourceSliceIds.end()
+                          ? 1
+                          : static_cast<int>(splitIt->second.size());
+    if (split <= 0) {
+      *reason = "source shard split must be positive for dim " + sourceDim;
+      return false;
+    }
+    const double sourceExtent = tensorContractDimExtent(sourceTensorJson, sourceDim, dldsc);
+    if (static_cast<int>(sourceExtent) % split != 0) {
+      *reason = "source shard extent is not evenly divisible for dim " +
+                sourceDim;
+      return false;
+    }
+    const auto slotIt = sourceSlice.find(sourceDim);
+    const int slot = slotIt == sourceSlice.end() ? 0 : slotIt->second;
+    const double sourceSize = sourceExtent / split;
+    const double sourceStart = slot * sourceSize;
+    const auto existingSize = dimToSize->find(targetDim);
+    if (existingSize == dimToSize->end()) {
+      (*dimToSize)[targetDim] = sourceSize;
+      (*dimToStart)[targetDim] = sourceStart;
+      dimToGroupedExtent[targetDim] = sourceExtent;
+    } else {
+      (*dimToSize)[targetDim] *= sourceSize;
+      (*dimToStart)[targetDim] =
+          (*dimToStart)[targetDim] * sourceExtent + sourceStart;
+      dimToGroupedExtent[targetDim] *= sourceExtent;
+    }
+  }
+  return true;
+}
+
+static void insertDataOpBeforeDl(SuperDsc* sdsc, int coreId, int dataOpIdx) {
+  auto& schedule = sdsc->coreIdToDscSchedule[coreId];
+  auto insertPos = schedule.begin();
+  for (auto it = schedule.begin(); it != schedule.end(); ++it) {
+    if (it->dldsc_idx == 0) {
+      insertPos = it;
+      break;
+    }
+  }
+  schedule.insert(insertPos, DscScheduleStep(dataOpIdx, -1, false, true));
+}
+
+struct GatheredPieceSpec {
+  std::string sourceKey;
+  int sourceCoreId = -1;
+  std::string key;
+  int coreId = -1;
+  std::map<std::string, double> dimToSize;
+  std::map<std::string, double> dimToStart;
+};
+
+static bool attachMatmulOperandBroadcastGatherThenRestickify(
+    SuperDsc* sdsc, LabeledDsInfo& lds,
+    const MatmulOperandBroadcastHookPlan& hook, MemTrackBundle* memTrackers,
+    int ps, std::string* reason) {
+  if (!hook.plan.requiresLayoutConversion) {
+    *reason = "gather-then-restickify path requires layout conversion metadata";
+    return false;
+  }
+  DT_CHECK(sdsc->dscs_.size() == 1);
+  auto& dldsc = sdsc->dscs_.at(0);
+  const auto allocNode = lds.memOrg_.count(SenComponents::LX)
+                             ? lds.memOrg_.at(SenComponents::LX).allocateNode_
+                             : nullptr;
+  if (allocNode == nullptr) {
+    *reason = "matmul operand broadcast input has no LX allocate node";
+    return false;
+  }
+
+  json11::Json sourceTensor;
+  json11::Json targetTensor;
+  if (!parseJsonObject(hook.plan.sourceLxTensorJson, "source_lx_tensor",
+                       &sourceTensor, reason) ||
+      !parseJsonObject(hook.plan.targetKernelTensorJson,
+                       "target_kernel_tensor", &targetTensor, reason)) {
+    return false;
+  }
+  const auto sourceToTargetDim =
+      buildDimRenameByPosition(sourceTensor, targetTensor, dldsc, reason);
+  if (sourceToTargetDim.empty()) return false;
+
+  const auto sourceLayoutDims = jsonStringArray(sourceTensor, "layoutDimOrder_");
+  const auto sourceCoreIdToSlice = jsonCoreIdToSlice(sourceTensor);
+  const auto sourceStartAddresses = jsonCoreStartAddresses(sourceTensor);
+  if (sourceCoreIdToSlice.empty() || sourceStartAddresses.empty()) {
+    *reason = "source_lx_tensor must contain coreIdToWkSlice_ and start addresses";
+    return false;
+  }
+  const auto sourceSliceIds =
+      collectStringTensorSliceIds(sourceCoreIdToSlice, sourceLayoutDims);
+  const auto transfers = deeptools::matmulOperandBroadcastLogicalTransfers(hook.plan);
+  if (transfers.empty()) {
+    *reason = "matmul_operand_broadcast has no logical transfers";
+    return false;
+  }
+
+  DataOpDsc gatherDdsc;
+  gatherDdsc.dscName_ = sdsc->name_ + "-" + lds.dsName_ +
+                        "-MatmulOperandGather";
+  gatherDdsc.opName = OpFuncs::STCDPOpLx;
+  gatherDdsc.op = new STCDPOpLx;
+  gatherDdsc.op->name = OpFuncs::STCDPOpLx;
+  gatherDdsc.primaryDs_["activation"].name_ = "activation";
+  gatherDdsc.target_ = sdsc->target_;
+  gatherDdsc.foldProps_.push_back(
+      new FoldDimProp(sdsc->sdscFoldProps_.at(0)->getSize(), "time"));
+  gatherDdsc.labeledDs_.resize(2);
+  auto& gatherIn = gatherDdsc.labeledDs_.at(0);
+  auto& gatherOut = gatherDdsc.labeledDs_.at(1);
+  gatherIn.ldsName_ = lds.dsName_ + "-MatmulOperandGather-inp";
+  gatherOut.ldsName_ = lds.dsName_ + "-MatmulOperandGather-tmp";
+  if (!fillTensorContractLdsShape(gatherIn, gatherDdsc, sourceTensor, dldsc,
+                                  sourceToTargetDim, "activation", reason)) {
+    return false;
+  }
+  if (!fillTensorContractLdsShape(gatherOut, gatherDdsc, sourceTensor, dldsc,
+                                  sourceToTargetDim, "activation", reason)) {
+    return false;
+  }
+  gatherDdsc.dimPool_ = gatherDdsc.primaryDs_.at("activation").dimNames;
+
+  std::map<int, int64_t> finalAddressByCore;
+  std::set<int> destinationCores;
+  for (const auto& transfer : transfers) {
+    destinationCores.insert(static_cast<int>(transfer.destinationCore));
+  }
+  LdsInfo targetShapeForTempReservation;
+  DataOpDsc targetShapeDdsc;
+  targetShapeDdsc.primaryDs_["dataOUT"].name_ = "dataOUT";
+  if (!fillTensorContractLdsShape(targetShapeForTempReservation, targetShapeDdsc,
+                                  targetTensor, dldsc, {}, "dataOUT", reason)) {
+    return false;
+  }
+  const auto targetLayoutDims = jsonStringArray(targetTensor, "layoutDimOrder_");
+  const auto targetCoreIdToSlice = jsonCoreIdToSlice(targetTensor);
+  if (targetCoreIdToSlice.empty()) {
+    *reason = "target_kernel_tensor must contain coreIdToWkSlice_";
+    return false;
+  }
+  const auto targetSliceIds =
+      collectStringTensorSliceIds(targetCoreIdToSlice, targetLayoutDims);
+  std::map<int, std::map<std::string, double>> finalShardSizeByCore;
+  std::map<int, std::map<std::string, double>> finalShardStartByCore;
+  for (const auto dstCore : destinationCores) {
+    const auto targetSliceIt = targetCoreIdToSlice.find(dstCore);
+    if (targetSliceIt == targetCoreIdToSlice.end()) {
+      *reason = "logical transfer references destination core without target metadata";
+      return false;
+    }
+    std::map<std::string, double> finalShardSize;
+    std::map<std::string, double> finalShardStart;
+    if (!sourceShardCell(dldsc, targetTensor, targetSliceIt->second, targetSliceIds,
+                         targetLayoutDims, {}, &finalShardSize,
+                         &finalShardStart, reason)) {
+      return false;
+    }
+    const auto finalShardBytes =
+        byteSizeForCell(targetShapeForTempReservation, finalShardSize);
+    auto& tracker = memTrackers->lxTrackPerCore.at(dstCore);
+    const auto reserveName = sdsc->name_ + "-" + lds.dsName_ +
+                             "-MatmulOperandFinalReserve-core" +
+                             std::to_string(dstCore);
+    const auto reservedAddr =
+        tracker.checkAndAddDs(reserveName, "dynamic", finalShardBytes, {ps});
+    if (reservedAddr < 0) {
+      *reason = "unable to allocate final matmul operand LX shard on core " +
+                std::to_string(dstCore) + " bytes " +
+                std::to_string(finalShardBytes);
+      return false;
+    }
+    finalAddressByCore[dstCore] = reservedAddr;
+    finalShardSizeByCore[dstCore] = finalShardSize;
+    finalShardStartByCore[dstCore] = finalShardStart;
+  }
+
+  const int maxGatherPiecesPerCorePerChunk = 4;
+  std::map<std::pair<int, int>, int64_t> gatherTempAddrByCoreSlot;
+  std::map<std::pair<int, int>, int64_t> gatherTempBytesByCoreSlot;
+  std::map<int, int> gatherPieceOrdinalByCore;
+
+  std::set<int> gatherCores;
+  std::set<std::string> sourcePiecesAdded;
+  std::vector<GatheredPieceSpec> gatheredPieceSpecs;
+  int transferPieceIdx = 0;
+  for (const auto& transfer : transfers) {
+    const int sourceCore = static_cast<int>(transfer.sourceCore);
+    const int dstCore = static_cast<int>(transfer.destinationCore);
+    const auto sourceSliceIt = sourceCoreIdToSlice.find(sourceCore);
+    const auto sourceAddrIt = sourceStartAddresses.find(sourceCore);
+    if (sourceSliceIt == sourceCoreIdToSlice.end() ||
+        sourceAddrIt == sourceStartAddresses.end()) {
+      *reason = "logical transfer references source core without source metadata";
+      return false;
+    }
+    std::map<std::string, double> sourceDimToSize;
+    std::map<std::string, double> sourceDimToStart;
+    if (!sourceShardCell(dldsc, sourceTensor, sourceSliceIt->second, sourceSliceIds,
+                         sourceLayoutDims, sourceToTargetDim, &sourceDimToSize,
+                         &sourceDimToStart, reason)) {
+      return false;
+    }
+    const auto targetSliceIt = targetCoreIdToSlice.find(dstCore);
+    if (targetSliceIt == targetCoreIdToSlice.end()) {
+      *reason = "logical transfer references destination core without target metadata";
+      return false;
+    }
+    std::map<std::string, double> targetDimToSize;
+    std::map<std::string, double> targetDimToStart;
+    if (!sourceShardCell(dldsc, targetTensor, targetSliceIt->second, targetSliceIds,
+                         targetLayoutDims, {}, &targetDimToSize,
+                         &targetDimToStart, reason)) {
+      return false;
+    }
+    std::map<std::string, double> dimToSize;
+    std::map<std::string, double> dimToStart;
+    if (!cellIntersection(gatherOut.layoutDimOrder_, sourceDimToSize,
+                          sourceDimToStart, targetDimToSize, targetDimToStart,
+                          &dimToSize, &dimToStart)) {
+      continue;
+    }
+    const auto subCells = splitCellByStickDims(gatherOut, dimToSize, dimToStart);
+    for (const auto& subCell : subCells) {
+      const auto& subDimToSize = subCell.first;
+      const auto& subDimToStart = subCell.second;
+      auto physicalTransferDimToSize =
+          expandPieceToStickSize(gatherOut, subDimToSize);
+      physicalTransferDimToSize = expandPieceToStickSize(
+          targetShapeForTempReservation, physicalTransferDimToSize);
+      const auto sourcePieceKey =
+          "src" + std::to_string(sourceCore) + "_" +
+          std::to_string(static_cast<int64_t>(
+              densePieceOffsetBytes(gatherIn, subDimToSize, subDimToStart)));
+      if (sourcePiecesAdded.insert(sourcePieceKey).second) {
+        int64_t sourcePieceAddr = sourceAddrIt->second;
+        sourcePieceAddr += localDensePieceOffsetBytes(
+            gatherIn, dimToSize, dimToStart, subDimToStart);
+        addLxPieceWithValidSize(gatherIn, sourcePieceKey, sourceCore,
+                                sourcePieceAddr, physicalTransferDimToSize,
+                                subDimToStart, subDimToSize);
+      }
+      const int pieceIndex = transferPieceIdx++;
+      const std::string gatheredPieceKey =
+          "dst" + std::to_string(sourceCore) + "_" + std::to_string(dstCore) +
+          "_" + std::to_string(pieceIndex);
+      const auto tempPieceBytes =
+          byteSizeForCell(gatherOut, physicalTransferDimToSize);
+      const int tempSlot =
+          gatherPieceOrdinalByCore[dstCore]++ % maxGatherPiecesPerCorePerChunk;
+      const auto tempKey = std::make_pair(dstCore, tempSlot);
+      const auto tempName = sdsc->name_ + "-" + lds.dsName_ +
+                            "-MatmulOperandGatherTmp-core" +
+                            std::to_string(dstCore) + "-slot" +
+                            std::to_string(tempSlot);
+      auto& tracker = memTrackers->lxTrackPerCore.at(dstCore);
+      int64_t tempAddr = -1;
+      const auto existingTempAddr = gatherTempAddrByCoreSlot.find(tempKey);
+      const auto existingTempBytes = gatherTempBytesByCoreSlot.find(tempKey);
+      if (existingTempAddr != gatherTempAddrByCoreSlot.end() &&
+          existingTempBytes != gatherTempBytesByCoreSlot.end() &&
+          existingTempBytes->second >= tempPieceBytes) {
+        tempAddr = existingTempAddr->second;
+      } else {
+        tempAddr =
+            tracker.checkAndAddDs(tempName, "dynamic", tempPieceBytes, {ps});
+        if (tempAddr < 0) {
+          *reason = "no LX room for matmul operand gather temp on core " +
+                    std::to_string(dstCore) + " piece " +
+                    std::to_string(pieceIndex) + " slot " +
+                    std::to_string(tempSlot);
+          return false;
+        }
+        gatherTempAddrByCoreSlot[tempKey] = tempAddr;
+        gatherTempBytesByCoreSlot[tempKey] = tempPieceBytes;
+      }
+      addLxPieceWithValidSize(gatherOut, gatheredPieceKey, dstCore, tempAddr,
+                              physicalTransferDimToSize, subDimToStart,
+                              subDimToSize);
+      gatheredPieceSpecs.push_back({sourcePieceKey, sourceCore, gatheredPieceKey,
+                                     dstCore, subDimToSize, subDimToStart});
+    }
+    gatherCores.insert(sourceCore);
+    gatherCores.insert(dstCore);
+  }
+  gatherDdsc.coreIdsUsed_.assign(gatherCores.begin(), gatherCores.end());
+
+  DataOpDsc restickifyDdsc;
+  restickifyDdsc.dscName_ = sdsc->name_ + "-" + lds.dsName_ +
+                            "-MatmulOperandRestickify";
+  restickifyDdsc.opName = OpFuncs::ReStickifyOpLx;
+  restickifyDdsc.op = new ReStickifyOpLx;
+  restickifyDdsc.op->name = OpFuncs::ReStickifyOpLx;
+  restickifyDdsc.primaryDs_["dataIN"].name_ = "dataIN";
+  restickifyDdsc.primaryDs_["dataOUT"].name_ = "dataOUT";
+  restickifyDdsc.target_ = sdsc->target_;
+  restickifyDdsc.foldProps_.push_back(
+      new FoldDimProp(sdsc->sdscFoldProps_.at(0)->getSize(), "time"));
+  restickifyDdsc.labeledDs_.resize(2);
+  auto& restickifyIn = restickifyDdsc.labeledDs_.at(0);
+  auto& restickifyOut = restickifyDdsc.labeledDs_.at(1);
+  restickifyIn = gatherOut;
+  restickifyIn.ldsName_ = lds.dsName_ + "-MatmulOperandRestickify-inp";
+  restickifyIn.pdsName_ = "dataIN";
+  for (const auto& dim : restickifyIn.layoutDimOrder_) {
+    restickifyDdsc.primaryDs_.at("dataIN").dimNames.insert(dim);
+  }
+  restickifyOut.ldsName_ = lds.dsName_;
+  if (!fillTensorContractLdsShape(restickifyOut, restickifyDdsc, targetTensor,
+                                  dldsc, {}, "dataOUT", reason)) {
+    return false;
+  }
+  for (const auto& piece : gatheredPieceSpecs) {
+    const auto finalPieceAddr =
+        finalAddressByCore.at(piece.coreId) +
+        localDensePieceOffsetBytes(restickifyOut,
+                                   finalShardSizeByCore.at(piece.coreId),
+                                   finalShardStartByCore.at(piece.coreId),
+                                   piece.dimToStart);
+    const auto physicalOutDimToSize =
+        expandPieceToStickSize(restickifyOut, piece.dimToSize);
+    addLxPieceWithValidSize(restickifyOut, piece.key, piece.coreId,
+                            finalPieceAddr, physicalOutDimToSize,
+                            piece.dimToStart, piece.dimToSize);
+  }
+  std::set<int> restickifyCores;
+  for (const auto& piece : gatheredPieceSpecs) {
+    restickifyCores.insert(piece.coreId);
+  }
+  if (restickifyCores.empty()) {
+    *reason = "matmul operand gather produced no restickify pieces";
+    return false;
+  }
+  restickifyDdsc.coreIdsUsed_.assign(restickifyCores.begin(),
+                                     restickifyCores.end());
+  for (const auto& dim : restickifyOut.layoutDimOrder_) {
+    restickifyDdsc.primaryDs_.at("dataOUT").dimNames.insert(dim);
+  }
+  restickifyDdsc.dimPool_ = restickifyDdsc.primaryDs_.at("dataIN").dimNames;
+  restickifyDdsc.dimPool_.insert(
+      restickifyDdsc.primaryDs_.at("dataOUT").dimNames.begin(),
+      restickifyDdsc.primaryDs_.at("dataOUT").dimNames.end());
+
+  std::vector<std::vector<GatheredPieceSpec>> chunks;
+  std::vector<GatheredPieceSpec> currentChunk;
+  std::map<int, int> currentChunkDestinationCoreCounts;
+  for (const auto& piece : gatheredPieceSpecs) {
+    if (currentChunkDestinationCoreCounts[piece.coreId] >=
+        maxGatherPiecesPerCorePerChunk) {
+      chunks.push_back(currentChunk);
+      currentChunk.clear();
+      currentChunkDestinationCoreCounts.clear();
+    }
+    currentChunk.push_back(piece);
+    currentChunkDestinationCoreCounts[piece.coreId]++;
+  }
+  if (!currentChunk.empty()) chunks.push_back(currentChunk);
+  const int maxDebugChunks = getPositiveDebugEnvInt(
+      "DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_CHUNKS");
+  if (maxDebugChunks > 0 &&
+      chunks.size() > static_cast<size_t>(maxDebugChunks)) {
+    chunks.resize(static_cast<size_t>(maxDebugChunks));
+  }
+
+  for (size_t chunkIdx = 0; chunkIdx < chunks.size(); ++chunkIdx) {
+    auto chunkGatherDdsc = gatherDdsc;
+    chunkGatherDdsc.dscName_ += "-chunk" + std::to_string(chunkIdx);
+    chunkGatherDdsc.op = new STCDPOpLx;
+    chunkGatherDdsc.op->name = OpFuncs::STCDPOpLx;
+    chunkGatherDdsc.labeledDs_.at(0).pieces_.clear();
+    chunkGatherDdsc.labeledDs_.at(1).pieces_.clear();
+
+    auto chunkRestickifyDdsc = restickifyDdsc;
+    chunkRestickifyDdsc.dscName_ += "-chunk" + std::to_string(chunkIdx);
+    chunkRestickifyDdsc.op = new ReStickifyOpLx;
+    chunkRestickifyDdsc.op->name = OpFuncs::ReStickifyOpLx;
+    chunkRestickifyDdsc.labeledDs_.at(0).pieces_.clear();
+    chunkRestickifyDdsc.labeledDs_.at(1).pieces_.clear();
+
+    std::set<int> chunkGatherCores;
+    std::set<int> chunkRestickifyCores;
+    for (const auto& piece : chunks.at(chunkIdx)) {
+      const auto gatherInPiece = gatherIn.pieces_.find(piece.sourceKey);
+      const auto gatherOutPiece = gatherOut.pieces_.find(piece.key);
+      const auto restickifyInPiece = restickifyIn.pieces_.find(piece.key);
+      const auto restickifyOutPiece = restickifyOut.pieces_.find(piece.key);
+      if (gatherInPiece == gatherIn.pieces_.end() ||
+          gatherOutPiece == gatherOut.pieces_.end() ||
+          restickifyInPiece == restickifyIn.pieces_.end() ||
+          restickifyOutPiece == restickifyOut.pieces_.end()) {
+        *reason = "chunked gather/restickify missing piece metadata for chunk " +
+                  std::to_string(chunkIdx) + " source " + piece.sourceKey +
+                  " gathered " + piece.key;
+        return false;
+      }
+      chunkGatherDdsc.labeledDs_.at(0).pieces_[piece.sourceKey] =
+          gatherInPiece->second;
+      chunkGatherDdsc.labeledDs_.at(1).pieces_[piece.key] =
+          gatherOutPiece->second;
+      chunkRestickifyDdsc.labeledDs_.at(0).pieces_[piece.key] =
+          restickifyInPiece->second;
+      chunkRestickifyDdsc.labeledDs_.at(1).pieces_[piece.key] =
+          restickifyOutPiece->second;
+      chunkGatherCores.insert(piece.sourceCoreId);
+      chunkGatherCores.insert(piece.coreId);
+      chunkRestickifyCores.insert(piece.coreId);
+    }
+    chunkGatherDdsc.coreIdsUsed_.assign(chunkGatherCores.begin(),
+                                        chunkGatherCores.end());
+    chunkRestickifyDdsc.coreIdsUsed_.assign(chunkRestickifyCores.begin(),
+                                            chunkRestickifyCores.end());
+
+    const int gatherIdx = static_cast<int>(sdsc->dataOpdscs_.size());
+    sdsc->dataOpdscs_.push_back(chunkGatherDdsc);
+    const int restickifyIdx = static_cast<int>(sdsc->dataOpdscs_.size());
+    sdsc->dataOpdscs_.push_back(chunkRestickifyDdsc);
+
+    for (const auto coreId : chunkGatherCores) {
+      insertDataOpBeforeDl(sdsc, coreId, gatherIdx);
+    }
+    for (const auto coreId : chunkRestickifyCores) {
+      insertDataOpBeforeDl(sdsc, coreId, restickifyIdx);
+    }
+  }
+
+  allocNode->allocateCoordinates_.coreIdToWkSlice_.clear();
+  auto& stAddr = allocNode->startAddressCoreCorelet_;
+  for (int coreId = 0; coreId < stAddr.getFoldSpaceSize().at(0); ++coreId) {
+    const auto finalIt = finalAddressByCore.find(coreId);
+    stAddr.insertData(finalIt == finalAddressByCore.end() ? -1 : finalIt->second,
+                      coreId, 0, 0);
+  }
+  if (!lds.coreStateInit_.empty()) {
+    for (int coreId = 0; coreId < stAddr.getFoldSpaceSize().at(0); ++coreId) {
+      if (static_cast<size_t>(coreId) >= lds.coreStateInit_.size()) continue;
+      auto& coreState = lds.coreStateInit_.at(coreId);
+      if (coreState.lbrInit_.empty()) continue;
+      const auto newBase = stAddr.getData(coreId, 0, 0);
+      if (newBase < 0) {
+        for (auto& lbr : coreState.lbrInit_) lbr = -1;
+        continue;
+      }
+      const auto oldBase = coreState.lbrInit_.at(0);
+      const auto delta = static_cast<int>(newBase - oldBase);
+      for (auto& lbr : coreState.lbrInit_) lbr += delta;
+    }
+  }
+  return true;
+}
+
+static int sliceSplitForDim(
+    const std::map<PrimaryDimTypes, std::set<int>>& sliceIds,
+    PrimaryDimTypes dim) {
+  const auto splitIt = sliceIds.find(dim);
+  return splitIt == sliceIds.end() ? 1 : static_cast<int>(splitIt->second.size());
+}
+
+static int sliceSlotForDim(const std::map<PrimaryDimTypes, int>& slice,
+                           PrimaryDimTypes dim) {
+  const auto slotIt = slice.find(dim);
+  return slotIt == slice.end() ? 0 : slotIt->second;
+}
+
+static bool tensorSliceIntersectionCell(
+    const DesignSpaceConfig& dldsc,
+    const std::map<PrimaryDimTypes, int>& srcSlice,
+    const std::map<PrimaryDimTypes, std::set<int>>& srcSliceIds,
+    const std::map<PrimaryDimTypes, int>& dstSlice,
+    const std::map<PrimaryDimTypes, std::set<int>>& dstSliceIds,
+    const std::vector<PrimaryDimTypes>& tensorDims,
+    std::map<std::string, double>* dimToSize,
+    std::map<std::string, double>* dimToStart) {
+  dimToSize->clear();
+  dimToStart->clear();
+  for (const auto& dim : tensorDims) {
+    const int srcSplit = sliceSplitForDim(srcSliceIds, dim);
+    const int dstSplit = sliceSplitForDim(dstSliceIds, dim);
+    DT_CHECK(srcSplit > 0);
+    DT_CHECK(dstSplit > 0);
+    const int srcSlot = sliceSlotForDim(srcSlice, dim);
+    const int dstSlot = sliceSlotForDim(dstSlice, dim);
+
+    const double dimExtent = dldsc.N_.primaryDimToVal_st(dim);
+    const double srcStart = dimExtent * srcSlot / srcSplit;
+    const double srcEnd = dimExtent * (srcSlot + 1) / srcSplit;
+    const double dstStart = dimExtent * dstSlot / dstSplit;
+    const double dstEnd = dimExtent * (dstSlot + 1) / dstSplit;
+    const double overlapStart = srcStart > dstStart ? srcStart : dstStart;
+    const double overlapEnd = srcEnd < dstEnd ? srcEnd : dstEnd;
+    if (overlapEnd <= overlapStart) return false;
+
+    const std::string dimName = dataOpDimName(dldsc, dim);
+    (*dimToStart)[dimName] = overlapStart;
+    (*dimToSize)[dimName] = overlapEnd - overlapStart;
+  }
+  return true;
+}
+
+static bool markMatmulOperandBroadcastKernelNeighbor(
+    DesignSpaceConfig& dldsc, LabeledDsInfo& lds, std::string* reason) {
+  if (lds.dsType_ != DsTypes::KERNEL) {
+    *reason = "matmul_operand_broadcast kernel-neighbor path requires KERNEL LDS";
+    return false;
+  }
+  if (!lds.memOrg_.count(SenComponents::LX)) {
+    *reason = "matmul_operand_broadcast kernel-neighbor input is not LX pinned";
+    return false;
+  }
+
+  // The producer allocation describes where the source shard currently lives.
+  // The loop-scoped KERNEL-neighbor path needs the DL scheduler to allocate the
+  // consumer KERNEL chunk instead of reusing that producer allocation as a
+  // resident replicated destination. Remove the old external allocate node from
+  // the prefilled schedule tree, otherwise DDC will still expect memOrg_ to point
+  // at the stale resident allocation.
+  // Keep the producer allocation in the schedule tree.  The DL scheduler uses
+  // it as the source coordinate anchor when it creates the consumer allocation
+  // for the loop-scoped KERNEL-neighbor operand.
+  lds.memOrg_.at(SenComponents::LX).allocateNode_ = nullptr;
+  return true;
+}
+
+static bool attachMatmulOperandBroadcastInputFetch(
+    SuperDsc* sdsc, const LabeledDsInfo& lds,
+    const MatmulOperandBroadcastHookPlan& hook, std::string* reason) {
+  (void)hook;
+  DT_CHECK(sdsc->dscs_.size() == 1);
+  auto& dldsc = sdsc->dscs_.at(0);
+  const auto allocNode = lds.memOrg_.count(SenComponents::LX)
+                             ? lds.memOrg_.at(SenComponents::LX).allocateNode_
+                             : nullptr;
+  if (allocNode == nullptr) {
+    *reason = "matmul_operand_broadcast input has no LX allocate node";
+    return false;
+  }
+  const auto producerCoreIdToWkSlice =
+      allocNode->allocateCoordinates_.coreIdToWkSlice_;
+  if (producerCoreIdToWkSlice.empty()) {
+    *reason = "matmul_operand_broadcast input has empty producer coordinates";
+    return false;
+  }
+
+  const auto& refDsInfo = dldsc.primaryDsInfo_.at(lds.dsType_);
+  const auto producerSliceIds =
+      collectTensorSliceIds(producerCoreIdToWkSlice,
+                            refDsInfo.layoutDimOrder_);
+  const auto consumerSliceIds =
+      collectTensorSliceIds(sdsc->coreIdToWkSlice_, refDsInfo.layoutDimOrder_);
+
+  int64_t replicatedDstAddr = -1;
+  for (const auto& coreAndSlice : sdsc->coreIdToWkSlice_) {
+    const auto dstAddr = lxStartAddressForCore(lds, coreAndSlice.first);
+    if (dstAddr < 0) {
+      *reason = "missing destination LX base for consumer core " +
+                std::to_string(coreAndSlice.first);
+      return false;
+    }
+    if (replicatedDstAddr < 0) {
+      replicatedDstAddr = dstAddr;
+    } else if (replicatedDstAddr != dstAddr) {
+      *reason = "matmul_operand_broadcast requires equal destination LX bases";
+      return false;
+    }
+  }
+
+  std::vector<int> dataOpIndices;
+  const bool useSingleIfnDataOp =
+      std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_SINGLE_IFN") !=
+      nullptr;
+  DataOpDsc singleDdsc;
+  std::set<int> singleCoresSeen;
+  LdsInfo* singleInpLds = nullptr;
+  LdsInfo* singleOutLds = nullptr;
+  if (useSingleIfnDataOp) {
+    singleDdsc.dscName_ = sdsc->name_ + "-" + lds.dsName_ +
+                          "-LxInputNeighborFetch-combined";
+    singleDdsc.opName = OpFuncs::STCDPOpLx;
+    singleDdsc.op = new STCDPOpLx;
+    singleDdsc.op->name = OpFuncs::STCDPOpLx;
+    singleDdsc.primaryDs_["activation"].name_ = "activation";
+    singleDdsc.target_ = sdsc->target_;
+    singleDdsc.foldProps_.push_back(new FoldDimProp(
+        sdsc->sdscFoldProps_.at(0)->getSize(), "time"));
+    singleDdsc.labeledDs_.resize(2);
+    singleInpLds = &singleDdsc.labeledDs_.at(0);
+    singleOutLds = &singleDdsc.labeledDs_.at(1);
+    singleInpLds->ldsName_ = lds.dsName_ + "-LxInputNeighborFetch-inp";
+    singleOutLds->ldsName_ = lds.dsName_;
+    fillDataOpLdsShape(*singleInpLds, singleDdsc, lds, dldsc);
+    fillDataOpLdsShape(*singleOutLds, singleDdsc, lds, dldsc);
+    singleDdsc.dimPool_ = singleDdsc.primaryDs_.at("activation").dimNames;
+    DT_CHECK(singleOutLds->stickDimOrder_ == singleInpLds->stickDimOrder_);
+    DT_CHECK(singleOutLds->dimToStickSize_ ==
+             singleInpLds->dimToStickSize_);
+  }
+
+  for (const auto& coreAndSlice : producerCoreIdToWkSlice) {
+    std::vector<int> destinationCores;
+    for (const auto& dstCoreAndSlice : sdsc->coreIdToWkSlice_) {
+      std::map<std::string, double> ignoredSize;
+      std::map<std::string, double> ignoredStart;
+      if (tensorSliceIntersectionCell(
+              dldsc, coreAndSlice.second, producerSliceIds,
+              dstCoreAndSlice.second, consumerSliceIds,
+              refDsInfo.layoutDimOrder_, &ignoredSize, &ignoredStart)) {
+        destinationCores.push_back(dstCoreAndSlice.first);
+      }
+    }
+    if (destinationCores.empty()) {
+      *reason =
+          "matmul_operand_broadcast found no overlapping consumers for "
+          "producer core " +
+          std::to_string(coreAndSlice.first);
+      return false;
+    }
+
+    DataOpDsc ddsc;
+    LdsInfo* inpLdsPtr = singleInpLds;
+    LdsInfo* outLdsPtr = singleOutLds;
+    std::set<int> coresSeen;
+    if (!useSingleIfnDataOp) {
+      ddsc.dscName_ = sdsc->name_ + "-" + lds.dsName_ +
+                      "-LxInputNeighborFetch-src" +
+                      std::to_string(coreAndSlice.first);
+      ddsc.opName = OpFuncs::STCDPOpLx;
+      ddsc.op = new STCDPOpLx;
+      ddsc.op->name = OpFuncs::STCDPOpLx;
+      ddsc.primaryDs_["activation"].name_ = "activation";
+      ddsc.target_ = sdsc->target_;
+      ddsc.foldProps_.push_back(new FoldDimProp(
+          sdsc->sdscFoldProps_.at(0)->getSize(), "time"));
+      if (coresSeen.insert(coreAndSlice.first).second) {
+        ddsc.coreIdsUsed_.push_back(coreAndSlice.first);
+      }
+      for (const auto dstCore : destinationCores) {
+        if (coresSeen.insert(dstCore).second)
+          ddsc.coreIdsUsed_.push_back(dstCore);
+      }
+
+      ddsc.labeledDs_.resize(2);
+      auto& inpLds = ddsc.labeledDs_.at(0);
+      auto& outLds = ddsc.labeledDs_.at(1);
+      inpLds.ldsName_ = lds.dsName_ + "-LxInputNeighborFetch-inp-src" +
+                        std::to_string(coreAndSlice.first);
+      outLds.ldsName_ = lds.dsName_;
+      fillDataOpLdsShape(inpLds, ddsc, lds, dldsc);
+      fillDataOpLdsShape(outLds, ddsc, lds, dldsc);
+      ddsc.dimPool_ = ddsc.primaryDs_.at("activation").dimNames;
+      DT_CHECK(outLds.stickDimOrder_ == inpLds.stickDimOrder_);
+      DT_CHECK(outLds.dimToStickSize_ == inpLds.dimToStickSize_);
+      inpLdsPtr = &inpLds;
+      outLdsPtr = &outLds;
+    } else {
+      if (singleCoresSeen.insert(coreAndSlice.first).second) {
+        singleDdsc.coreIdsUsed_.push_back(coreAndSlice.first);
+      }
+      for (const auto dstCore : destinationCores) {
+        if (singleCoresSeen.insert(dstCore).second)
+          singleDdsc.coreIdsUsed_.push_back(dstCore);
+      }
+    }
+
+    std::map<std::string, double> dimToSize;
+    std::map<std::string, double> dimToStart;
+    for (const auto& pDim : refDsInfo.layoutDimOrder_) {
+      const std::string dimName = dataOpDimName(dldsc, pDim);
+      const double dimExtent = dldsc.N_.primaryDimToVal_st(pDim);
+      const auto splitIt = producerSliceIds.find(pDim);
+      const int split = splitIt == producerSliceIds.end()
+                            ? 1
+                            : static_cast<int>(splitIt->second.size());
+      DT_CHECK(split > 0);
+      DT_CHECK(static_cast<int>(dimExtent) % split == 0);
+      const int sliceIdx = coreAndSlice.second.count(pDim)
+                               ? coreAndSlice.second.at(pDim)
+                               : 0;
+      dimToSize[dimName] = dimExtent / split;
+      dimToStart[dimName] = sliceIdx * dimToSize.at(dimName);
+    }
+    const auto srcAddr = lxStartAddressForCore(lds, coreAndSlice.first);
+    if (srcAddr < 0) {
+      *reason = "missing source LX base for producer core " +
+                std::to_string(coreAndSlice.first);
+      return false;
+    }
+
+    const std::string pieceSuffix = useSingleIfnDataOp
+                                        ? std::to_string(coreAndSlice.first)
+                                        : "0";
+    addLxPiece(*inpLdsPtr, "src" + pieceSuffix, coreAndSlice.first, srcAddr,
+               dimToSize, dimToStart);
+    addReplicatedLxPiece(*outLdsPtr, "dst" + pieceSuffix, destinationCores,
+                         replicatedDstAddr, dimToSize, dimToStart);
+
+    if (!useSingleIfnDataOp) {
+      const int dataOpIdx = static_cast<int>(sdsc->dataOpdscs_.size());
+      sdsc->dataOpdscs_.push_back(ddsc);
+      dataOpIndices.push_back(dataOpIdx);
+    }
+    if (std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_ONE_IFN_PROBE") !=
+        nullptr) {
+      break;
+    }
+  }
+
+  if (useSingleIfnDataOp) {
+    const int dataOpIdx = static_cast<int>(sdsc->dataOpdscs_.size());
+    sdsc->dataOpdscs_.push_back(singleDdsc);
+    dataOpIndices.push_back(dataOpIdx);
+  }
+
+  const bool useCombinedSchedule =
+      std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_COMBINED_IFN") !=
+      nullptr;
+  const bool replaceDlScheduleStep =
+      std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_REPLACE_DL_STEP") !=
+      nullptr;
+  allocNode->allocateCoordinates_.coreIdToWkSlice_.clear();
+  for (const auto& coreAndSlice : sdsc->coreIdToWkSlice_) {
+    auto& schedule = sdsc->coreIdToDscSchedule[coreAndSlice.first];
+    auto insertPos = schedule.begin();
+    for (auto it = schedule.begin(); it != schedule.end(); ++it) {
+      if (it->dldsc_idx == 0) {
+        insertPos = it;
+        break;
+      }
+    }
+    if (useCombinedSchedule && replaceDlScheduleStep) {
+      DT_CHECK_MSG(dataOpIndices.size() == 1,
+                   "replacement IFN probe expects exactly one data op");
+      bool replaced = false;
+      for (auto it = schedule.begin(); it != schedule.end(); ++it) {
+        if (it->dldsc_idx == 0) {
+          it->datadsc_idx = dataOpIndices.front();
+          it->before_sync = false;
+          it->after_sync = true;
+          replaced = true;
+          break;
+        }
+      }
+      DT_CHECK_MSG(replaced, "failed to find DL schedule step to replace");
+      continue;
+    }
+    for (const auto dataOpIdx : dataOpIndices) {
+      const int dldscIdx = useCombinedSchedule ? 0 : -1;
+      insertPos = schedule.insert(insertPos,
+                                  DscScheduleStep(dataOpIdx, dldscIdx, false,
+                                                  true));
+      ++insertPos;
+    }
+  }
+  return true;
+}
