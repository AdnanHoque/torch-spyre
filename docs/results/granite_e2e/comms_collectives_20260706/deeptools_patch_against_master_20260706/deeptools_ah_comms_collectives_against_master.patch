+/************************************************************
+ * IBM Confidential
+ * (C) Copyright IBM Corp. 2026
+ ************************************************************/
+
+#ifndef UTIL_LAYOUT_ALLGATHER_RESTICKIFY_H_
+#define UTIL_LAYOUT_ALLGATHER_RESTICKIFY_H_
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace deeptools {
+
+struct LayoutAllgatherRestickifyCheckResult {
+  bool ok = false;
+  std::string kind;
+  std::string communicationClass;
+  bool requiresStagedRealization = false;
+  std::string reason;
+  std::uint64_t sourceCoreCount = 0;
+  std::uint64_t restickifyCoreCount = 0;
+  std::uint64_t consumerCoreCount = 0;
+};
+
+struct LayoutAllgatherRestickifyMovementPlan {
+  bool ok = false;
+  std::string reason;
+  std::string communicationClass;
+  std::string movementPattern;
+  std::string restickifyOp;
+  std::string consumerOperandDsType;
+  std::uint64_t sourceCoreCount = 0;
+  std::uint64_t restickifyCoreCount = 0;
+  std::uint64_t consumerCoreCount = 0;
+  std::uint64_t groupCount = 0;
+  std::uint64_t producerChunksPerGroup = 0;
+  std::uint64_t consumerCoresPerGroup = 0;
+  std::uint64_t replicationFactor = 0;
+  std::uint64_t logicalTransferCount = 0;
+  std::vector<std::string> stages;
+};
+
+struct LayoutAllgatherRestickifyLogicalTransfer {
+  std::uint64_t group = 0;
+  std::uint64_t producerChunk = 0;
+  std::uint64_t consumerReplica = 0;
+  std::uint64_t sourceCore = 0;
+  std::uint64_t destinationCore = 0;
+};
+
+struct MatmulOperandBroadcastMovementPlan {
+  bool ok = false;
+  std::string reason;
+  std::string kind;
+  std::string communicationPattern;
+  std::string materializationPattern;
+  std::string realizationStrategy;
+  std::string consumerOperandDsType;
+  bool requiresLayoutConversion = false;
+  std::string layoutTransformJson;
+  std::string sourceLxTensorJson;
+  std::string targetKernelTensorJson;
+  std::string stagedDestinationJson;
+  bool realized = false;
+  std::int64_t operandIndex = -1;
+  std::uint64_t sourceCoreCount = 0;
+  std::uint64_t consumerCoreCount = 0;
+  std::uint64_t groupCount = 0;
+  std::uint64_t producerChunksPerGroup = 0;
+  std::uint64_t consumerReplicasPerGroup = 0;
+  std::uint64_t replicationFactor = 0;
+  std::uint64_t logicalTransferCount = 0;
+  std::uint64_t estimatedTensorBytes = 0;
+  std::vector<std::string> stages;
+  std::vector<std::vector<std::uint64_t>> sourceCoresByGroup;
+  std::vector<std::vector<std::uint64_t>> destinationCoresByGroup;
+};
+
+struct MatmulOperandBroadcastLogicalTransfer {
+  std::uint64_t group = 0;
+  std::uint64_t producerChunk = 0;
+  std::uint64_t consumerReplica = 0;
+  std::uint64_t sourceCore = 0;
+  std::uint64_t destinationCore = 0;
+};
+
+// Validate the explicit DLDSC-side contract for flash attention edges where a
+// producer layout must be restickified on chip and then gathered into the
+// consumer kernel operand. This is intentionally fail-closed: partial metadata
+// must not silently look like a realizable movement primitive.
+LayoutAllgatherRestickifyCheckResult checkLayoutAllgatherRestickifyContract(
+    const std::string &jsonString);
+
+// Consume a validated flash contract into a backend-facing movement plan. This
+// is intentionally narrower than the checker: only the known flash
+// mul->ReStickifyOpHBM->batchmatmul KERNEL edge is accepted.
+LayoutAllgatherRestickifyMovementPlan
+synthesizeLayoutAllgatherRestickifyMovementPlan(const std::string &jsonString);
+
+// Same as above, but accepts the flat string metadata preserved on SuperDsc.
+// Nested values are expected to be JSON-encoded strings.
+LayoutAllgatherRestickifyMovementPlan
+synthesizeLayoutAllgatherRestickifyMovementPlan(
+    const std::map<std::string, std::string> &fields);
+
+// Build the deterministic backend artifact emitted when DXP reaches the exact
+// mutation point but physical grouped lowering is not implemented yet.
+std::string layoutAllgatherRestickifyMovementPlanArtifactJson(
+    const LayoutAllgatherRestickifyMovementPlan &plan,
+    const std::map<std::string, std::string> &context);
+
+// Expand the compact flash grouped-all-gather plan into source/destination core
+// pairs. This is still logical: byte ranges and LX addresses are filled by the
+// DXP mutation point using imported SDSC allocation data.
+std::vector<LayoutAllgatherRestickifyLogicalTransfer>
+layoutAllgatherRestickifyLogicalTransfers(
+    const LayoutAllgatherRestickifyMovementPlan &plan);
+
+// Consume the Granite attention value-operand contract
+// `matmul_operand_broadcast` / `all_gather_replicate` into a backend-facing
+// grouped movement plan. This describes loop-scoped producer-shard fanout; it
+// deliberately rejects resident replication because that is the full
+// per-consumer materialization class this path is meant to avoid.
+MatmulOperandBroadcastMovementPlan
+synthesizeMatmulOperandBroadcastMovementPlan(const std::string &jsonString);
+
+// Same as above, but accepts the flat string metadata preserved on SuperDsc.
+MatmulOperandBroadcastMovementPlan
+synthesizeMatmulOperandBroadcastMovementPlan(
+    const std::map<std::string, std::string> &fields);
+
+std::string matmulOperandBroadcastMovementPlanArtifactJson(
+    const MatmulOperandBroadcastMovementPlan &plan,
+    const std::map<std::string, std::string> &context);
+
+std::vector<MatmulOperandBroadcastLogicalTransfer>
+matmulOperandBroadcastLogicalTransfers(
+    const MatmulOperandBroadcastMovementPlan &plan);
+
+}  // namespace deeptools
+
+#endif  // UTIL_LAYOUT_ALLGATHER_RESTICKIFY_H_
