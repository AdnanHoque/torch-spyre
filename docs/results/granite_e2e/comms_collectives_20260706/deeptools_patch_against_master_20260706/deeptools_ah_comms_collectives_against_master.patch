+Json metadataValueToJson(const std::string &value) {
+  if (value == "true") return Json(true);
+  if (value == "false") return Json(false);
+
+  const auto numericFirst = value.find_first_not_of(" \t\n\r");
+  if (numericFirst != std::string::npos) {
+    const auto numericLast = value.find_last_not_of(" \t\n\r");
+    const auto token =
+        value.substr(numericFirst, numericLast - numericFirst + 1);
+    char *end = nullptr;
+    errno = 0;
+    const long parsed = std::strtol(token.c_str(), &end, 10);
+    if (errno == 0 && end != nullptr && *end == '\0' && parsed >= 0) {
+      return Json(static_cast<int>(parsed));
+    }
+  }
+
+  const auto first = value.find_first_not_of(" \t\n\r");
+  if (first != std::string::npos &&
+      (value[first] == '{' || value[first] == '[')) {
+    std::string err;
+    const Json parsed = Json::parse(value, err);
+    if (err.empty()) return parsed;
+  }
+
+  return Json(value);
+}
+
+Json logicalTransferToJson(
+    const deeptools::LayoutAllgatherRestickifyLogicalTransfer &transfer) {
+  Json::object object;
+  object["group"] = std::to_string(transfer.group);
+  object["producer_chunk"] = std::to_string(transfer.producerChunk);
+  object["consumer_replica"] = std::to_string(transfer.consumerReplica);
+  object["source_core"] = std::to_string(transfer.sourceCore);
+  object["destination_core"] = std::to_string(transfer.destinationCore);
+  return object;
+}
+
+std::string metadataFieldsToJsonString(
+    const std::map<std::string, std::string> &fields) {
+  Json::object object;
+  for (const auto &[key, value] : fields) {
+    object[key] = metadataValueToJson(value);
+  }
+  return Json(object).dump();
+}
