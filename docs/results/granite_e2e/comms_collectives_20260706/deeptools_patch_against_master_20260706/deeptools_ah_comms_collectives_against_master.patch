+static std::string dataOpDimName(const DesignSpaceConfig& dldsc,
+                                 PrimaryDimTypes dim) {
+  if (dim == PrimaryDimTypes::IJ) return "i";
+  if (dim == PrimaryDimTypes::KIJ) return "ki";
+  return dldsc.primaryDimToString.at(dim);
+}
+
+static std::map<PrimaryDimTypes, std::set<int>> collectTensorSliceIds(
+    const std::map<int, std::map<PrimaryDimTypes, int>>& coreIdToWkSlice,
+    const std::vector<PrimaryDimTypes>& tensorDims) {
+  std::set<PrimaryDimTypes> tensorDimSet(tensorDims.begin(), tensorDims.end());
+  std::map<PrimaryDimTypes, std::set<int>> result;
+  for (const auto& coreAndSlice : coreIdToWkSlice) {
+    for (const auto& dimAndSlice : coreAndSlice.second) {
+      if (tensorDimSet.count(dimAndSlice.first) == 0) continue;
+      result[dimAndSlice.first].insert(dimAndSlice.second);
+    }
+  }
+  return result;
+}
+
+static void fillDataOpLdsShape(LdsInfo& dataLds, DataOpDsc& ddsc,
+                               const LabeledDsInfo& dldscLds,
+                               const DesignSpaceConfig& dldsc) {
+  dataLds.pdsName_ = "activation";
+  dataLds.wordLength = dldscLds.wordLength;
+  dataLds.df = getDsFormat(dldscLds.wordLength);
+
+  const auto& refDsInfo = dldsc.primaryDsInfo_.at(dldscLds.dsType_);
+  for (const auto& pDim : refDsInfo.layoutDimOrder_) {
+    DT_CHECK_MSG(pDim != PrimaryDimTypes::KIJ,
+                 "matmul_operand_broadcast IFN does not support KIJ layout");
+    const std::string dimName = dataOpDimName(dldsc, pDim);
+    dataLds.layoutDimOrder_.push_back(dimName);
+    ddsc.primaryDs_.at("activation").dimNames.insert(dimName);
+    dataLds.dimToLayoutSize_[dimName] = dldsc.N_.primaryDimToVal_st(pDim);
+    dataLds.validGap_[dimName].push_back(
+        std::make_pair(dataLds.dimToLayoutSize_.at(dimName), 0));
+  }
+
+  DT_CHECK(refDsInfo.stickDimOrder_.size() == refDsInfo.stickSize_.size());
+  DT_CHECK(refDsInfo.stickDimOrder_.size() == refDsInfo.stickRepl_.size());
+  for (int idx = 0; idx < refDsInfo.stickDimOrder_.size(); idx++) {
+    const auto& pDim = refDsInfo.stickDimOrder_.at(idx);
+    DT_CHECK(refDsInfo.stickRepl_.at(idx) == 1);
+    const std::string dimName = dataOpDimName(dldsc, pDim);
+    if (std::find(dataLds.stickDimOrder_.begin(), dataLds.stickDimOrder_.end(),
+                  dimName) == dataLds.stickDimOrder_.end()) {
+      dataLds.stickDimOrder_.push_back(dimName);
+      dataLds.dimToStickSize_[dimName] = refDsInfo.stickSize_.at(idx);
+    } else {
+      dataLds.dimToStickSize_.at(dimName) *= refDsInfo.stickSize_.at(idx);
+    }
+    DT_CHECK(ddsc.primaryDs_.at("activation").dimNames.count(dimName));
+  }
+
+  double totalElements = 1;
+  for (const auto& dimAndSize : dataLds.dimToLayoutSize_) {
+    totalElements *= dimAndSize.second;
+  }
+  dataLds.totElements = totalElements;
+}
+
+static void addLxPiece(LdsInfo& dataLds, const std::string& key, int coreId,
+                       int64_t startAddress,
+                       const std::map<std::string, double>& dimToSize,
+                       const std::map<std::string, double>& dimToStart) {
+  PieceInfo piece;
+  piece.key_ = key;
+  piece.dimToSize_ = dimToSize;
+  piece.dimToStartCordinate = dimToStart;
+  for (const auto& dimAndSize : dimToSize) {
+    piece.validGap_[dimAndSize.first].push_back(
+        std::make_pair(dimAndSize.second, 0));
+  }
+  piece.placement[SenComponents::LX];
+  piece.placement.at(SenComponents::LX).setType(SenComponents::LX);
+  piece.placement.at(SenComponents::LX).insertMemId(coreId);
+  auto& addrHelper = piece.placement.at(SenComponents::LX).StartAddr();
+  FoldDimProp* addrFoldProp = new FoldDimProp{1, "time"};
+  addrHelper.buildMapDim(addrFoldProp, 0);
+  piece.placement.at(SenComponents::LX).insertStAddr(startAddress, {0});
+  const auto existingBase = dataLds.coreIdTolxStartAddress_.find(coreId);
+  if (existingBase == dataLds.coreIdTolxStartAddress_.end() ||
+      startAddress < existingBase->second) {
+    dataLds.coreIdTolxStartAddress_[coreId] = startAddress;
+  }
+  dataLds.pieces_[key] = piece;
+}
+
+static void addLxPieceWithValidSize(
+    LdsInfo& dataLds, const std::string& key, int coreId, int64_t startAddress,
+    const std::map<std::string, double>& physicalDimToSize,
+    const std::map<std::string, double>& dimToStart,
+    const std::map<std::string, double>& validDimToSize) {
+  PieceInfo piece;
+  piece.key_ = key;
+  piece.dimToSize_ = physicalDimToSize;
+  piece.dimToStartCordinate = dimToStart;
+  for (const auto& dimAndSize : physicalDimToSize) {
+    const auto validIt = validDimToSize.find(dimAndSize.first);
+    const double validSize = validIt == validDimToSize.end()
+                                 ? dimAndSize.second
+                                 : validIt->second;
+    DT_CHECK(validSize <= dimAndSize.second);
+    piece.validGap_[dimAndSize.first].push_back(
+        std::make_pair(validSize, dimAndSize.second - validSize));
+  }
+  piece.placement[SenComponents::LX];
+  piece.placement.at(SenComponents::LX).setType(SenComponents::LX);
+  piece.placement.at(SenComponents::LX).insertMemId(coreId);
+  auto& addrHelper = piece.placement.at(SenComponents::LX).StartAddr();
+  FoldDimProp* addrFoldProp = new FoldDimProp{1, "time"};
+  addrHelper.buildMapDim(addrFoldProp, 0);
+  piece.placement.at(SenComponents::LX).insertStAddr(startAddress, {0});
+  const auto existingBase = dataLds.coreIdTolxStartAddress_.find(coreId);
+  if (existingBase == dataLds.coreIdTolxStartAddress_.end() ||
+      startAddress < existingBase->second) {
+    dataLds.coreIdTolxStartAddress_[coreId] = startAddress;
+  }
+  dataLds.pieces_[key] = piece;
+}
+
+static std::map<std::string, double> expandPieceToStickSize(
+    const LdsInfo& dataLds, std::map<std::string, double> dimToSize) {
+  for (const auto& dimAndStick : dataLds.dimToStickSize_) {
+    const auto sizeIt = dimToSize.find(dimAndStick.first);
+    if (sizeIt != dimToSize.end() && sizeIt->second < dimAndStick.second) {
+      sizeIt->second = dimAndStick.second;
+    }
+  }
+  return dimToSize;
+}
+
+static void addReplicatedLxPiece(
+    LdsInfo& dataLds, const std::string& key, const std::vector<int>& coreIds,
+    int64_t startAddress, const std::map<std::string, double>& dimToSize,
+    const std::map<std::string, double>& dimToStart) {
+  DT_CHECK(!coreIds.empty());
+  PieceInfo piece;
+  piece.key_ = key;
+  piece.dimToSize_ = dimToSize;
+  piece.dimToStartCordinate = dimToStart;
+  for (const auto& dimAndSize : dimToSize) {
+    piece.validGap_[dimAndSize.first].push_back(
+        std::make_pair(dimAndSize.second, 0));
+  }
+  piece.placement[SenComponents::LX];
+  piece.placement.at(SenComponents::LX).setType(SenComponents::LX);
+  for (const auto coreId : coreIds) {
+    piece.placement.at(SenComponents::LX).insertMemId(coreId);
+    piece.placement.at(SenComponents::LX).insertStAddr(startAddress);
+    dataLds.coreIdTolxStartAddress_[coreId] = startAddress;
+  }
+  dataLds.pieces_[key] = piece;
+}
+
+static int64_t lxStartAddressForCore(const LabeledDsInfo& lds, int coreId) {
+  const auto memOrgIt = lds.memOrg_.find(SenComponents::LX);
+  if (memOrgIt == lds.memOrg_.end() ||
+      memOrgIt->second.allocateNode_ == nullptr) {
+    return -1;
+  }
+  return memOrgIt->second.allocateNode_->startAddressCoreCorelet_.getData(
+      coreId, 0, 0);
+}
