+std::filesystem::path findRelayoutJson(const std::string& debugDir) {
+  for (const auto& entry : std::filesystem::directory_iterator(debugDir)) {
+    if (!entry.is_directory()) continue;
+    if (entry.path().filename().string().find("-Relayout") == std::string::npos)
+      continue;
+    for (const auto& sub : std::filesystem::directory_iterator(entry.path())) {
+      const auto name = sub.path().filename().string();
+      if (sub.is_regular_file() &&
+          name.size() > std::strlen(".out.out.out.json") &&
+          name.rfind(".out.out.out.json") ==
+              name.size() - std::strlen(".out.out.out.json")) {
+        return sub.path();
+      }
+    }
+  }
+  return {};
+}
