+std::vector<MatmulOperandBroadcastLogicalTransfer>
+matmulOperandBroadcastLogicalTransfers(
+    const MatmulOperandBroadcastMovementPlan &plan) {
+  std::vector<MatmulOperandBroadcastLogicalTransfer> transfers;
+  if (!plan.ok || plan.groupCount == 0 ||
+      plan.producerChunksPerGroup == 0 ||
+      plan.consumerReplicasPerGroup == 0) {
+    return transfers;
+  }
+
+
+  if (!plan.sourceCoresByGroup.empty()) {
+    if (plan.sourceCoresByGroup.size() != plan.destinationCoresByGroup.size()) {
+      return {};
+    }
+    std::uint64_t exactTransferCount = 0;
+    for (std::size_t group = 0; group < plan.sourceCoresByGroup.size();
+         ++group) {
+      if (!checkedAddProduct(plan.sourceCoresByGroup[group].size(),
+                             plan.destinationCoresByGroup[group].size(),
+                             &exactTransferCount)) {
+        return {};
+      }
+    }
+    transfers.reserve(static_cast<std::size_t>(
+        std::min<std::uint64_t>(exactTransferCount, 1000000)));
+    for (std::uint64_t group = 0; group < plan.sourceCoresByGroup.size();
+         ++group) {
+      const auto &sourceCores = plan.sourceCoresByGroup[group];
+      const auto &destinationCores = plan.destinationCoresByGroup[group];
+      for (std::uint64_t producerChunk = 0;
+           producerChunk < sourceCores.size(); ++producerChunk) {
+        for (std::uint64_t consumerReplica = 0;
+             consumerReplica < destinationCores.size(); ++consumerReplica) {
+          transfers.push_back({group, producerChunk, consumerReplica,
+                               sourceCores[producerChunk],
+                               destinationCores[consumerReplica]});
+        }
+      }
+    }
+    return transfers;
+  }
+
+  std::uint64_t compactGroupTransferCount = 0;
+  std::uint64_t compactTransferCount = 0;
+  if (!checkedMul(plan.producerChunksPerGroup,
+                  plan.consumerReplicasPerGroup,
+                  &compactGroupTransferCount) ||
+      !checkedMul(plan.groupCount, compactGroupTransferCount,
+                  &compactTransferCount)) {
+    return transfers;
+  }
+  transfers.reserve(static_cast<std::size_t>(
+      std::min<std::uint64_t>(compactTransferCount, 1000000)));
+  for (std::uint64_t group = 0; group < plan.groupCount; ++group) {
+    for (std::uint64_t producerChunk = 0;
+         producerChunk < plan.producerChunksPerGroup; ++producerChunk) {
+      const std::uint64_t sourceCore =
+          group * plan.producerChunksPerGroup + producerChunk;
+      for (std::uint64_t consumerReplica = 0;
+           consumerReplica < plan.consumerReplicasPerGroup;
+           ++consumerReplica) {
+        const std::uint64_t destinationCore =
+            group * plan.consumerReplicasPerGroup + consumerReplica;
+        transfers.push_back({group, producerChunk, consumerReplica, sourceCore,
+                             destinationCore});
+      }
+    }
+  }
+  return transfers;
+}
