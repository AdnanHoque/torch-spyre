+MatmulOperandBroadcastMovementPlan
+synthesizeMatmulOperandBroadcastMovementPlan(const std::string &jsonString) {
+  std::string err;
+  const Json json = Json::parse(jsonString, err);
+  if (!err.empty()) {
+    return matmulMovementFail("invalid json: " + err);
+  }
+  if (!json.is_object()) {
+    return matmulMovementFail("contract must be a json object");
+  }
+
+  const std::string pattern = json["communication_pattern"].string_value();
+  if (!isSupportedMatmulOperandCommunicationPattern(pattern)) {
+    return matmulMovementFail(
+        "communication_pattern must be all_gather_replicate, broadcast, or "
+        "multicast");
+  }
+  const std::string rawKind = json["kind"].string_value();
+  if (!rawKind.empty() && rawKind != "matmul_operand_broadcast") {
+    return matmulMovementFail("kind must be matmul_operand_broadcast");
+  }
+  const std::string kind = rawKind.empty() ? "matmul_operand_broadcast" : rawKind;
+  const std::string materializationPattern =
+      json["materialization_pattern"].string_value();
+  if (!materializationPattern.empty() &&
+      materializationPattern !=
+          "all_gather_replicate_with_layout_conversion") {
+    return matmulMovementFail(
+        "materialization_pattern must be "
+        "all_gather_replicate_with_layout_conversion when present");
+  }
+  const bool requiresLayoutConversion =
+      json["requires_layout_conversion"].bool_value();
+  if (requiresLayoutConversion && !json["layout_transform"].is_object()) {
+    return matmulMovementFail(
+        "requires_layout_conversion needs layout_transform metadata");
+  }
+  if (requiresLayoutConversion && !json["source_lx_tensor"].is_object()) {
+    return matmulMovementFail(
+        "requires_layout_conversion needs source_lx_tensor metadata");
+  }
+  if (requiresLayoutConversion && !json["target_kernel_tensor"].is_object()) {
+    return matmulMovementFail(
+        "requires_layout_conversion needs target_kernel_tensor metadata");
+  }
+  if (requiresLayoutConversion && !json["staged_destination"].is_object()) {
+    return matmulMovementFail(
+        "requires_layout_conversion needs staged_destination metadata");
+  }
+  const std::int64_t operandIndex =
+      signedIntFieldForAnyKey(json, {"operand_index", "read_index"});
+  if (operandIndex < 0) {
+    return matmulMovementFail(
+        "operand_index or read_index must identify the matmul operand");
+  }
+
+  std::uint64_t sourceCoreCount = explicitCountOrSplitProduct(
+      json, "producer_core_count", "producer_work_slice_dims");
+  if (sourceCoreCount == 0) {
+    return matmulMovementFail(
+        "producer_core_count or producer_work_slice_dims must be non-zero");
+  }
+
+  std::uint64_t consumerCoreCount = positiveUintField(json,
+                                                      "consumer_core_count");
+  if (consumerCoreCount == 0) {
+    consumerCoreCount = splitProduct(json["consumer_work_slice_dims"]);
+  }
+  if (consumerCoreCount == 0) {
+    return matmulMovementFail(
+        "consumer_core_count or consumer_work_slice_dims must be non-zero");
+  }
+
+  const std::string dsType = json["consumer_operand_ds_type"].is_string()
+                                 ? json["consumer_operand_ds_type"].string_value()
+                                 : "KERNEL";
+  if (dsType != "KERNEL") {
+    return matmulMovementFail(
+        "consumer_operand_ds_type must be KERNEL for matmul operand broadcast");
+  }
+
+  const bool realized = json["realized"].bool_value();
+  const std::string realizationStrategy =
+      json["realization_strategy"].string_value();
+  if (realized &&
+      !isSupportedMatmulOperandBroadcastRealization(realizationStrategy)) {
+    return matmulMovementFail(
+        "realized matmul_operand_broadcast requires "
+        "loop_scoped_input_fetch or gather_then_restickify");
+  }
+  if (!realizationStrategy.empty() &&
+      !isSupportedMatmulOperandBroadcastRealization(realizationStrategy)) {
+    return matmulMovementFail(
+        "matmul_operand_broadcast realization_strategy must be "
+        "loop_scoped_input_fetch or gather_then_restickify");
+  }
+
+  std::uint64_t groupCount =
+      positiveUintFieldForAnyKey(json, {"group_count", "broadcast_group_count"});
+  if (groupCount == 0) {
+    groupCount = splitProduct(json["consumer_tensor_work_slice_dims"]);
+  }
+  if (groupCount == 0 && json["grouped_fanout"].is_object()) {
+    groupCount = positiveUintField(json["grouped_fanout"], "group_count");
+  }
+  if (groupCount == 0) groupCount = 1;
+  if (sourceCoreCount % groupCount != 0 ||
+      consumerCoreCount % groupCount != 0) {
+    return matmulMovementFail(
+        "source and consumer core counts must be divisible by group_count");
+  }
+  const auto exactGroupedCoreMaps = deriveExactGroupedCoreMaps(json);
+  std::uint64_t exactLogicalTransferCount = 0;
+  for (std::size_t group = 0;
+       group < exactGroupedCoreMaps.sourceCoresByGroup.size(); ++group) {
+    if (group >= exactGroupedCoreMaps.destinationCoresByGroup.size()) {
+      exactLogicalTransferCount = 0;
+      break;
+    }
+    exactLogicalTransferCount +=
+        exactGroupedCoreMaps.sourceCoresByGroup[group].size() *
+        exactGroupedCoreMaps.destinationCoresByGroup[group].size();
+  }
+
+  MatmulOperandBroadcastMovementPlan plan;
+  plan.ok = true;
+  plan.reason = "ok";
+  plan.kind = kind;
+  plan.communicationPattern = pattern;
+  plan.materializationPattern = materializationPattern;
+  plan.realizationStrategy = realizationStrategy.empty()
+                                 ? "loop_scoped_input_fetch"
+                                 : realizationStrategy;
+  plan.consumerOperandDsType = dsType;
+  plan.requiresLayoutConversion = requiresLayoutConversion;
+  if (json["layout_transform"].is_object()) {
+    plan.layoutTransformJson = json["layout_transform"].dump();
+  }
+  if (json["source_lx_tensor"].is_object()) {
+    plan.sourceLxTensorJson = json["source_lx_tensor"].dump();
+  }
+  if (json["target_kernel_tensor"].is_object()) {
+    plan.targetKernelTensorJson = json["target_kernel_tensor"].dump();
+  }
+  if (json["staged_destination"].is_object()) {
+    plan.stagedDestinationJson = json["staged_destination"].dump();
+  }
+  plan.realized = realized;
+  plan.operandIndex = operandIndex;
+  plan.sourceCoreCount = sourceCoreCount;
+  plan.consumerCoreCount = consumerCoreCount;
+  plan.groupCount = groupCount;
+  plan.producerChunksPerGroup = sourceCoreCount / groupCount;
+  plan.consumerReplicasPerGroup = consumerCoreCount / groupCount;
+  plan.replicationFactor = plan.consumerReplicasPerGroup;
+  plan.logicalTransferCount = groupCount * plan.producerChunksPerGroup *
+                              plan.consumerReplicasPerGroup;
+  if (exactLogicalTransferCount != 0) {
+    plan.sourceCoresByGroup = exactGroupedCoreMaps.sourceCoresByGroup;
+    plan.destinationCoresByGroup =
+        exactGroupedCoreMaps.destinationCoresByGroup;
+    plan.groupCount = plan.sourceCoresByGroup.size();
+    plan.producerChunksPerGroup = plan.sourceCoresByGroup.front().size();
+    plan.consumerReplicasPerGroup = plan.destinationCoresByGroup.front().size();
+    plan.replicationFactor = plan.consumerReplicasPerGroup;
+    plan.logicalTransferCount = exactLogicalTransferCount;
+  }
+  if (pattern == "broadcast") {
+    if (plan.groupCount != 1 || plan.producerChunksPerGroup != 1) {
+      return matmulMovementFail(
+          "broadcast requires one source chunk in one destination group");
+    }
+  }
+  if (pattern == "multicast" && plan.producerChunksPerGroup != 1) {
+    return matmulMovementFail(
+        "multicast requires one source chunk per destination group");
+  }
+  if ((pattern == "broadcast" || pattern == "multicast") &&
+      !plan.sourceCoresByGroup.empty()) {
+    for (const auto &sourceCores : plan.sourceCoresByGroup) {
+      if (sourceCores.size() != 1) {
+        return matmulMovementFail(
+            pattern + " requires exactly one source core per group");
+      }
+    }
+  }
+  plan.estimatedTensorBytes =
+      positiveUintFieldForAnyKey(json, {"estimated_tensor_bytes",
+                                        "tensor_bytes",
+                                        "source_bytes"});
+  plan.stages = {"source_operand_shards",
+                 stageForMatmulOperandCommunicationPattern(pattern)};
+  if (plan.requiresLayoutConversion ||
+      plan.realizationStrategy == "gather_then_restickify") {
+    plan.stages.push_back("local_layout_conversion");
+  }
+  plan.stages.push_back(plan.realizationStrategy);
+  plan.stages.push_back("bind_matmul_kernel_operand");
+  return plan;
+}
