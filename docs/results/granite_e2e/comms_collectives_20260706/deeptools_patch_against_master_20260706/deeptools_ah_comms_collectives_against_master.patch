+void rewriteCoreWorkDivRelayoutFixture(
+    const std::string& testDataDir,
+    const json11::Json::object& producerCoreIdToWkSlice,
+    const json11::Json::object& consumerCoreIdToWkSlice) {
+  const auto path = std::filesystem::path(testDataDir) / "test-scale.json";
+  std::ifstream jsonIn(path);
+  std::ostringstream jsonBuf;
+  jsonBuf << jsonIn.rdbuf();
+  std::string err;
+  auto json = json11::Json::parse(jsonBuf.str(), err);
+  ASSERT_TRUE(err.empty()) << "Failed to parse " << path << ": " << err;
+  ASSERT_TRUE(json.is_object());
+  ASSERT_EQ(json.object_items().size(), 1);
+
+  auto top = json.object_items();
+  const auto sdscName = top.begin()->first;
+  auto sdsc = top.begin()->second.object_items();
+  const int consumerCoreCount = static_cast<int>(consumerCoreIdToWkSlice.size());
+
+  sdsc["numCoresUsed_"] = consumerCoreCount;
+  sdsc["numWkSlicesPerDim_"] = json11::Json::object{
+      {"out", 1}, {"mb", 1}, {"y", consumerCoreCount == 1 ? 1 : 4}};
+  sdsc["coreIdToWkSlice_"] = consumerCoreIdToWkSlice;
+
+  json11::Json::object coreIdToDsc;
+  json11::Json::object coreIdToDscSchedule;
+  const auto oldSchedule = sdsc["coreIdToDscSchedule"].object_items().begin()->second;
+  for (const auto& [core, _slice] : consumerCoreIdToWkSlice) {
+    coreIdToDsc[core] = 0;
+    coreIdToDscSchedule[core] = oldSchedule;
+  }
+  sdsc["coreIdToDsc_"] = coreIdToDsc;
+  sdsc["coreIdToDscSchedule"] = coreIdToDscSchedule;
+
+  auto dscs = sdsc["dscs_"].array_items();
+  ASSERT_EQ(dscs.size(), 1u);
+  auto dscEntry = dscs.at(0).object_items();
+  ASSERT_EQ(dscEntry.size(), 1u);
+  const auto dscName = dscEntry.begin()->first;
+  auto dsc = dscEntry.begin()->second.object_items();
+  dsc["numCoresUsed_"] = consumerCoreCount;
+  json11::Json::array consumerCores;
+  for (const auto& [core, _slice] : consumerCoreIdToWkSlice) {
+    consumerCores.push_back(std::stoi(core));
+  }
+  dsc["coreIdsUsed_"] = consumerCores;
+
+  auto scheduleTree = dsc["scheduleTree_"].array_items();
+  for (auto& node : scheduleTree) {
+    auto nodeObj = node.object_items();
+    auto coordObj = nodeObj["coordinates_"].object_items();
+    if (!coordObj["coreIdToWkSlice_"].object_items().empty()) {
+      coordObj["coreIdToWkSlice_"] = producerCoreIdToWkSlice;
+      nodeObj["coordinates_"] = coordObj;
+      node = nodeObj;
+    }
+  }
+  dsc["scheduleTree_"] = scheduleTree;
+  dscs.at(0) = json11::Json::object{{dscName, dsc}};
+  sdsc["dscs_"] = dscs;
+
+  top[sdscName] = sdsc;
+  std::ofstream jsonOut(path);
+  jsonOut << json11::Json(top).dump() << std::endl;
+}
