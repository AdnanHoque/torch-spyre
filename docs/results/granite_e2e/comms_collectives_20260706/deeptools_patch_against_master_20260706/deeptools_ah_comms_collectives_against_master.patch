+
+json11::Json::object makeCoreMap(
+    std::initializer_list<std::pair<int, json11::Json::object>> cores) {
+  json11::Json::object result;
+  for (const auto& [core, slice] : cores) result[std::to_string(core)] = slice;
+  return result;
+}
