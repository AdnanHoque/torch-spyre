+std::vector<int> collectMemIds(const json11::Json& lds) {
+  std::vector<int> ids;
+  for (const auto& piece : lds["PieceInfo"].array_items()) {
+    const auto& placements = piece["PlacementInfo"].array_items();
+    for (const auto& placement : placements) {
+      const auto& memId = placement["memId"];
+      EXPECT_TRUE(memId.is_array());
+      EXPECT_FALSE(memId.array_items().empty());
+      if (memId.is_array() && !memId.array_items().empty()) {
+        ids.push_back(memId.array_items().at(0).int_value());
+      }
+    }
+  }
+  std::sort(ids.begin(), ids.end());
+  return ids;
+}
