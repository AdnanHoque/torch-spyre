+bool seedLxNeighborAllocationFromFoldedPeer(DesignSpaceConfig *currDsc,
+                                            dsc2::AllocateNode *allocNode) {
+  return false;
+  if (currDsc == nullptr || allocNode == nullptr ||
+      allocNode->component_ != SenComponents::LX ||
+      allocNode->name_.find("allocate_lds") == std::string::npos ||
+      allocNode->allocateCoordinates_.foldConstructed()) {
+    return false;
+  }
+  auto allocNodes = currDsc->scheduleTree_.traverseTreeDFSMutable(
+      nullptr, {dsc2::ScheduleNode::ALLOCATE});
+  for (auto *node : allocNodes) {
+    auto *peer = dynamic_cast<dsc2::AllocateNode *>(node);
+    if (peer == nullptr || peer == allocNode || peer->ldsIdx_ != allocNode->ldsIdx_ ||
+        peer->component_ != SenComponents::LX ||
