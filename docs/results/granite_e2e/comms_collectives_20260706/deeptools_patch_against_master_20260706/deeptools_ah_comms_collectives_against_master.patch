+static MatmulOperandBroadcastHookPlan applyMatmulOperandBroadcastDebugLimits(
+    const MatmulOperandBroadcastHookPlan& hook,
+    std::map<std::string, std::string>* debugContext) {
+  auto limitedHook = hook;
+  const int maxDstCores = getPositiveDebugEnvInt(
+      "DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_DST_CORES");
+  if (maxDstCores <= 0) return limitedHook;
+
+  if (!limitedHook.plan.destinationCoresByGroup.empty()) {
+    std::vector<std::vector<std::uint64_t>> limitedSourceCoresByGroup;
+    std::vector<std::vector<std::uint64_t>> limitedDestinationCoresByGroup;
+    std::set<std::uint64_t> sourceCoreSet;
+    std::set<std::uint64_t> destinationCoreSet;
+    std::uint64_t logicalTransfers = 0;
+    std::uint64_t maxSourcesPerGroup = 0;
+    std::uint64_t maxDestinationsPerGroup = 0;
+    int remainingDstCores = maxDstCores;
+
+    for (std::size_t group = 0;
+         group < limitedHook.plan.destinationCoresByGroup.size() &&
+         remainingDstCores > 0;
+         ++group) {
+      const auto& sourceCores = limitedHook.plan.sourceCoresByGroup.at(group);
+      const auto& destinationCores =
+          limitedHook.plan.destinationCoresByGroup.at(group);
+      if (sourceCores.empty() || destinationCores.empty()) continue;
+      const int take = std::min<int>(remainingDstCores, destinationCores.size());
+      std::vector<std::uint64_t> limitedDestinationCores(
+          destinationCores.begin(), destinationCores.begin() + take);
+      limitedSourceCoresByGroup.push_back(sourceCores);
+      limitedDestinationCoresByGroup.push_back(limitedDestinationCores);
+      sourceCoreSet.insert(sourceCores.begin(), sourceCores.end());
+      destinationCoreSet.insert(limitedDestinationCores.begin(),
+                                limitedDestinationCores.end());
+      logicalTransfers += sourceCores.size() * limitedDestinationCores.size();
+      maxSourcesPerGroup = std::max<std::uint64_t>(maxSourcesPerGroup,
+                                                  sourceCores.size());
+      maxDestinationsPerGroup = std::max<std::uint64_t>(
+          maxDestinationsPerGroup, limitedDestinationCores.size());
+      remainingDstCores -= take;
+    }
+
+    limitedHook.plan.sourceCoresByGroup = limitedSourceCoresByGroup;
+    limitedHook.plan.destinationCoresByGroup = limitedDestinationCoresByGroup;
+    limitedHook.plan.groupCount = limitedDestinationCoresByGroup.size();
+    limitedHook.plan.sourceCoreCount = sourceCoreSet.size();
+    limitedHook.plan.consumerCoreCount = destinationCoreSet.size();
+    limitedHook.plan.producerChunksPerGroup = maxSourcesPerGroup;
+    limitedHook.plan.consumerReplicasPerGroup = maxDestinationsPerGroup;
+    limitedHook.plan.replicationFactor = maxDestinationsPerGroup;
+    limitedHook.plan.logicalTransferCount = logicalTransfers;
+    if (debugContext != nullptr) {
+      (*debugContext)["debug_limit_mode"] = "exact_core_groups";
+      (*debugContext)["debug_effective_destination_cores"] =
+          std::to_string(destinationCoreSet.size());
+      (*debugContext)["debug_effective_logical_transfers"] =
+          std::to_string(logicalTransfers);
+    }
+    return limitedHook;
+  }
+
+  if (limitedHook.plan.groupCount == 0 ||
+      limitedHook.plan.consumerReplicasPerGroup == 0) {
+    return limitedHook;
+  }
+
+  const std::uint64_t requestedDst = static_cast<std::uint64_t>(maxDstCores);
+  const std::uint64_t oldReplicas = limitedHook.plan.consumerReplicasPerGroup;
+  const std::uint64_t newGroups =
+      std::max<std::uint64_t>(1, (requestedDst + oldReplicas - 1) / oldReplicas);
+  limitedHook.plan.groupCount =
+      std::min<std::uint64_t>(limitedHook.plan.groupCount, newGroups);
+  if (requestedDst < oldReplicas) {
+    limitedHook.plan.consumerReplicasPerGroup = requestedDst;
+  }
+  limitedHook.plan.consumerCoreCount = std::min<std::uint64_t>(
+      limitedHook.plan.consumerCoreCount, requestedDst);
+  limitedHook.plan.replicationFactor = limitedHook.plan.consumerReplicasPerGroup;
+  limitedHook.plan.sourceCoreCount = std::min<std::uint64_t>(
+      limitedHook.plan.sourceCoreCount,
+      limitedHook.plan.groupCount * limitedHook.plan.producerChunksPerGroup);
+  limitedHook.plan.logicalTransferCount =
+      limitedHook.plan.groupCount * limitedHook.plan.producerChunksPerGroup *
+      limitedHook.plan.consumerReplicasPerGroup;
+  if (debugContext != nullptr) {
+    (*debugContext)["debug_limit_mode"] = "compact_group_counts";
+    (*debugContext)["debug_effective_destination_cores"] =
+        std::to_string(limitedHook.plan.consumerCoreCount);
+    (*debugContext)["debug_effective_logical_transfers"] =
+        std::to_string(limitedHook.plan.logicalTransferCount);
+  }
+  return limitedHook;
+}
