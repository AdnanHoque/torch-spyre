+namespace {
+DsTypes inferInputFetchMainDsType(const SuperDsc& mySDscMain,
+                                  const DataOpDsc* ddsc) {
+  const auto& dsc = mySDscMain.dscs_.at(0);
+  if (ddsc != nullptr && ddsc->labeledDs_.size() >= 2) {
+    const std::string& outLdsName = ddsc->labeledDs_.back().ldsName_;
+    for (const auto& lds : dsc.labeledDs_) {
+      if (lds.dsName_ == outLdsName &&
+          dsc.primaryDsInfo_.count(lds.dsType_) != 0) {
+        return lds.dsType_;
+      }
+    }
+  }
+
+  if (dsc.primaryDsInfo_.count(DsTypes::INPUT) != 0) {
+    return DsTypes::INPUT;
+  }
+  DT_CHECK(false && "InputFetchNeighbor could not infer consumer operand type");
+  return DsTypes::INPUT;
+}
