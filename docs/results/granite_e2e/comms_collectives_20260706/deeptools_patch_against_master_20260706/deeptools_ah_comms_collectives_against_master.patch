+TEST(LayoutAllgatherRestickify, movementPlanRejectsIncompleteRename) {
+  const auto contract = replaceFirst(
+      validFlashContract(),
+      R"json("restickify.x": "batchmatmul.out")json",
+      R"json("restickify.x": "not_batchmatmul.out")json");
+
+  const auto plan =
+      deeptools::synthesizeLayoutAllgatherRestickifyMovementPlan(contract);
+
+  EXPECT_FALSE(plan.ok);
