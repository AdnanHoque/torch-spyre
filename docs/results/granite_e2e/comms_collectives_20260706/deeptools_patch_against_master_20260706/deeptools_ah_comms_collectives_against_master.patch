+static void emitLayoutAllgatherRestickifyPlanArtifact(
+    const SuperDsc* sdsc, const LabeledDsInfo& lds, int ps,
+    const LayoutAllgatherRestickifyHookPlan& hook) {
+  const auto& plan = hook.plan;
+  const char* outputDirEnv =
+      std::getenv("DEEPTOOLS_LAYOUT_ALLGATHER_RESTICKIFY_PLAN_DIR");
+  const std::filesystem::path outputDir =
+      outputDirEnv == nullptr ? std::filesystem::path(".")
+                              : std::filesystem::path(outputDirEnv);
+  std::filesystem::create_directories(outputDir);
+
+  const std::string fileName = sanitizeArtifactName(
+      sdsc->name_ + "_" + lds.dsName_ + "_" + hook.classificationKey +
+      "_layout_allgather_restickify_plan.json");
+  const auto outputPath = outputDir / fileName;
+
+  std::map<std::string, std::string> context = {
+      {"schema_version", "1"},
+      {"mutation_point",
+       "Dxp::insertRelayoutSdsc after LX pinned input coordinate mismatch"},
+      {"sdsc_name", sdsc->name_},
+      {"input_labeled_ds", lds.dsName_},
+      {"classification_key", hook.classificationKey},
+      {"program_step", std::to_string(ps)},
+  };
+  if (plan.ok) {
+    context["realized"] = "true";
+    context["realization"] =
+        "validated as layout_allgather_restickify, then lowered through the "
+        "generic STCDPOpLx LX relayout insertion path";
+  } else {
+    context["realized"] = "false";
+    context["physical_lowering_status"] = "invalid_metadata";
+    context["failure_reason"] = plan.reason;
+    context["fallback_policy"] =
+        "fail closed instead of emitting zero-transfer realized artifacts";
+  }
+
+  std::ofstream out(outputPath);
+  DT_CHECK_MSG(out.good(),
+               "Failed to open layout_allgather_restickify plan artifact: " +
+                   outputPath.string());
+  out << deeptools::layoutAllgatherRestickifyMovementPlanArtifactJson(
+             plan, context)
+      << std::endl;
+}
+
+static void emitMatmulOperandBroadcastPlanArtifact(
+    const SuperDsc* sdsc, const LabeledDsInfo& lds, int ps,
+    const MatmulOperandBroadcastHookPlan& hook,
+    bool kernelNeighborLowered = false,
+    bool gatherRestickifyLowered = false,
+    const std::map<std::string, std::string>& extraContext = {}) {
+  auto plan = hook.plan;
+  if (kernelNeighborLowered) {
+    plan.realized = true;
+    plan.realizationStrategy = "loop_scoped_input_fetch";
+  } else if (gatherRestickifyLowered) {
+    plan.realized = true;
+    plan.realizationStrategy = "gather_then_restickify";
+  }
+  const char* outputDirEnv =
+      std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_PLAN_DIR");
+  const std::filesystem::path outputDir =
+      outputDirEnv == nullptr ? std::filesystem::path(".")
+                              : std::filesystem::path(outputDirEnv);
+  std::filesystem::create_directories(outputDir);
+
+  const std::string fileName = sanitizeArtifactName(
+      sdsc->name_ + "_" + lds.dsName_ + "_" + hook.classificationKey +
+      "_matmul_operand_broadcast_plan.json");
+  const auto outputPath = outputDir / fileName;
+
+  std::map<std::string, std::string> context = {
+      {"schema_version", "1"},
+      {"mutation_point",
+       "Dxp::insertRelayoutSdsc after LX pinned input coordinate mismatch"},
+      {"sdsc_name", sdsc->name_},
+      {"input_labeled_ds", lds.dsName_},
+      {"classification_key", hook.classificationKey},
+      {"program_step", std::to_string(ps)},
+  };
+  if (kernelNeighborLowered) {
+    context["realized"] = "true";
+    context["physical_lowering_status"] =
+        "lowered_loop_scoped_kernel_neighbor";
+    context["realization"] =
+        "marked as a loop-scoped KERNEL-neighbor matmul operand; DCC schedules "
+        "the LX-neighbor transfer inside the matmul transfer loop";
+    context["fallback_policy"] =
+        "refuse resident HBM/full per-consumer operand materialization";
+  } else if (gatherRestickifyLowered) {
+    context["realized"] = "true";
+    context["physical_lowering_status"] =
+        "lowered_gather_then_restickify";
+    context["realization"] =
+        "emitted STCDPOpLx grouped gather into temporary LX pieces, then "
+        "ReStickifyOpLx into the matmul KERNEL operand layout before compute";
+    context["fallback_policy"] =
+        "use HBM fallback only if temporary LX allocation or layout metadata is "
+        "insufficient";
+  } else {
+    context["realized"] = "false";
+    context["physical_lowering_status"] = "blocked";
+    context["first_failing_boundary"] =
+        "loop-scoped IFN/STCDP metadata exists, but DCC cannot yet fuse the IFN "
+        "movement and DL matmul PCFG for one consumer schedule step";
+    context["fallback_policy"] =
+        "refuse resident HBM/full per-consumer operand materialization";
+  }
+  for (const auto& [key, value] : extraContext) context[key] = value;
+
+  std::ofstream out(outputPath);
+  DT_CHECK_MSG(out.good(),
+               "Failed to open matmul_operand_broadcast plan artifact: " +
+                   outputPath.string());
+  out << deeptools::matmulOperandBroadcastMovementPlanArtifactJson(plan,
+                                                                   context)
+      << std::endl;
+}
