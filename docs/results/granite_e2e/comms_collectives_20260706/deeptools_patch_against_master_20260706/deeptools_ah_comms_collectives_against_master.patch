+        peer->allocateCoordinates_.coordinates_.empty()) {
+      continue;
+    }
+    allocNode->allocateCoordinates_ = peer->allocateCoordinates_;
+    allocNode->allocateCoordinates_.completeFoldConstruction();
+    return true;
+  }
+  return false;
+}
