 static std::string sanitizeArtifactName(std::string value) {
   for (char& ch : value) {
     const auto c = static_cast<unsigned char>(ch);
     if (!std::isalnum(c) && ch != '-' && ch != '_' && ch != '.') ch = '_';
   }
   return value;
 }
 
 static std::string getDebugEnvString(const char* name) {
   const char* value = std::getenv(name);
   return value == nullptr ? std::string() : std::string(value);
 }
 
 static int getPositiveDebugEnvInt(const char* name) {
   const char* value = std::getenv(name);
   if (value == nullptr || value[0] == '\0') return -1;
   char* end = nullptr;
   const long parsed = std::strtol(value, &end, 10);
   if (end == value || (end != nullptr && *end != '\0') || parsed <= 0) {
     return -1;
   }
   return static_cast<int>(parsed);
 }
 
