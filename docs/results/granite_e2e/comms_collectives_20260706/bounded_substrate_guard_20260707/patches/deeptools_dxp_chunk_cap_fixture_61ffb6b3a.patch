 #include <vector>
 
 #include "dsc/designSpaceConfig.h"
+#include "util/dt_exception.hpp"
 
 // Test fixture for DXP tests that need temporary test data directories
 class DxpTestFixture : public ::testing::Test {
@@ -833,6 +834,66 @@ TEST_F(DxpTestFixture, LoopExecSencore1Bundle) {
   // Cleanup is handled by TearDown()
 }
 
+
+TEST_F(DxpTestFixture, MatmulOperandBroadcastChunkCapFailsClosed) {
+  SetUpTestData("test_matmul_operand_broadcast_chunk_cap");
+
+  struct ScopedEnv {
+    explicit ScopedEnv(const char* name) : name(name) {
+      const char* value = getenv(name);
+      if (value != nullptr) {
+        hadValue = true;
+        oldValue = value;
+      }
+    }
+
+    ~ScopedEnv() {
+      if (hadValue) {
+        setenv(name.c_str(), oldValue.c_str(), 1);
+      } else {
+        unsetenv(name.c_str());
+      }
+    }
+
+    std::string name;
+    bool hadValue = false;
+    std::string oldValue;
+  };
+
+  ScopedEnv restoreEnable(
+      "DEEPTOOLS_ENABLE_MATMUL_OPERAND_GATHER_RESTICKIFY");
+  ScopedEnv restoreCap("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_CHUNKS");
+  ScopedEnv restoreFrac("DXP_LX_FRAC_AVAIL");
+
+  setenv("DEEPTOOLS_ENABLE_MATMUL_OPERAND_GATHER_RESTICKIFY", "1", 1);
+  setenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_CHUNKS", "1", 1);
+  setenv("DXP_LX_FRAC_AVAIL", "1", 1);
+
+  SenTargets target = SenTargets::SENTIENT;
+  DesignSpaceConfigGlobal dscGlobal(target);
+  Dxp dxp(dscGlobal);
+  dxp.standalone = true;
+  dxp.debug = true;
+
+  try {
+    dxp.runDxp(testDataDir);
+    FAIL() << "Expected oversized matmul operand relayout to fail closed";
+  } catch (const DtException& ex) {
+    const std::string message = ex.what();
+    EXPECT_NE(message.find("matmul operand gather/restickify requires"),
+              std::string::npos)
+        << message;
+    EXPECT_NE(
+        message.find(
+            "exceeding DEEPTOOLS_MATMUL_OPERAND_BROADCAST_MAX_CHUNKS=1"),
+        std::string::npos)
+        << message;
+    EXPECT_NE(message.find("Refusing to truncate movement"),
+              std::string::npos)
+        << message;
+  }
+}
+
