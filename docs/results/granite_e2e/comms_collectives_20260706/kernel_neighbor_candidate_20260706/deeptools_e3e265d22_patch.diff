diff --git a/dcg/dcg_fe/pcfg_gen/inputNeighFetchOp.cpp b/dcg/dcg_fe/pcfg_gen/inputNeighFetchOp.cpp
index 2623f113b..d10aa8343 100644
--- a/dcg/dcg_fe/pcfg_gen/inputNeighFetchOp.cpp
+++ b/dcg/dcg_fe/pcfg_gen/inputNeighFetchOp.cpp
@@ -114,8 +114,12 @@ void DcgFE::checkDLDSCForInputFetchNeighborOp(const SuperDsc& mySDscMain,
     const auto& dscMain_ = mySDscMain.dscs_.at(0);
     const bool allowMixedHbmIfnDiagnostic =
         std::getenv("DEEPTOOLS_ALLOW_MIXED_HBM_IFN_DIAGNOSTIC") != nullptr;
+    const bool isMatmulOperandBroadcastKernelNeighbor =
+        std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_KERNEL_NEIGHBOR") !=
+        nullptr;
     for (auto& lds : dscMain_.labeledDs_) {
