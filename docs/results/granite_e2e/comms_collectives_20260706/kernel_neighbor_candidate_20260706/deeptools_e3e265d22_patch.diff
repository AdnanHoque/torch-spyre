+      if (!allowMixedHbmIfnDiagnostic &&
+          !isMatmulOperandBroadcastKernelNeighbor) {
         DT_CHECK(!is_any_of(lds.pinnedComponent(), HBM, NO_COMPONENT));
       }
     }
