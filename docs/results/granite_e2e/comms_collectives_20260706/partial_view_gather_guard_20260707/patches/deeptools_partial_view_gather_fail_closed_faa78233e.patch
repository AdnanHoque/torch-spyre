+void rewritePartialViewGatherFixture(const std::string& testDataDir) {
+  const auto path = std::filesystem::path(testDataDir) / "sdsc_20.json";
+  std::ifstream jsonIn(path);
+  std::ostringstream jsonBuf;
+  jsonBuf << jsonIn.rdbuf();
+  std::string err;
+  auto json = json11::Json::parse(jsonBuf.str(), err);
+  ASSERT_TRUE(err.empty()) << "Failed to parse " << path << ": " << err;
+  ASSERT_TRUE(json.is_object());
+  ASSERT_EQ(json.object_items().size(), 1);
+
+  auto top = json.object_items();
+  const auto sdscName = top.begin()->first;
+  auto sdsc = top.begin()->second.object_items();
+  auto classifications = sdsc["lxRelayoutClassifications_"].array_items();
+  ASSERT_FALSE(classifications.empty());
+  auto classification = classifications.at(0).object_items();
+
+  classification["kind"] = "partial_view_gather";
+  classification["classification"] = "partial_view_gather";
+  classification["communication_pattern"] = "partial_view_gather";
+  classification["materialization_pattern"] = "partial_view_gather_to_lx";
+  classification["source_offset_elems"] = "12800";
+  classification["requires_staged_realization"] = true;
+  classification["read_index"] = 1;
+
+  classifications.at(0) = classification;
+  sdsc["lxRelayoutClassifications_"] = classifications;
+  top[sdscName] = sdsc;
+
+  std::ofstream jsonOut(path);
+  jsonOut << json11::Json(top).dump() << std::endl;
+}
