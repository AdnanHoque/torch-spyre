+static void addLxPieceWithValidSize(
+    LdsInfo& dataLds, const std::string& key, int coreId, int64_t startAddress,
+    const std::map<std::string, double>& physicalDimToSize,
+    const std::map<std::string, double>& dimToStart,
+    const std::map<std::string, double>& validDimToSize) {
+  PieceInfo piece;
+  piece.key_ = key;
+  piece.dimToSize_ = physicalDimToSize;
+  piece.dimToStartCordinate = dimToStart;
+  for (const auto& dimAndSize : physicalDimToSize) {
+    const auto validIt = validDimToSize.find(dimAndSize.first);
+    const double validSize = validIt == validDimToSize.end()
+                                 ? dimAndSize.second
+                                 : validIt->second;
+    DT_CHECK(validSize <= dimAndSize.second);
+    piece.validGap_[dimAndSize.first].push_back(
+        std::make_pair(validSize, dimAndSize.second - validSize));
+  }
+  piece.placement[SenComponents::LX];
+  piece.placement.at(SenComponents::LX).setType(SenComponents::LX);
+  piece.placement.at(SenComponents::LX).insertMemId(coreId);
+  auto& addrHelper = piece.placement.at(SenComponents::LX).StartAddr();
+  FoldDimProp* addrFoldProp = new FoldDimProp{1, "time"};
+  addrHelper.buildMapDim(addrFoldProp, 0);
+  piece.placement.at(SenComponents::LX).insertStAddr(startAddress, {0});
+  const auto existingBase = dataLds.coreIdTolxStartAddress_.find(coreId);
+  if (existingBase == dataLds.coreIdTolxStartAddress_.end() ||
+      startAddress < existingBase->second) {
+    dataLds.coreIdTolxStartAddress_[coreId] = startAddress;
+  }
+  dataLds.pieces_[key] = piece;
+}
+
+static std::map<std::string, double> expandPieceToStickSize(
+    const LdsInfo& dataLds, std::map<std::string, double> dimToSize) {
+  for (const auto& dimAndStick : dataLds.dimToStickSize_) {
+    const auto sizeIt = dimToSize.find(dimAndStick.first);
+    if (sizeIt != dimToSize.end() && sizeIt->second < dimAndStick.second) {
+      sizeIt->second = dimAndStick.second;
+    }
+  }
+  return dimToSize;
+}
