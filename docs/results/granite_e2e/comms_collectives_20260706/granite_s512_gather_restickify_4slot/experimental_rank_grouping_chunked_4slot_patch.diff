+static double tensorContractDimExtent(const json11::Json& tensorJson,
+                                      const std::string& dim,
+                                      DesignSpaceConfig& dldsc) {
+  const auto coordInfo = tensorJson["coordinateInfo_"][dim];
+  const auto attrs = coordInfo["folds"]["dim_prop_attr"].array_items();
+  if (!attrs.empty()) {
+    double extent = 1;
+    for (const auto& attr : attrs) {
+      extent *= jsonNumberOrString(attr["factor_"], 1);
+    }
+    return extent;
+  }
+  return dldsc.N_.paramNameToVal(dim);
+}
