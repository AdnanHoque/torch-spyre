+bool isFoldedLxNeighborAllocation(const dsc2::AllocateNode *allocNode) {
+  if (allocNode == nullptr || allocNode->component_ != SenComponents::LX ||
+      !allocNode->allocateCoordinates_.foldConstructed()) {
+    return false;
+  }
+  for (const auto &[userNode, _] : allocNode->allocUsers_) {
+    if (userNode != nullptr &&
+        userNode->nodeType_ == dsc2::ScheduleNode::TRANSFER &&
+        userNode->name_.find("_lx_neighbor") != std::string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
