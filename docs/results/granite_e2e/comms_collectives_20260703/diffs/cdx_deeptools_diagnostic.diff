+static int64_t pieceSizeBytes(const std::map<std::string, double>& dimToSize,
+                              double wordLength) {
+  double total = wordLength;
+  for (const auto& dimAndSize : dimToSize) total *= dimAndSize.second;
+  return static_cast<int64_t>(std::ceil(total));
+}
