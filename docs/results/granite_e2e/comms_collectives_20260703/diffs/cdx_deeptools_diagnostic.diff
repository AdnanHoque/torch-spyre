+static bool redirectMatmulOperandToStagedLds(
+    SuperDsc* sdsc, LabeledDsInfo& lds,
+    const MatmulOperandBroadcastHookPlan& hook,
+    const std::map<int, int64_t>& destinationStartAddressByCore,
+    std::string* reason) {
+  DT_CHECK(sdsc->dscs_.size() == 1);
+  auto& dldsc = sdsc->dscs_.at(0);
+  if (dldsc.computeOp_.empty()) {
+    *reason = "matmul_operand_broadcast staged LDS requires a compute op";
+    return false;
+  }
+  auto& computeOp = dldsc.computeOp_.at(0);
+  const int operandIndex = static_cast<int>(hook.plan.operandIndex);
+  if (operandIndex < 0 || operandIndex >=
+                              static_cast<int>(computeOp.inputLabeledDs.size())) {
+    *reason = "matmul_operand_broadcast staged LDS operand index is invalid";
+    return false;
+  }
+  auto oldAlloc = lds.memOrg_.count(SenComponents::LX)
+                      ? lds.memOrg_.at(SenComponents::LX).allocateNode_
+                      : nullptr;
+  if (oldAlloc == nullptr) {
+    *reason = "matmul_operand_broadcast staged LDS input has no LX allocate node";
+    return false;
+  }
+
+  const int oldLdsIdx = lds.ldsIdx_;
+  auto& stagedLds = dldsc.labeledDs_.at(oldLdsIdx);
+  stagedLds.coreStateInit_.clear();
+
+  auto* stagedAlloc = oldAlloc;
+  const auto oldCoreIdToWkSlice =
+      stagedAlloc->allocateCoordinates_.coreIdToWkSlice_;
+  stagedAlloc->allocateCoordinates_.clear();
+  stagedAlloc->allocateCoordinates_.coreIdToWkSlice_.clear();
+  stagedAlloc->sliceViewCoordinates_.clear();
+  stagedAlloc->sliceViewCoordinates_.coreIdToWkSlice_.clear();
+  auto& stAddr = stagedAlloc->startAddressCoreCorelet_;
+  for (int coreId = 0; coreId < stAddr.getFoldSpaceSize().at(0); ++coreId) {
+    const auto dstIt = destinationStartAddressByCore.find(coreId);
+    stAddr.insertData(dstIt == destinationStartAddressByCore.end()
+                          ? -1
+                          : dstIt->second,
+                      coreId, 0, 0);
+  }
+
+  if (std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_REPLICATED_COORDS") !=
+          nullptr &&
+      !oldCoreIdToWkSlice.empty()) {
+    const auto replicatedSlice = oldCoreIdToWkSlice.begin()->second;
+    for (int coreId = 0; coreId < stAddr.getFoldSpaceSize().at(0); ++coreId) {
+      stagedAlloc->allocateCoordinates_.coreIdToWkSlice_[coreId] =
+          replicatedSlice;
+    }
+  }
+
+  stagedLds.memOrg_.at(SenComponents::LX).allocateNode_ = stagedAlloc;
+
+  if (std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_DEBUG") != nullptr) {
+    std::cerr << "matmul_operand_broadcast staged lds in-place idx=" << oldLdsIdx
+              << " name=" << stagedLds.dsName_ << std::endl;
+  }
+  return true;
+}
