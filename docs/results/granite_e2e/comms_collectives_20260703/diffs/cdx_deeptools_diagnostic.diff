+static bool relayoutClassificationMatchesLds(
+    const std::map<std::string, std::string>& fields,
+    const LabeledDsInfo& lds) {
+  for (const auto& key : {"read_index", "operand_index"}) {
+    const auto it = fields.find(key);
+    if (it == fields.end()) continue;
+    return std::stoi(it->second) == lds.ldsIdx_;
+  }
+
+  const auto ldsIt = fields.find("input_labeled_ds");
+  if (ldsIt != fields.end()) return ldsIt->second == lds.dsName_;
+
+  return false;
+}
+
+static std::map<int, int64_t> parseCoreToLxStartAddress(
+    const std::string& encoded) {
+  std::map<int, int64_t> result;
+  std::string err;
+  const auto json = json11::Json::parse(encoded, err);
+  if (!err.empty() || !json.is_object()) return result;
+
+  for (const auto& entry : json.object_items()) {
+    if (entry.second.is_number()) {
+      result[std::stoi(entry.first)] =
+          static_cast<int64_t>(entry.second.number_value());
+    } else if (entry.second.is_string()) {
+      result[std::stoi(entry.first)] = std::stoll(entry.second.string_value());
+    }
+  }
+  return result;
+}
+
+static std::map<int, int64_t> findConsumerDestinationStartAddress(
+    const SuperDsc* sdsc, const LabeledDsInfo& lds) {
+  for (const auto& entry : sdsc->lxRelayoutClassifications_) {
+    const auto& fields = entry.second;
+    if (!relayoutClassificationMatchesLds(fields, lds)) continue;
+    const auto it = fields.find("consumer_core_id_to_lx_start_address");
+    if (it == fields.end()) continue;
+    return parseCoreToLxStartAddress(it->second);
+  }
+  return {};
+}
