+static void populateDataDSCwithFlashGroupedAllgatherImpl(
+    DataOpDsc& myDataOpDsc, const std::string& name, int outSize, int inSize,
+    int xGroups, int outChunkSize, int srcLxBase, int dstLxBase,
+    int inChunkSize = 0, int inChunkStart = 0, bool singleInSlice = false) {
+  myDataOpDsc.dscName_ = name;
+  myDataOpDsc.opName = OpFuncs::STCDPOpLx;
+  if (inChunkSize == 0) inChunkSize = inSize;
+
+  const std::vector<std::string> layoutDims = {"out", "in", "x"};
+  const std::vector<double> fullSize = {double(outSize), double(inSize),
+                                        double(xGroups)};
+  const std::vector<double> srcSize = {double(outChunkSize),
+                                       double(inChunkSize), 1};
+  const int dstInSize = singleInSlice ? inChunkSize : inSize;
+  const int dstInStart = singleInSlice ? inChunkStart : 0;
+  const std::vector<double> dstSize = {double(outSize), double(dstInSize), 1};
+  const std::vector<std::vector<std::pair<double, double>>> fullGap = {
+      {{double(outSize), 0}}, {{double(inSize), 0}}, {{double(xGroups), 0}}};
+  const std::vector<std::vector<std::pair<double, double>>> srcGap = {
+      {{double(outChunkSize), 0}}, {{double(inChunkSize), 0}}, {{1, 0}}};
+  const std::vector<std::vector<std::pair<double, double>>> dstGap = {
+      {{double(outSize), 0}}, {{double(dstInSize), 0}}, {{1, 0}}};
+  const int outChunks = outSize / outChunkSize;
+  const int inChunks = singleInSlice ? 1 : inSize / inChunkSize;
+  const int numCores = outChunks * xGroups;
+  DT_CHECK(outSize % outChunkSize == 0);
+  DT_CHECK(inSize % inChunkSize == 0);
+  DT_CHECK(inChunkStart >= 0);
+  DT_CHECK(inChunkStart + inChunkSize * inChunks <= inSize);
+  if (!singleInSlice) DT_CHECK(inChunkStart == 0);
+  DT_CHECK(numCores <= 32);
+
+  for (const auto& dim : layoutDims) myDataOpDsc.dimPool_.insert(dim);
+  myDataOpDsc.primaryDs_["activation"].dimNames = {"out", "in", "x"};
+  myDataOpDsc.primaryDs_["activation"].name_ = "activation";
+
+  LdsInfo inpDs;
+  inpDs.ldsName_ = "Tensor1-LayoutAllgatherRestickify-inp";
+  inpDs.wordLength = 2;
+  inpDs.pdsName_ = "activation";
+  inpDs.layoutDimOrder_ = layoutDims;
+  inpDs.stickDimOrder_ = {"out"};
+  inpDs.df = DataFormats::SEN169_FP16;
+  inpDs.dimToLayoutSize_ = DCGUtils::createNFillMap(layoutDims, fullSize);
+  inpDs.dimToStickSize_ = DCGUtils::createNFillMap(inpDs.stickDimOrder_, std::vector<double>{64});
+  inpDs.validGap_ = DCGUtils::createNFillMap(layoutDims, fullGap);
+  inpDs.totElements = outSize * inSize * xGroups;
+
+  for (int core = 0; core < numCores; ++core) {
+    const int producerMb = core % xGroups;
+    const int producerX = core / xGroups;
+    for (int inChunk = 0; inChunk < inChunks; ++inChunk) {
+      const std::string key =
+          "src" + std::to_string(core) + "_" + std::to_string(inChunk);
+      auto& piece = inpDs.pieces_[key];
+      piece.key_ = key;
+      piece.dimToSize_ = DCGUtils::createNFillMap(layoutDims, srcSize);
+      piece.dimToStartCordinate = DCGUtils::createNFillMap(
+          layoutDims,
+          std::vector<double>{double(producerX * outChunkSize),
+                              double(inChunkStart + inChunk * inChunkSize),
+                              double(producerMb)});
+      piece.validGap_ = DCGUtils::createNFillMap(layoutDims, srcGap);
+      piece.placement[SenComponents::LX];
+      piece.placement[SenComponents::LX].setType(SenComponents::LX);
+      piece.placement[SenComponents::LX].insertMemId(core);
+      piece.placement[SenComponents::LX].insertStAddr(srcLxBase);
+    }
+    myDataOpDsc.coreIdsUsed_.push_back(core);
+  }
+  inpDs.lxSize_ = int64_t(pow(2, 21));
+  myDataOpDsc.labeledDs_.push_back(inpDs);
+
+  LdsInfo outDs;
+  outDs.ldsName_ = "Tensor1";
+  outDs.wordLength = 2;
+  outDs.pdsName_ = "activation";
+  outDs.layoutDimOrder_ = layoutDims;
+  outDs.stickDimOrder_ = {"out"};
+  outDs.df = DataFormats::SEN169_FP16;
+  outDs.dimToLayoutSize_ = DCGUtils::createNFillMap(layoutDims, fullSize);
+  outDs.dimToStickSize_ = DCGUtils::createNFillMap(outDs.stickDimOrder_, std::vector<double>{64});
+  outDs.validGap_ = DCGUtils::createNFillMap(layoutDims, fullGap);
+  outDs.totElements = outSize * inSize * xGroups;
+
+  for (int core = 0; core < numCores; ++core) {
+    const int consumerX = core % xGroups;
+    const std::string key = "dst" + std::to_string(core);
+    auto& piece = outDs.pieces_[key];
+    piece.key_ = key;
+    piece.dimToSize_ = DCGUtils::createNFillMap(layoutDims, dstSize);
+    piece.dimToStartCordinate =
+        DCGUtils::createNFillMap(layoutDims,
+                                 std::vector<double>{0, double(dstInStart),
+                                                     double(consumerX)});
+    piece.validGap_ = DCGUtils::createNFillMap(layoutDims, dstGap);
+    piece.placement[SenComponents::LX];
+    piece.placement[SenComponents::LX].setType(SenComponents::LX);
+    piece.placement[SenComponents::LX].insertMemId(core);
+    piece.placement[SenComponents::LX].insertStAddr(dstLxBase);
+  }
+  outDs.lxSize_ = int64_t(pow(2, 21));
+  myDataOpDsc.labeledDs_.push_back(outDs);
+}
