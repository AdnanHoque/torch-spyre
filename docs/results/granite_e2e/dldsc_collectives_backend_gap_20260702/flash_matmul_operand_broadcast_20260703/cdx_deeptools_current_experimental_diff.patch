+static void addReplicatedLxPieceWithAddresses(
+    LdsInfo& dataLds, const std::string& key,
+    const std::map<int, int64_t>& startAddressByCore,
+    const std::map<std::string, double>& dimToSize,
+    const std::map<std::string, double>& dimToStart) {
+  DT_CHECK(!startAddressByCore.empty());
+  PieceInfo piece;
+  piece.key_ = key;
+  piece.dimToSize_ = dimToSize;
+  piece.dimToStartCordinate = dimToStart;
+  for (const auto& dimAndSize : dimToSize) {
+    piece.validGap_[dimAndSize.first].push_back(
+        std::make_pair(dimAndSize.second, 0));
+  }
+  piece.placement[SenComponents::LX];
+  piece.placement.at(SenComponents::LX).setType(SenComponents::LX);
+  for (const auto& coreAndAddress : startAddressByCore) {
+    piece.placement.at(SenComponents::LX).insertMemId(coreAndAddress.first);
+    piece.placement.at(SenComponents::LX).insertStAddr(coreAndAddress.second);
+    dataLds.coreIdTolxStartAddress_[coreAndAddress.first] =
+        coreAndAddress.second;
+  }
+  dataLds.pieces_[key] = piece;
+}
+
+static int64_t pieceSizeBytes(const std::map<std::string, double>& dimToSize,
+                              double wordLength) {
+  double total = wordLength;
+  for (const auto& dimAndSize : dimToSize) total *= dimAndSize.second;
+  return static_cast<int64_t>(std::ceil(total));
+}
+
+static bool containsDim(const std::vector<std::string>& dims,
+                        const std::string& dim) {
+  return std::find(dims.begin(), dims.end(), dim) != dims.end();
+}
+
+
+static bool containsPrimaryDim(const std::vector<PrimaryDimTypes>& dims,
+                               PrimaryDimTypes dim) {
+  return std::find(dims.begin(), dims.end(), dim) != dims.end();
+}
+
+static PrimaryDimTypes mapFlashRestickifyDimToConsumerKernelDim(
+    PrimaryDimTypes dim) {
+  // layout_allgather_restickify metadata for flash carries producer/restickify
+  // coordinates in the restickify tensor space. The batchmatmul KERNEL operand
+  // consumes the same values under a renamed coordinate system:
+  //   restickify.x   -> batchmatmul.out
+  //   restickify.out -> batchmatmul.in
+  //   restickify.mb  -> batchmatmul.x
+  if (dim == PrimaryDimTypes::X) return PrimaryDimTypes::OUT;
+  if (dim == PrimaryDimTypes::OUT) return PrimaryDimTypes::IN;
+  if (dim == PrimaryDimTypes::MB) return PrimaryDimTypes::X;
+  return dim;
+}
+
+static std::map<int, std::map<PrimaryDimTypes, int>>
+mapFlashRestickifyCoordsToConsumerKernelCoords(
+    const std::map<int, std::map<PrimaryDimTypes, int>>& sourceCoreIdToWkSlice,
+    const std::vector<PrimaryDimTypes>& consumerTensorDims) {
+  std::map<int, std::map<PrimaryDimTypes, int>> result;
+  for (const auto& coreAndSlice : sourceCoreIdToWkSlice) {
+    auto& mapped = result[coreAndSlice.first];
+    for (const auto& dimAndSlice : coreAndSlice.second) {
+      const auto mappedDim =
+          mapFlashRestickifyDimToConsumerKernelDim(dimAndSlice.first);
+      if (!containsPrimaryDim(consumerTensorDims, mappedDim)) continue;
+      mapped[mappedDim] = dimAndSlice.second;
+    }
+  }
+  return result;
+}
+
+static int64_t stickAdjustedExtent(const LdsInfo& lds,
+                                   const std::string& dimName,
+                                   double extent) {
+  if (!containsDim(lds.stickDimOrder_, dimName)) {
+    return static_cast<int64_t>(extent);
+  }
+  return static_cast<int64_t>(
+      std::ceil(extent / lds.dimToStickSize_.at(dimName)));
+}
+
+static int64_t byteOffsetWithinPiece(
+    const LdsInfo& lds, const std::map<std::string, double>& pieceDimToSize,
+    const std::map<std::string, double>& pieceDimToStart,
+    const std::map<std::string, double>& subpieceDimToStart) {
+  constexpr int64_t kBytesPerStick = 128;
+  int64_t offset = 0;
+  for (int idx = static_cast<int>(lds.layoutDimOrder_.size()) - 1; idx >= 0;
+       --idx) {
+    const std::string& dimName = lds.layoutDimOrder_.at(idx);
+    int64_t diff = static_cast<int64_t>(
+        subpieceDimToStart.at(dimName) - pieceDimToStart.at(dimName));
+    if (containsDim(lds.stickDimOrder_, dimName)) {
+      diff = static_cast<int64_t>(
+          std::ceil(static_cast<double>(diff) /
+                    lds.dimToStickSize_.at(dimName)));
+    }
+    DT_CHECK(diff >= 0);
+    if (diff == 0) continue;
+
+    int64_t elementsToSkip = 1;
+    for (int idx2 = idx - 1; idx2 >= 0; --idx2) {
+      const std::string& innerDimName = lds.layoutDimOrder_.at(idx2);
+      elementsToSkip *= stickAdjustedExtent(
+          lds, innerDimName, pieceDimToSize.at(innerDimName));
+    }
+    offset += diff * elementsToSkip * kBytesPerStick;
+  }
+  return offset;
+}
