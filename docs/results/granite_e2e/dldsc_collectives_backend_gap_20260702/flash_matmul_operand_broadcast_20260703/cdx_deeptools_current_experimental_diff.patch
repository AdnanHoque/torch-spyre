+static bool attachLayoutAllgatherRestickifyInputFetch(
+    SuperDsc* sdsc, SuperDsc* movementSdsc, LabeledDsInfo& lds,
+    const LayoutAllgatherRestickifyHookPlan& hook, int ps,
+    MemTrackBundle* memTrackers, std::string* reason,
+    const std::map<int, int64_t>* destinationStartAddressOverride = nullptr,
+    std::map<int, int64_t>* destinationStartAddressOut = nullptr,
+    int fissionDimStart = 0, int fissionDimSize = -1,
+    bool updateConsumerAllocation = true) {
+  if (movementSdsc == nullptr) movementSdsc = sdsc;
+  DT_CHECK(sdsc->dscs_.size() == 1);
+  if (!hook.plan.ok) {
+    *reason = "layout_allgather_restickify plan is not valid: " +
+              hook.plan.reason;
+    return false;
+  }
+
+  auto& dldsc = sdsc->dscs_.at(0);
+  auto allocNode = lds.memOrg_.count(SenComponents::LX)
+                       ? lds.memOrg_.at(SenComponents::LX).allocateNode_
+                       : nullptr;
+  if (allocNode == nullptr) {
+    *reason = "layout_allgather_restickify input has no LX allocate node";
+    return false;
+  }
+
+  const auto producerCoreIdToWkSlice =
+      allocNode->allocateCoordinates_.coreIdToWkSlice_;
+  if (producerCoreIdToWkSlice.empty()) {
+    *reason =
+        "layout_allgather_restickify input has empty producer coordinates";
+    return false;
+  }
+
+  const auto logicalTransfers =
+      deeptools::layoutAllgatherRestickifyLogicalTransfers(hook.plan);
+  std::map<int, std::vector<deeptools::LayoutAllgatherRestickifyLogicalTransfer>>
+      transfersByDestination;
+  for (const auto& transfer : logicalTransfers) {
+    transfersByDestination[static_cast<int>(transfer.destinationCore)].push_back(
+        transfer);
+  }
+  if (transfersByDestination.empty()) {
+    *reason = "layout_allgather_restickify produced no logical transfers";
+    return false;
+  }
+
+  const auto& refDsInfo = dldsc.primaryDsInfo_.at(lds.dsType_);
+  // The flash layout_allgather_restickify contract maps restickify.x chunks
+  // into the batchmatmul KERNEL out dimension, while restickify.mb maps to the
+  // consumer x dimension. Use the logical transfer table for exact group/chunk
+  // placement instead of re-inferring it from enum-valued producer coordinates.
+  const auto chunkDim = PrimaryDimTypes::OUT;
+  const auto groupDim = PrimaryDimTypes::X;
+  if (!containsPrimaryDim(refDsInfo.layoutDimOrder_, chunkDim) ||
+      !containsPrimaryDim(refDsInfo.layoutDimOrder_, groupDim)) {
+    *reason = "layout_allgather_restickify expected OUT chunk and X group dims";
+    return false;
+  }
+
+  const bool hasFissionSlice = fissionDimSize > 0;
+  const auto fissionDim = PrimaryDimTypes::IN;
+  if (hasFissionSlice) {
+    if (!containsPrimaryDim(refDsInfo.layoutDimOrder_, fissionDim)) {
+      *reason = "layout_allgather_restickify fission dim IN is not in layout";
+      return false;
+    }
+    const int fissionDimExtent =
+        static_cast<int>(dldsc.N_.primaryDimToVal_st(fissionDim));
+    if (fissionDimStart < 0 || fissionDimSize <= 0 ||
+        fissionDimStart + fissionDimSize > fissionDimExtent) {
+      *reason = "layout_allgather_restickify invalid fission slice";
+      return false;
+    }
+  }
+
+  std::map<std::string, double> allocationDstDimToSize;
+  std::map<std::string, double> dataOpDstDimToSize;
+  for (const auto& pDim : refDsInfo.layoutDimOrder_) {
+    const std::string dimName = dataOpDimName(dldsc, pDim);
+    const double dimExtent = dldsc.N_.primaryDimToVal_st(pDim);
+    int split = 1;
+    if (pDim == groupDim) {
+      split = static_cast<int>(hook.plan.groupCount);
+    } else if (pDim == chunkDim) {
+      split = static_cast<int>(hook.plan.producerChunksPerGroup);
+    }
+    DT_CHECK(split > 0);
+    DT_CHECK(static_cast<int>(dimExtent) % split == 0);
+    double dimSize = dimExtent / split;
+    if (pDim == chunkDim) {
+      dimSize *= hook.plan.producerChunksPerGroup;
+    }
+    allocationDstDimToSize[dimName] = dimSize;
+    dataOpDstDimToSize[dimName] = dimSize;
+    if (hasFissionSlice && pDim == fissionDim) {
+      dataOpDstDimToSize[dimName] = fissionDimSize;
+    }
+  }
+  const auto dstSliceBytes =
+      pieceSizeBytes(allocationDstDimToSize, lds.wordLength);
+  if (dstSliceBytes <= 0) {
+    *reason = "layout_allgather_restickify destination slice size is not positive";
+    return false;
+  }
+
+  std::map<int, int64_t> destinationStartAddressByCore;
+  if (destinationStartAddressOverride != nullptr) {
+    destinationStartAddressByCore = *destinationStartAddressOverride;
+  } else {
+    memTrackers->insertPsBefore(ps);
+    for (const auto& coreAndSlice : sdsc->coreIdToWkSlice_) {
