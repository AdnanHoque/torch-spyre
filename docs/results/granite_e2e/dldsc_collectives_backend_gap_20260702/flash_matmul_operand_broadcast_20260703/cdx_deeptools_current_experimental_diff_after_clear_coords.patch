+static void forceMatmulOperandBroadcastDataInfoBase(SuperDsc* sdsc) {
+  const char* forcedBaseEnv =
+      std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_FORCE_DATAINFO_BASE");
+  if (forcedBaseEnv == nullptr) return;
+  const int64_t forcedBase = std::stoll(forcedBaseEnv);
+  for (auto& dsc : sdsc->dscs_) {
+    auto computeNodes = dsc.scheduleTree_.traverseTreeDFSMutable(
+        nullptr, {dsc2::ScheduleNode::COMPUTE});
+    for (auto* node : computeNodes) {
+      auto* compute = static_cast<dsc2::ComputeNode*>(node);
+      if (compute->inputs_.size() <= 1 ||
+          compute->inputsLdsAndLoopOffsets_.size() <= 1) {
+        continue;
+      }
+      auto& dataInfo = compute->inputsLdsAndLoopOffsets_.at(1);
+      if (dataInfo.myLdsIdx_ < 0 ||
+          dataInfo.myLdsIdx_ >= static_cast<int>(dsc.labeledDs_.size())) {
+        continue;
+      }
+      const auto& lds = dsc.labeledDs_.at(dataInfo.myLdsIdx_);
+      if (lds.dsType_ != KERNEL) continue;
+      for (const auto& coordAndAddr :
+           dataInfo.startAddr_.getDataAndFoldCoordinates({})) {
+        dataInfo.startAddr_.insertData(forcedBase, coordAndAddr.first);
+      }
+      if (std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_DEBUG") != nullptr) {
+        std::cerr << "matmul_operand_force_datainfo_base sdsc=" << sdsc->name_
+                  << " node=" << compute->name_ << " input=1 lds="
+                  << lds.dsName_ << " base=" << forcedBase << std::endl;
+      }
     }
   }
 }
