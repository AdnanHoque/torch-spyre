+static void dumpMatmulOperandBroadcastViews(const SuperDsc* sdsc,
+                                            const std::string& stage) {
+  if (std::getenv("DEEPTOOLS_MATMUL_OPERAND_BROADCAST_DEBUG") == nullptr)
+    return;
+  for (const auto& dsc : sdsc->dscs_) {
+    auto computeNodes = dsc.scheduleTree_.traverseTreeDFS(
+        nullptr, {dsc2::ScheduleNode::COMPUTE});
+    for (const auto* node : computeNodes) {
+      const auto* compute = static_cast<const dsc2::ComputeNode*>(node);
+      if (compute->inputs_.size() <= 1 ||
+          compute->inputsLdsAndLoopOffsets_.size() <= 1) {
+        continue;
+      }
+      const auto& dataInfo = compute->inputsLdsAndLoopOffsets_.at(1);
+      if (dataInfo.myLdsIdx_ < 0 ||
+          dataInfo.myLdsIdx_ >= static_cast<int>(dsc.labeledDs_.size())) {
+        continue;
+      }
+      const auto& lds = dsc.labeledDs_.at(dataInfo.myLdsIdx_);
+      if (lds.dsType_ != KERNEL) continue;
+
+      std::cerr << "matmul_operand_view stage=" << stage
+                << " sdsc=" << sdsc->name_ << " node=" << compute->name_
+                << " input=1 lds=" << lds.dsName_ << " startAddr=";
+      dataInfo.startAddr_.print(std::cerr, "  ");
+      std::cerr << std::endl;
+      dataInfo.print(std::cerr, 1);
+      for (const auto& coreletAndView : compute->coreletViews_) {
+        if (coreletAndView.second.inputsLoopsAndSizes_.size() <= 1)
+          continue;
+        std::cerr << "matmul_operand_unit_view stage=" << stage
+                  << " sdsc=" << sdsc->name_ << " node=" << compute->name_
+                  << " corelet=" << coreletAndView.first << " input=1";
+        coreletAndView.second.inputsLoopsAndSizes_.at(1).print(std::cerr, 1);
+      }
+    }
+  }
+}
