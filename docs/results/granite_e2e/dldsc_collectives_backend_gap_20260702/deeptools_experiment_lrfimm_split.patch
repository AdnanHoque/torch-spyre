+std::vector<int64_t> splitLxLrfImm(int64_t imm) {
+  std::vector<int64_t> chunks;
+  while (imm < kLxLrfImmMin || imm > kLxLrfImmMax) {
+    int64_t chunk = imm < 0 ? kLxLrfImmMin : kLxLrfImmMax;
+    chunks.push_back(chunk);
+    imm -= chunk;
+  }
+  chunks.push_back(imm);
+  return chunks;
+}
