+static bool attachMatmulOperandBroadcastInputFetch(
+    SuperDsc* sdsc, const LabeledDsInfo& lds,
+    const MatmulOperandBroadcastHookPlan& hook, std::string* reason) {
+  (void)hook;
+  DT_CHECK(sdsc->dscs_.size() == 1);
+  auto& dldsc = sdsc->dscs_.at(0);
+  const auto allocNode = lds.memOrg_.count(SenComponents::LX)
+                             ? lds.memOrg_.at(SenComponents::LX).allocateNode_
+                             : nullptr;
+  if (allocNode == nullptr) {
+    *reason = "matmul_operand_broadcast input has no LX allocate node";
+    return false;
+  }
+  const auto producerCoreIdToWkSlice =
+      allocNode->allocateCoordinates_.coreIdToWkSlice_;
+  if (producerCoreIdToWkSlice.empty()) {
+    *reason = "matmul_operand_broadcast input has empty producer coordinates";
+    return false;
+  }
+
+  const auto& refDsInfo = dldsc.primaryDsInfo_.at(lds.dsType_);
+  const auto producerSliceIds =
+      collectTensorSliceIds(producerCoreIdToWkSlice,
+                            refDsInfo.layoutDimOrder_);
+
+  std::vector<int> destinationCores;
+  int64_t replicatedDstAddr = -1;
+  for (const auto& coreAndSlice : sdsc->coreIdToWkSlice_) {
+    const auto dstAddr = lxStartAddressForCore(lds, coreAndSlice.first);
+    if (dstAddr < 0) {
+      *reason = "missing destination LX base for consumer core " +
+                std::to_string(coreAndSlice.first);
+      return false;
+    }
+    if (replicatedDstAddr < 0) {
+      replicatedDstAddr = dstAddr;
+    } else if (replicatedDstAddr != dstAddr) {
+      *reason = "matmul_operand_broadcast requires equal destination LX bases";
+      return false;
+    }
+    destinationCores.push_back(coreAndSlice.first);
+  }
+
+  std::vector<int> dataOpIndices;
+  for (const auto& coreAndSlice : producerCoreIdToWkSlice) {
+    DataOpDsc ddsc;
+    ddsc.dscName_ = sdsc->name_ + "-" + lds.dsName_ +
+                    "-LxInputNeighborFetch-src" +
+                    std::to_string(coreAndSlice.first);
+    ddsc.opName = OpFuncs::STCDPOpLx;
+    ddsc.op = new STCDPOpLx;
+    ddsc.op->name = OpFuncs::STCDPOpLx;
+    ddsc.primaryDs_["activation"].name_ = "activation";
+    ddsc.target_ = sdsc->target_;
+    ddsc.foldProps_.push_back(new FoldDimProp(
+        sdsc->sdscFoldProps_.at(0)->getSize(), "time"));
+
+    std::set<int> coresSeen;
+    if (coresSeen.insert(coreAndSlice.first).second) {
+      ddsc.coreIdsUsed_.push_back(coreAndSlice.first);
+    }
+    for (const auto dstCore : destinationCores) {
+      if (coresSeen.insert(dstCore).second) ddsc.coreIdsUsed_.push_back(dstCore);
+    }
+
+    ddsc.labeledDs_.resize(2);
+    auto& inpLds = ddsc.labeledDs_.at(0);
+    auto& outLds = ddsc.labeledDs_.at(1);
+    inpLds.ldsName_ = lds.dsName_ + "-LxInputNeighborFetch-inp-src" +
+                      std::to_string(coreAndSlice.first);
+    outLds.ldsName_ = lds.dsName_;
+    fillDataOpLdsShape(inpLds, ddsc, lds, dldsc);
+    fillDataOpLdsShape(outLds, ddsc, lds, dldsc);
+    ddsc.dimPool_ = ddsc.primaryDs_.at("activation").dimNames;
+    DT_CHECK(outLds.stickDimOrder_ == inpLds.stickDimOrder_);
+    DT_CHECK(outLds.dimToStickSize_ == inpLds.dimToStickSize_);
+
