+          break;
+        }
+      }
+      schedule.insert(insertPos, DscScheduleStep(dataOpIdx, -1, false, true));
+    }
+  } else {
+    movementSdsc->numCoresUsed_ = dataOpCoreIds.size();
+    for (const auto coreId : dataOpCoreIds) {
+      movementSdsc->coreIdToDscSchedule[coreId].push_back(
+          DscScheduleStep(dataOpIdx, -1, false, true));
+    }
+  }
+  return true;
+}
