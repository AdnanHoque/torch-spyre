+static void addReplicatedLxPieceWithAddresses(
+    LdsInfo& dataLds, const std::string& key, const std::vector<int>& coreIds,
+    const std::map<int, int64_t>& coreIdToStartAddress,
+    const std::map<std::string, double>& dimToSize,
+    const std::map<std::string, double>& dimToStart) {
+  DT_CHECK(!coreIds.empty());
+  PieceInfo piece;
+  piece.key_ = key;
+  piece.dimToSize_ = dimToSize;
+  piece.dimToStartCordinate = dimToStart;
+  for (const auto& dimAndSize : dimToSize) {
+    piece.validGap_[dimAndSize.first].push_back(
+        std::make_pair(dimAndSize.second, 0));
+  }
+  piece.placement[SenComponents::LX];
+  piece.placement.at(SenComponents::LX).setType(SenComponents::LX);
+  auto& addrHelper = piece.placement.at(SenComponents::LX).StartAddr();
+  FoldDimProp* addrFoldProp = new FoldDimProp{1, "time"};
+  addrHelper.buildMapDim(addrFoldProp, 0);
+  for (const auto coreId : coreIds) {
+    const auto addrIt = coreIdToStartAddress.find(coreId);
+    DT_CHECK(addrIt != coreIdToStartAddress.end());
+    piece.placement.at(SenComponents::LX).insertMemId(coreId);
+    piece.placement.at(SenComponents::LX).insertStAddr(addrIt->second, {0});
+    dataLds.coreIdTolxStartAddress_[coreId] = addrIt->second;
+  }
+  dataLds.pieces_[key] = piece;
+}
