+void ScheduleNode::addRelevantCompToNodeAndAncestors(SenComponents comp) {
+  if (comp == SenComponents::NO_COMPONENT) return;
+  std::map<int, std::set<int>> coreCls;
+  if (relevantComps_.count(SenComponents::NO_COMPONENT)) {
+    coreCls = relevantComps_.at(SenComponents::NO_COMPONENT);
+  } else {
+    coreCls = getRelevantCoreCl();
+  }
+  addRelevantCompToNodeAndAncestors(comp, coreCls);
+}
+
+void ScheduleNode::addRelevantCompToNodeAndAncestors(
+    SenComponents comp, const std::map<int, std::set<int>>& coreCls) {
+  if (comp == SenComponents::NO_COMPONENT) return;
+  for (auto* location = this; location != nullptr; location = location->prev_) {
+    auto& relCoreCls = location->relevantComps_[comp];
+    for (const auto& [core, cls] : coreCls) {
+      relCoreCls[core].insert(cls.begin(), cls.end());
+    }
+  }
+}
