+        std::getenv("DEEPTOOLS_LX_NEIGHBOR_ALLOW_SELF_RING_DIAGNOSTIC") !=
+        nullptr;
+    if (!allowSelfRing &&
+        transfer.sourceCoreId_ == transfer.destinationCoreId_) {
+      return false;
+    }
+    const bool isSend =
+        genComp == SenComponents::L3SU && transfer.sourceCoreId_ == coreId;
+    const bool isReceive = genComp == SenComponents::L3LU &&
+                           transfer.destinationCoreId_ == coreId;
+    return isSend || isReceive;
+  };
+
+  auto isSendTransfer = [&](const auto& transfer) {
+    return genComp == SenComponents::L3SU && transfer.sourceCoreId_ == coreId;
+  };
+
+  auto validateTransfer = [](const auto& transfer) {
+    DT_CHECK_MSG(transfer.byteCount_ > 0,
+                 "Invalid LX-neighbor ring transfer byte count.");
+    DT_CHECK_MSG(transfer.byteCount_ % kBytesPerStick == 0,
+                 "LX-neighbor ring transfers must be stick aligned.");
+  };
+
+  auto isSameRun = [](const auto& first, const auto& previous,
+                      const auto& current, int64_t sourceStride,
+                      int64_t destinationStride) {
+    return current.sourceCoreId_ == first.sourceCoreId_ &&
+           current.destinationCoreId_ == first.destinationCoreId_ &&
+           current.byteCount_ == first.byteCount_ &&
+           current.group_ == first.group_ &&
+           current.producerChunk_ == first.producerChunk_ &&
+           current.consumerReplica_ == first.consumerReplica_ &&
+           current.sourceStartAddress_ - previous.sourceStartAddress_ ==
+               sourceStride &&
+           current.destinationStartAddress_ -
+                   previous.destinationStartAddress_ ==
+               destinationStride;
+  };
+
+  int64_t ringCoreCount = 0;
+  for (const auto& transfer : transfers) {
+    ringCoreCount =
+        std::max(ringCoreCount, static_cast<int64_t>(transfer.sourceCoreId_ + 1));
+    ringCoreCount = std::max(
+        ringCoreCount, static_cast<int64_t>(transfer.destinationCoreId_ + 1));
+  }
+  DT_CHECK_MSG(ringCoreCount > 0,
+               "LX-neighbor ring transfer list must name at least one core.");
+
+  auto ringPhase = [&](const auto& transfer) {
+    int64_t phase =
+        (static_cast<int64_t>(transfer.destinationCoreId_) -
+         static_cast<int64_t>(transfer.sourceCoreId_) + ringCoreCount) %
+        ringCoreCount;
+    if (phase == 0) {
+      phase = ringCoreCount;
+    }
+    return phase;
+  };
+
+  std::vector<size_t> relevantTransfers;
+  relevantTransfers.reserve(transfers.size());
+  for (size_t idx = 0; idx < transfers.size(); ++idx) {
+    if (isRelevantTransfer(transfers.at(idx))) {
+      validateTransfer(transfers.at(idx));
+      relevantTransfers.push_back(idx);
+    }
+  }
+  std::stable_sort(relevantTransfers.begin(), relevantTransfers.end(),
+                   [&](size_t lhs, size_t rhs) {
+                     const auto& lhsTransfer = transfers.at(lhs);
+                     const auto& rhsTransfer = transfers.at(rhs);
+                     if (lhsTransfer.group_ != rhsTransfer.group_) {
+                       return lhsTransfer.group_ < rhsTransfer.group_;
+                     }
+                     const int64_t lhsPhase = ringPhase(lhsTransfer);
+                     const int64_t rhsPhase = ringPhase(rhsTransfer);
+                     if (lhsPhase != rhsPhase) {
+                       return lhsPhase < rhsPhase;
+                     }
+                     if (lhsTransfer.sourceCoreId_ !=
+                         rhsTransfer.sourceCoreId_) {
+                       return lhsTransfer.sourceCoreId_ <
+                              rhsTransfer.sourceCoreId_;
+                     }
+                     if (lhsTransfer.destinationCoreId_ !=
+                         rhsTransfer.destinationCoreId_) {
+                       return lhsTransfer.destinationCoreId_ <
+                              rhsTransfer.destinationCoreId_;
+                     }
+                     return lhs < rhs;
+                   });
+
+  const bool enablePhaseSync =
+      std::getenv("DEEPTOOLS_LX_NEIGHBOR_PHASE_SYNC_DIAGNOSTIC") != nullptr;
+  auto insertPhaseSync = [&](bool isReceive, int64_t group) {
+    std::unordered_set<SenComponents> units;
+    units.insert(genComp == SenComponents::L3LU ? SenComponents::L3SU
+                                                : SenComponents::L3LU);
+    auto* syncNode = static_cast<SenPcfgSyncNode*>(
+        pcfg.createPcfgNode(SenPcfgNode::Type::SYNC));
+    const std::string endName =
+        "-lx-neighbor-phase-" + std::string(isReceive ? "recv" : "send") +
+        "-group" + std::to_string(group);
+    const std::string name = DscPcfgTranslator::createPcfgNodeName(
+        nameMap, coreId, pcfgInfo.clComp, endName);
+    syncNode->build(name, isReceive, /*isSoft*/ false, pcfgInfo.clComp,
+                    units);
+    SenPcfg::pcfgInsertBelow(syncNode, scopeStack.getPos());
+    scopeStack.updatePos(syncNode);
+    std::cerr << "[lx_neighbor_pcfg_dsc2] phase_sync "
+              << (isReceive ? "recv" : "send") << " core=" << coreId
+              << " unit="
+              << EnumsConversion::senComponentsToString.at(genComp)
+              << " group=" << group << "\n";
+  };
+
+  size_t transferIndex = 0;
+  bool emittedAny = false;
+  int64_t previousGroup = -1;
+  while (transferIndex < relevantTransfers.size()) {
+    const size_t firstIdx = relevantTransfers.at(transferIndex);
+    const auto& first = transfers.at(firstIdx);
+    if (enablePhaseSync && previousGroup >= 0 &&
+        first.group_ != previousGroup) {
+      if (genComp == SenComponents::L3LU) {
+        insertPhaseSync(/*isReceive*/ false, previousGroup);
+      } else if (genComp == SenComponents::L3SU) {
+        insertPhaseSync(/*isReceive*/ true, previousGroup);
+      }
+    }
+
+    size_t runEnd = transferIndex + 1;
+    int64_t sourceStride = 0;
+    int64_t destinationStride = 0;
+    if (std::getenv("DEEPTOOLS_LX_NEIGHBOR_DISABLE_RUN_COALESCE") ==
+            nullptr &&
+        runEnd < relevantTransfers.size()) {
+      const auto& second = transfers.at(relevantTransfers.at(runEnd));
+      if (second.sourceCoreId_ == first.sourceCoreId_ &&
+          second.destinationCoreId_ == first.destinationCoreId_ &&
+          second.byteCount_ == first.byteCount_ &&
+          second.group_ == first.group_ &&
+          second.producerChunk_ == first.producerChunk_ &&
+          second.consumerReplica_ == first.consumerReplica_) {
+        sourceStride = second.sourceStartAddress_ - first.sourceStartAddress_;
+        destinationStride =
+            second.destinationStartAddress_ - first.destinationStartAddress_;
+        ++runEnd;
+        while (runEnd < relevantTransfers.size() &&
+               isSameRun(first, transfers.at(relevantTransfers.at(runEnd - 1)),
+                         transfers.at(relevantTransfers.at(runEnd)),
+                         sourceStride, destinationStride)) {
+          ++runEnd;
+        }
+      }
+    }
+    if (runEnd - transferIndex > maxRunLength) {
+      runEnd = transferIndex + maxRunLength;
+    }
+
+
+    const size_t runLength = runEnd - transferIndex;
+    const bool isSend = isSendTransfer(first);
+    std::cerr << "[lx_neighbor_pcfg_dsc2] emit "
+              << (isSend ? "send" : "recv") << " core=" << coreId
+              << " src=" << first.sourceCoreId_
+              << " dst=" << first.destinationCoreId_
+              << " bytes=" << first.byteCount_ << " run=" << runLength
+              << " group=" << first.group_
+              << " phase=" << ringPhase(first)
+              << " srcStride=" << sourceStride
+              << " dstStride=" << destinationStride << "\n";
+
+    auto* ringNode = static_cast<SenPcfgRingDtNode*>(
+        pcfg.createPcfgNode(SenPcfgNode::Type::RINGDATATRANSFER));
+    const std::string endName =
+        "-lx-neighbor-ring-" + std::string(isSend ? "send" : "recv") +
+        "-src" + std::to_string(first.sourceCoreId_) + "-dst" +
+        std::to_string(first.destinationCoreId_) + "-chunk" +
+        std::to_string(first.producerChunk_) + "-run" +
+        std::to_string(firstIdx);
+    ringNode->name = DscPcfgTranslator::createPcfgNodeName(
+        nameMap, coreId, pcfgInfo.clComp, endName);
+    ringNode->coreletId = -1;
+    ringNode->dtInfo = nullptr;
+    ringNode->dsInfo = nullptr;
+    ringNode->dtFormat = dstLds.dataFormat_;
+    ringNode->srcDest.src_ = isSend ? SenComponents::LX : SenComponents::RING;
+    ringNode->srcDest.dst_ = isSend ? SenComponents::RING : SenComponents::LX;
+    ringNode->dimLayoutOrder = dimLayoutOrder;
+    ringNode->coreIdForRing = {
+        static_cast<int64_t>(isSend ? first.destinationCoreId_
+                                    : first.sourceCoreId_)};
+    ringNode->coreIDForRingCondAndVal.clear();
+    ringNode->useBurst = false;
+    ringNode->gtr_imm_opt_en = false;
+    ringNode->GTRAndBurstCondAndVal.clear();
+    ringNode->myBigDimSize.clear();
+    ringNode->myBigSubDimSize.clear();
+    ringNode->myBigStride.clear();
+    ringNode->myLitDimSize.clear();
+    ringNode->myLitSubDimSize.clear();
+    ringNode->bigStAddrOffsets.clear();
+    for (const auto& dim : ringNode->dimLayoutOrder) {
+      ringNode->myBigDimSize[dim] = 1;
+      ringNode->myLitDimSize[dim] = 1;
+    }
+    if (isSend) {
+      ringNode->setSrcStAddr(first.sourceStartAddress_);
+      ringNode->setDestStAddr(-1);
+    } else {
+      ringNode->setSrcStAddr(-1);
+      ringNode->setDestStAddr(first.destinationStartAddress_);
+    }
+
+    if (runLength > 1) {
+      const int64_t activeStride = isSend ? sourceStride : destinationStride;
+      DT_CHECK_MSG(activeStride % kBytesPerStick == 0,
+                   "LX-neighbor ring loop stride must be stick aligned.");
+      const std::string loopName = DscPcfgTranslator::createPcfgNodeName(
+          nameMap, coreId, pcfgInfo.clComp,
+          "-lx-neighbor-ring-loop-" + std::to_string(firstIdx));
+      auto [loopNode, branchNode] = SenPcfg::createLoopAndBranchEnd(
+          pcfg, loopName, static_cast<int>(runLength));
+      PcfgDtOffsets offsets;
+      offsets.dimOffset = activeStride / kBytesPerStick;
+      offsets.subDimOffset = 0;
+      offsets.uniDimOffset = 0;
+      offsets.freq = 1;
+      offsets.clSkipOffset = 0;
+      offsets.clSkipFreq = 1;
+      ringNode->bigStAddrOffsets[loopNode->name] = offsets;
+
+      SenPcfg::pcfgInsertBelow(loopNode, scopeStack.getPos());
+      SenPcfg::pcfgInsertBelow(ringNode, loopNode);
+      SenPcfg::pcfgInsertBelow(branchNode, ringNode);
+      scopeStack.updatePos(branchNode);
+    } else {
+      SenPcfg::pcfgInsertBelow(ringNode, scopeStack.getPos());
+      scopeStack.updatePos(ringNode);
+    }
+    emittedAny = true;
+    previousGroup = first.group_;
+
+    transferIndex = runEnd;
+  }
+
+  return emittedAny;
+}
+
+static bool buildLxNeighborLocalRestickifyStages(
+    DscPcfgTranslator::TranslatorGlobals& globals,
+    DscPcfgTranslator::PcfgInfo& pcfgInfo,
+    const dsc2::TransferNode* treeNode) {
+  if (treeNode->lxNeighborLocalRestickifyStages_.empty()) {
+    return false;
+  }
+
+  const SenComponents genComp = pcfgInfo.genComp;
+  const SenComponents genericGenComp =
+      EnumsConversion::senCompToGenericComp.at(genComp);
+  if (std::getenv("DEEPTOOLS_LX_NEIGHBOR_VIEW_PROBE") != nullptr) {
+    std::cerr << "[lx_neighbor_local_stage_visit] node=" << treeNode->name_
+              << " stages=" << treeNode->lxNeighborLocalRestickifyStages_.size()
+              << " core=" << pcfgInfo.c << " unit="
+              << EnumsConversion::senComponentsToString.at(genComp)
+              << " generic="
+              << EnumsConversion::senComponentsToString.at(genericGenComp)
+              << "\n";
+  }
+  if (genericGenComp != SenComponents::LXLU &&
+      genericGenComp != SenComponents::LXSU) {
+    return false;
+  }
+
+  auto& pcfg = pcfgInfo.pcfg;
+  auto& scopeStack = globals.scopeStack;
+  auto& nameMap = globals.nameMap;
+  const int coreId = pcfgInfo.c;
+  constexpr int64_t kBytesPerStick = 128;
+
+  std::vector<size_t> relevantStages;
+  relevantStages.reserve(treeNode->lxNeighborLocalRestickifyStages_.size());
+  for (size_t idx = 0; idx < treeNode->lxNeighborLocalRestickifyStages_.size();
+       ++idx) {
+    const auto& stage = treeNode->lxNeighborLocalRestickifyStages_.at(idx);
+    if (stage.coreId_ != coreId) {
+      continue;
+    }
+    DT_CHECK_MSG(stage.byteCount_ == kBytesPerStick,
+                 "Loop-scoped local restickify prototype expects one stick.");
+    DT_CHECK_MSG(stage.sourceStartAddress_ >= 0 &&
+                     stage.destinationStartAddress_ >= 0,
+                 "Invalid local restickify stage address.");
+    relevantStages.push_back(idx);
+  }
+  if (relevantStages.empty()) {
+    return false;
+  }
+
+  if (std::getenv("DEEPTOOLS_LX_NEIGHBOR_VIEW_PROBE") != nullptr) {
+    std::cerr << "[lx_neighbor_local_stage_pcfg] node=" << treeNode->name_
+              << " stages=" << relevantStages.size() << " core=" << coreId
+              << " unit="
+              << EnumsConversion::senComponentsToString.at(genComp) << "\n";
+  }
+
+  size_t maxRunLength = relevantStages.size();
+  if (const char* maxRunEnv =
+          std::getenv("DEEPTOOLS_LX_NEIGHBOR_MAX_RUN")) {
+    const int parsedMaxRun = std::atoi(maxRunEnv);
+    if (parsedMaxRun > 0) maxRunLength = static_cast<size_t>(parsedMaxRun);
+  }
+
+  auto isSameRun = [](const auto& first, const auto& previous,
+                      const auto& current, int64_t sourceStride,
+                      int64_t destinationStride) {
+    return current.coreId_ == first.coreId_ &&
+           current.byteCount_ == first.byteCount_ &&
+           current.group_ == first.group_ &&
+           current.producerChunk_ == first.producerChunk_ &&
+           current.consumerReplica_ == first.consumerReplica_ &&
+           current.sourceLayoutDimOrder_ == first.sourceLayoutDimOrder_ &&
+           current.destinationLayoutDimOrder_ ==
+               first.destinationLayoutDimOrder_ &&
+           current.sourceStartAddress_ - previous.sourceStartAddress_ ==
+               sourceStride &&
+           current.destinationStartAddress_ - previous.destinationStartAddress_ ==
+               destinationStride;
+  };
+
+  const bool isLoad = genericGenComp == SenComponents::LXLU;
+  bool emittedAny = false;
+  size_t stageIndex = 0;
+  while (stageIndex < relevantStages.size()) {
+    const size_t firstIdx = relevantStages.at(stageIndex);
+    const auto& stage = treeNode->lxNeighborLocalRestickifyStages_.at(firstIdx);
+
+    size_t runEnd = stageIndex + 1;
+    int64_t sourceStride = 0;
+    int64_t destinationStride = 0;
+    if (std::getenv("DEEPTOOLS_LX_NEIGHBOR_DISABLE_RUN_COALESCE") ==
+            nullptr &&
+        runEnd < relevantStages.size()) {
+      const auto& second = treeNode->lxNeighborLocalRestickifyStages_.at(
+          relevantStages.at(runEnd));
+      if (second.coreId_ == stage.coreId_ &&
+          second.byteCount_ == stage.byteCount_ &&
+          second.group_ == stage.group_ &&
+          second.producerChunk_ == stage.producerChunk_ &&
+          second.consumerReplica_ == stage.consumerReplica_ &&
+          second.sourceLayoutDimOrder_ == stage.sourceLayoutDimOrder_ &&
+          second.destinationLayoutDimOrder_ ==
+              stage.destinationLayoutDimOrder_) {
+        sourceStride = second.sourceStartAddress_ - stage.sourceStartAddress_;
+        destinationStride =
+            second.destinationStartAddress_ - stage.destinationStartAddress_;
+        ++runEnd;
+        while (runEnd < relevantStages.size() &&
+               isSameRun(stage,
+                         treeNode->lxNeighborLocalRestickifyStages_.at(
+                             relevantStages.at(runEnd - 1)),
+                         treeNode->lxNeighborLocalRestickifyStages_.at(
+                             relevantStages.at(runEnd)),
+                         sourceStride, destinationStride)) {
+          ++runEnd;
+        }
+      }
+    }
+    if (runEnd - stageIndex > maxRunLength) {
+      runEnd = stageIndex + maxRunLength;
+    }
+    const size_t runLength = runEnd - stageIndex;
+
+    if (std::getenv("DEEPTOOLS_LX_NEIGHBOR_VIEW_PROBE") != nullptr) {
+      std::cerr << "[lx_neighbor_local_stage_pcfg] emit "
+                << (isLoad ? "load" : "store") << " core=" << coreId
+                << " bytes=" << stage.byteCount_ << " run=" << runLength
+                << " group=" << stage.group_
+                << " chunk=" << stage.producerChunk_
+                << " srcStride=" << sourceStride
+                << " dstStride=" << destinationStride << "\n";
+    }
+
+    auto* dtNode = static_cast<SenPcfgDtNode*>(
+        pcfg.createPcfgNode(SenPcfgNode::Type::DATATRANSFER));
+    dtNode->name = DscPcfgTranslator::createPcfgNodeName(
+        nameMap, coreId, pcfgInfo.clComp,
+        "-lx-neighbor-local-stage-" + std::string(isLoad ? "load" : "store") +
+            "-chunk" + std::to_string(stage.producerChunk_) + "-idx" +
+            std::to_string(firstIdx));
+    dtNode->coreletId = -1;
+    dtNode->dtInfo = nullptr;
+    dtNode->dsInfo = nullptr;
+    dtNode->isPartStick = false;
+    dtNode->useBurst = false;
+    dtNode->dtFormat = DataFormats::SEN169_FP16;
+    dtNode->wordLength = 2;
+    dtNode->stickSize = 64;
+    dtNode->srcDest.src_ = isLoad ? SenComponents::LX
+                                  : SenComponents::LXLUSUFIFO;
+    dtNode->srcDest.dst_ = isLoad ? SenComponents::LXLUSUFIFO
+                                  : SenComponents::LX;
+    dtNode->dimLayoutOrder = isLoad ? stage.sourceLayoutDimOrder_
+                                    : stage.destinationLayoutDimOrder_;
+    if (dtNode->dimLayoutOrder.empty()) {
+      dtNode->dimLayoutOrder.push_back("x");
+    }
+    for (const auto& dim : dtNode->dimLayoutOrder) {
+      dtNode->myBigDimSize[dim] = 1;
+      dtNode->myLitDimSize[dim] = 1;
+    }
+    if (isLoad) {
+      dtNode->setSrcStAddr(stage.sourceStartAddress_);
+      dtNode->setDestStAddr(-1);
+    } else {
+      dtNode->setSrcStAddr(-1);
+      dtNode->setDestStAddr(stage.destinationStartAddress_);
+    }
+
+    if (runLength > 1) {
+      const int64_t activeStride = isLoad ? sourceStride : destinationStride;
+      DT_CHECK_MSG(activeStride % kBytesPerStick == 0,
+                   "LX-neighbor local stage loop stride must be stick aligned.");
+      const std::string loopName = DscPcfgTranslator::createPcfgNodeName(
+          nameMap, coreId, pcfgInfo.clComp,
+          "-lx-neighbor-local-stage-loop-" + std::to_string(firstIdx));
+      auto [loopNode, branchNode] = SenPcfg::createLoopAndBranchEnd(
+          pcfg, loopName, static_cast<int>(runLength));
+      PcfgDtOffsets offsets;
+      offsets.dimOffset = activeStride / kBytesPerStick;
+      offsets.subDimOffset = 0;
+      offsets.uniDimOffset = 0;
+      offsets.freq = 1;
+      offsets.clSkipOffset = 0;
+      offsets.clSkipFreq = 1;
+      dtNode->bigStAddrOffsets[loopNode->name] = offsets;
+
+      SenPcfg::pcfgInsertBelow(loopNode, scopeStack.getPos());
+      SenPcfg::pcfgInsertBelow(dtNode, loopNode);
+      SenPcfg::pcfgInsertBelow(branchNode, dtNode);
+      scopeStack.updatePos(branchNode);
+    } else {
+      SenPcfg::pcfgInsertBelow(dtNode, scopeStack.getPos());
+      scopeStack.updatePos(dtNode);
+    }
+    emittedAny = true;
+    stageIndex = runEnd;
+  }
+
+  return emittedAny;
+}
+
+static bool isLxNeighborLocalStageOnly(
+    const DscPcfgTranslator::PcfgInfo& pcfgInfo) {
+  if (std::getenv(
+          "DEEPTOOLS_MATMUL_OPERAND_BROADCAST_EMIT_LOCAL_RESTICKIFY_STAGE") ==
+      nullptr) {
+    return false;
+  }
+  const SenComponents genericGenComp =
+      EnumsConversion::senCompToGenericComp.at(pcfgInfo.genComp);
+  return genericGenComp == SenComponents::LXLU ||
+         genericGenComp == SenComponents::LXSU;
+}
