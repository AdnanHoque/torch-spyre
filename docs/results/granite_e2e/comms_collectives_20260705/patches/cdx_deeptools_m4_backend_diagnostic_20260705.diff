+bool checkedMul(std::uint64_t lhs, std::uint64_t rhs, std::uint64_t *result) {
+  if (lhs != 0 && rhs > std::numeric_limits<std::uint64_t>::max() / lhs) {
+    return false;
+  }
+  *result = lhs * rhs;
+  return true;
+}
+
+bool checkedAddProduct(std::uint64_t lhs, std::uint64_t rhs,
+                       std::uint64_t *total) {
+  std::uint64_t product = 0;
+  if (!checkedMul(lhs, rhs, &product)) return false;
+  if (product > std::numeric_limits<std::uint64_t>::max() - *total) {
+    return false;
+  }
+  *total += product;
+  return true;
+}
