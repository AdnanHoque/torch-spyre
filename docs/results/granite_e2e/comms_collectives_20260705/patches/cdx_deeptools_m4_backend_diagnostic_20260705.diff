+static std::vector<std::string> getLxNeighborRingLayoutOrder(
+    const DesignSpaceConfig& dsc, const LabeledDsInfo& lds) {
+  std::vector<std::string> dimLayoutOrder;
+  const auto& primaryInfo = dsc.primaryDsInfo_.at(lds.dsType_);
+  for (const auto dim : primaryInfo.layoutDimOrder_) {
+    if (dim == PrimaryDimTypes::IJ) {
+      dimLayoutOrder.push_back("j");
+      dimLayoutOrder.push_back("i");
+    } else {
+      dimLayoutOrder.push_back(EnumsConversion::primaryDimToString.at(dim));
+    }
+  }
+  if (dimLayoutOrder.empty()) {
+    dimLayoutOrder.push_back("x");
+  }
+  return dimLayoutOrder;
