     )
-    if _MOE_CHUNKED_ONDEVICE:
+    if _MOE_ASGEMM_ONDEVICE or _MOE_CHUNKED_ONDEVICE:
         E = cfg.num_experts
-        assert E % _MOE_EC == 0, (
