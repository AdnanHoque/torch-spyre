 from hf_adapters.hf_common import text_config
 from hf_adapters.hf_gemma4 import (
@@ -143,6 +153,13 @@ _MOE_LOOP_ON_TOPK = False
 # exclusive with _MOE_LOOP_ON_TOPK (asserted in prepare_for_spyre).
 _MOE_CHUNKED_ONDEVICE = False
 
+# Activation-stationary dense all-expert formulation.  This mode requires the
+# Torch-Spyre compiler contract introduced by the moe-asgemm compiler series.
+# It deliberately preserves the existing router semantics while replacing the
+# four host-dispatched Ec=32 expert programs with one static E=128 program.
+_MOE_ASGEMM_ONDEVICE = False
+_MOE_ASGEMM_E = 128
+
 # Experts per compiled chunk for the all-device path. >32 expert GEMM-chains in
 # one fused sdsc program crashes the DDC scheduler (Incorrect chunk size); <=32
 # compiles clean. E must be divisible by _MOE_EC.
@@ -743,6 +760,137 @@ def _moe_expert_chunk(x_expert, w, acc, gate_c, up_c, down_c, onehot_c):
     return acc
 
 
+def _moe_route_padded_asgemm(x_router, router_proj_w, router_scale,
+                             router_scalar_root_size, per_expert_scale, K, eps,
+                             pad_w, pad_neg):
+    """Return the existing dense router result in the AS-GEMM alpha ABI.
+
+    The underlying routing algorithm is unchanged.  The explicit singleton is
+    load-bearing for the compiler contract: ``[E,T,1]`` broadcasts directly in
+    the down-projection output layout, whereas squeezing it to ``[E,T]`` can
+    force the full ``[E,T,H]`` activation through an HBM restickify.
+    """
+
+    weights = _moe_route_padded(
+        x_router,
+        router_proj_w,
+        router_scale,
+        router_scalar_root_size,
+        per_expert_scale,
+        K,
+        eps,
+        pad_w,
+        pad_neg,
+    )
+    return weights.transpose(0, 1).unsqueeze(-1).contiguous()
+
+
+def _moe_expert_asgemm(x_expert, alpha, gate_w, up_w, down_w):
+    """Dense all-expert FFN expressed through the compiler AS-GEMM contract.
+
+    Args:
+        x_expert: Expert input ``[T,H]``.
+        alpha: Runtime post-down router weights ``[E,T,1]``.
+        gate_w: Prepacked gate bank ``[H,E,F]``.
+        up_w: Prepacked up bank ``[H,E,F]``.
+        down_w: Prepacked down bank ``[F,E,H]``.
+    """
+
+    if gate_w.shape[1] != _MOE_ASGEMM_E:
+        raise ValueError(
+            f"AS-GEMM is specialized for {_MOE_ASGEMM_E} experts, "
+            f"got {gate_w.shape[1]}"
+        )
+    with spyre_hint(num_tiles_per_dim={"E": _MOE_ASGEMM_E}):
+        gate = torch.ops.spyre.activation_stationary_shared_lhs_mm_prepacked(
+            x_expert, gate_w
+        )
+        up = torch.ops.spyre.activation_stationary_shared_lhs_mm_prepacked(
+            x_expert, up_w
+        )
+        hidden = F.gelu(gate, approximate="tanh") * up
+        down = torch.ops.spyre.activation_stationary_expert_mm_prepacked(
+            hidden, down_w
+        )
+        return (down * alpha).sum(dim=0)
+
+
+def _moe_ffn_asgemm(x_router, x_expert, router, compiled_route,
+                    compiled_expert, gate_w, up_w, down_w, K, eps):
+    """Run the existing router and one compiler-generated AS-GEMM program."""
+
+    alpha = compiled_route(
+        x_router,
+        router.proj.weight,
+        router.scale,
+        router.scalar_root_size,
+        router.per_expert_scale,
+        K,
+        eps,
+        _MOE_PADW,
+        _MOE_PAD_NEG,
+    )
+    _name_asgemm_contract_inputs(x_expert, alpha, gate_w, up_w, down_w)
+    with _asgemm_compile_config():
+        return compiled_expert(x_expert, alpha, gate_w, up_w, down_w)
+
+
+def _asgemm_compile_config():
+    """Return the narrow compiler-policy context validated by AS-GEMM."""
+
+    return spyre_config.patch(
+        {
+            "sencores": 32,
+            "lx_planning": True,
+            "allow_all_ops_in_lx_planning": True,
+        }
+    )
+
+
+def _name_asgemm_contract_inputs(x_expert, alpha, gate_w, up_w, down_w):
+    """Attach the semantic dimension names consumed by ``spyre_hint``.
+
+    This runs in the eager model orchestrator before the expert callable's
+    first compilation.  Naming the real device tensors is part of the compiler
+    contract; a hint scope without these names is intentionally inert.
+    """
+
+    T, H = x_expert.shape
+    H_w, E, Fdim = gate_w.shape
+    if H_w != H or up_w.shape != gate_w.shape:
+        raise ValueError("gate/up AS-GEMM bank shape does not match x")
+    if down_w.shape != (Fdim, E, H) or alpha.shape != (E, T, 1):
+        raise ValueError("down/alpha AS-GEMM bank shape mismatch")
+    for name, size in {"E": E, "T": T, "H": H, "F": Fdim, "K": 1}.items():
+        pnd.declare_tensor_dim(name, size)
+    for tensor, dims in (
+        (x_expert, ["T", "H"]),
+        (gate_w, ["H", "E", "F"]),
+        (up_w, ["H", "E", "F"]),
+        (down_w, ["F", "E", "H"]),
+        (alpha, ["E", "T", "K"]),
+    ):
+        pnd.name_tensor_dims(tensor, dims)
+
+
+def _prepack_asgemm_weights(gate_up_t, down_t):
+    """Convert PR293's expert-major banks to directly streamed AS-GEMM banks."""
+
+    E, H, two_f = gate_up_t.shape
+    if two_f % 2:
+        raise ValueError(f"gate/up width must be even, got {two_f}")
+    if down_t.shape != (E, two_f // 2, H):
+        raise ValueError(
+            "down bank must have shape [E,F,H], got "
+            f"{tuple(down_t.shape)} for gate/up {tuple(gate_up_t.shape)}"
+        )
+    Fdim = two_f // 2
+    gate_w = gate_up_t[:, :, :Fdim].permute(1, 0, 2).contiguous()
+    up_w = gate_up_t[:, :, Fdim:].permute(1, 0, 2).contiguous()
+    down_w = down_t.permute(1, 0, 2).contiguous()
+    return gate_w, up_w, down_w
+
+
 def _moe_ffn_chunked(x_router, x_expert, router, compiled_route,
                      compiled_chunk, chunks, K, eps):
