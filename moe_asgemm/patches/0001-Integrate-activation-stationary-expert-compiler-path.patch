         assert _MOE_PADW > E and (_MOE_PADW & (_MOE_PADW - 1)) != 0, (
             f"_MOE_PADW ({_MOE_PADW}) must exceed num_experts ({E}) and be "
             "non-power-of-two (topk-pad fix)."
