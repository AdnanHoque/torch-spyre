+def test_asgemm_route_abi_preserves_dense_router_weights():
+    torch.manual_seed(11)
+    T, H, E, K = 4, 16, 8, 2
+    args = (
+        torch.randn(T, H),
+        torch.randn(E, H),
+        torch.rand(H) + 0.5,
+        H ** -0.5,
+        torch.rand(E) + 0.5,
+        K,
+        1e-6,
+        12,
+        -30000.0,
+    )
+    dense = _moe_route_padded(*args)
+    alpha = _moe_route_padded_asgemm(*args)
+    assert alpha.shape == (E, T, 1)
+    assert alpha.is_contiguous()
+    torch.testing.assert_close(alpha[..., 0].transpose(0, 1), dense)
+
+
+def test_asgemm_weight_prepack_preserves_expert_values():
+    E, H, Fdim = 3, 5, 7
+    gate_up = torch.arange(E * H * 2 * Fdim).reshape(E, H, 2 * Fdim)
+    down = torch.arange(E * Fdim * H).reshape(E, Fdim, H)
+    gate_w, up_w, down_w = _prepack_asgemm_weights(gate_up, down)
+    assert gate_w.shape == (H, E, Fdim)
+    assert up_w.shape == (H, E, Fdim)
+    assert down_w.shape == (Fdim, E, H)
+    assert gate_w.is_contiguous() and up_w.is_contiguous() and down_w.is_contiguous()
+    for expert in range(E):
+        torch.testing.assert_close(gate_w[:, expert], gate_up[expert, :, :Fdim])
+        torch.testing.assert_close(up_w[:, expert], gate_up[expert, :, Fdim:])
+        torch.testing.assert_close(down_w[:, expert], down[expert])
+
