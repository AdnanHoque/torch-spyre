+    root = next(iter(sdsc.values()))
+
+    assert root["numWkSlicesPerDim_"] == {"out": 4, "mb": 8}
+    assert root["coreIdToWkSlice_"]["0"] == {"out": 0, "mb": 0}
+    assert root["coreIdToWkSlice_"]["1"] == {"out": 1, "mb": 0}
+    assert root["coreIdToWkSlice_"]["28"] == {"out": 0, "mb": 7}
