+
+    input_layout = DummyLayout({"lx": 0x24000})
+    output_layout = DummyLayout({"lx": 0x44000})
+    source = TensorAccess("buf47", Integer(0), input_layout)
+    value = ReductionOp("mean", [source])
+    consumer_buffer = SimpleNamespace(get_layout=lambda: output_layout)
+    graph = SimpleNamespace(
+        get_buffer=lambda name: consumer_buffer,
+        scheduler=SimpleNamespace(mutation_real_name={}),
+        removed_buffers=set(),
+        sizevars=SimpleNamespace(precomputed_replacements={}),
+    )
+
+    input_arg = SimpleNamespace(name="buf47")
+    output_arg = SimpleNamespace(name="buf48")
+    consumer_spec = SimpleNamespace(op="mean")
+    shuffle_spec = SimpleNamespace(op="shuffle")
+    materialize_calls = []
+
+    def materialize(current_node, args, tensor_args, spec, consumer_node=None):
+        materialize_calls.append(
+            (current_node, args, tensor_args, spec, consumer_node)
+        )
+        args[0] = SimpleNamespace(name="__spyre_lx_relayout_destination__:buf47")
+        return [shuffle_spec]
+
+    monkeypatch.setattr(spyre_kernel_module, "FixedTiledLayout", DummyLayout)
+    monkeypatch.setattr(
+        spyre_kernel_module,
+        "_materialize_lx_relayout_inputs",
+        materialize,
+    )
+
+    kernel = SpyreKernel()
+    kernel.args = SimpleNamespace(output=lambda name: None)
+    kernel.current_node = SimpleNamespace(node=SimpleNamespace(data=SimpleNamespace()))
+    kernel.create_tensor_arg = (
+        lambda is_input, name, tensor: input_arg if is_input else output_arg
+    )
+    kernel.create_op_spec = lambda op, is_reduction, args, op_info: consumer_spec
+
+    with V.set_graph_handler(graph):
+        kernel.store_reduction("buf48", Integer(0), value)
