+        op,
+        {out: Integer(784), reduction: Integer(64)},
+    ) == {reduction: 1, out: 28}
+    assert 784 % 28 == 0
+
+    legacy = DummyBuffer(size=(1, 1, 49280), reduction_type=BATCH_MATMUL_OP)
+    assert _oracle_work_div_hint_by_name(legacy) == {"in": 1, "out": 22}
