+def test_generate_last_n_tokens_gate_defaults_to_legacy_fallback(monkeypatch):
+    monkeypatch.delenv("SPYRE_ENABLE_LAST_N_TOKENS", raising=False)
+    kwargs = {"last_n_tokens": 1}
+    _apply_spyre_last_n_tokens_policy(kwargs)
+    assert kwargs["last_n_tokens"] == 0
+
