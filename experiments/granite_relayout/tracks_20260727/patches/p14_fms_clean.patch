+class _GraniteLastTokenStage(nn.Module):
+    """Compile the token slice and LM head as one Spyre graph.
+
+    The final RMSNorm deliberately stays in the headless model's existing
+    compiled graph.  Moving it into this stage changes the graph input boundary
+    and was not bit-exact on device.  Fusing only the slice and head preserves
+    the accepted normalization path while exposing their ownership transition
+    to Torch-Spyre's relayout planner.
+    """
+
+    def __init__(self, logits_scaling: float, output_vocab_size: int):
+        super().__init__()
+        self.logits_scaling = logits_scaling
+        self.output_vocab_size = output_vocab_size
+
+    def forward(self, output, head_weight):
+        output = output[:, -1:, :].clone(memory_format=torch.contiguous_format)
+        preds = torch.nn.functional.linear(output, head_weight)
+        if head_weight.shape[0] > self.output_vocab_size:
+            preds = preds[..., : self.output_vocab_size]
+        return preds / self.logits_scaling
+
+
+class _GraniteFinalNormLastTokenStage(nn.Module):
+    """Keep Granite's final RMSNorm, last-token slice, and LM head together.
+
+    This experimental stage removes the HBM graph boundary between the final
+    normalization and the last-token consumer.  It is selected only by the
+    explicit P14 replay gate; the existing final-normalization path remains
+    the default.
+    """
+
+    def __init__(
+        self,
+        emb_dim: int,
+        norm_eps: float,
+        logits_scaling: float,
+        output_vocab_size: int,
+    ):
+        super().__init__()
+        self.normalized_shape = (emb_dim,)
+        self.norm_eps = norm_eps
+        self.logits_scaling = logits_scaling
+        self.output_vocab_size = output_vocab_size
+
+    def forward(self, output, norm_weight, head_weight):
+        output = torch.nn.functional.rms_norm(
+            output,
+            self.normalized_shape,
+            norm_weight,
+            self.norm_eps,
+        )
+        output = output[:, -1:, :].clone(memory_format=torch.contiguous_format)
+        preds = torch.nn.functional.linear(output, head_weight)
+        if head_weight.shape[0] > self.output_vocab_size:
+            preds = preds[..., : self.output_vocab_size]
+        return preds / self.logits_scaling
+
+
