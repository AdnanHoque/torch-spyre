+def test_generate_last_n_tokens_gate_preserves_explicit_value(monkeypatch):
+    monkeypatch.setenv("SPYRE_ENABLE_LAST_N_TOKENS", "1")
+    kwargs = {"last_n_tokens": 1}
+    _apply_spyre_last_n_tokens_policy(kwargs)
+    assert kwargs["last_n_tokens"] == 1
+
+
