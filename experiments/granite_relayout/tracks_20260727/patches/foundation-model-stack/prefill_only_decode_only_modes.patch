+def _apply_spyre_last_n_tokens_policy(kwargs: MutableMapping[str, Any]) -> None:
+    """Apply the opt-in Spyre final-token policy to generation kwargs."""
+    if "last_n_tokens" not in kwargs and kwargs.get("only_last_token", False):
+        kwargs["last_n_tokens"] = 1
+
+    # Preserve the historical fallback unless the final-token experiment is
+    # explicitly enabled.  With the gate enabled, retain the caller's explicit
+    # or only_last_token-derived value.
+    if os.environ.get("SPYRE_ENABLE_LAST_N_TOKENS", "0") != "1":
+        kwargs["last_n_tokens"] = 0
+
